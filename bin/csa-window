#!/bin/zsh
# csa-window <command> [args...]
# Runs the command in a new Terminal window so you can watch the agent work, and waits until it finishes.
# The exit code of the command is returned, so `csa convert`, `csa pipeline` and `csa fleet` carry on as usual.
# CSA_NO_WINDOW=1 runs the command in place instead (no window).
if [[ -n "$CSA_NO_WINDOW" || "$(uname)" != "Darwin" ]]; then
  exec "$@"
fi
dir=$(mktemp -d "${TMPDIR:-/tmp}/csa-window.XXXXXX") || exit 1
{
  print -r -- "#!/bin/zsh"
  print -r -- "print -r -- started > ${(q)dir}/started"
  print -r -- "print -r -- \$\$ > ${(q)dir}/shell-pid"
  print -r -- "cd ${(q)PWD}"
  # Terminal's foreground script is its own process group; the outer manager records it so timeout/cancel can stop
  # the CLI and all of its descendants without closing the Terminal application.
  print -r -- "${(@q)@}"
  print -r -- "rc=\$?"
  print -r -- "print -r -- \$rc > ${(q)dir}/rc"
  print -r -- "print; print -- \"csa-window: finished (exit \$rc). You can close this window.\""
} > "$dir/run.sh"
chmod +x "$dir/run.sh"

signal_remote() {
  local signal_name="$1" shell_pid=""
  if [[ -f "$dir/shell-pid" ]]; then
    shell_pid=$(<"$dir/shell-pid")
    if [[ "$shell_pid" == <-> && "$shell_pid" -gt 1 ]]; then
      /bin/kill -"$signal_name" -- -"$shell_pid" 2>/dev/null || /bin/kill -"$signal_name" "$shell_pid" 2>/dev/null || true
    fi
  fi
}

stop_remote() {
  signal_remote TERM
  for _ in {1..30}; do
    [[ -f "$dir/rc" ]] && return
    sleep 0.1
  done
  signal_remote KILL
  for _ in {1..10}; do
    [[ -f "$dir/rc" ]] && return
    sleep 0.1
  done
}

on_term() { stop_remote; rm -rf "$dir"; exit 143; }
on_int() { stop_remote; rm -rf "$dir"; exit 130; }
trap on_term TERM HUP
trap on_int INT
if ! osascript >/dev/null <<EOF
tell application "Terminal"
  activate
  do script "clear; zsh '$dir/run.sh'"
end tell
EOF
then
  print -u2 -- "csa-window: Terminal could not be opened; running the command in this window."
  rm -rf "$dir"
  exec "$@"
fi
# A successful AppleScript reply is not proof that Terminal started the script. Fail visibly instead of waiting
# forever; the parent CSA loop can then retain and report its work-in-progress state.
for _ in {1..15}; do
  [[ -f "$dir/started" || -f "$dir/rc" ]] && break
  sleep 1
done
if [[ ! -f "$dir/started" && ! -f "$dir/rc" ]]; then
  print -u2 -- "csa-window: Terminal accepted the request but did not start the command within 15 seconds."
  rm -rf "$dir"
  exit 125
fi
while [[ ! -f "$dir/rc" ]]; do sleep 2; done
rc=$(<"$dir/rc")
rm -rf "$dir"
exit ${rc:-1}
