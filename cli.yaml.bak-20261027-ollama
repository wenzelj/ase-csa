# Settings for the `csa` command. Per-machine overrides: environment variables
# CSA_CLI, CSA_PYTHON, CSA_PROJECT.

# Default agent CLI for `csa <verb>`: codex | claude | evo | hermes. Override per call with --cli (claude, codex or evo).
default_cli: evo

# Interpreter for the csa_docx framework and skill scripts (needs Python >= 3.11).
# First one that exists wins.
python: /opt/homebrew/bin/python3.14, python3.14, python3.13, python3.12, python3.11, python3

# Word comment author for applied edits.
comment_author: Wenzel Joubert
comment_initials: WJ
# Add a Word comment to each applied edit: on | off. Env CSA_COMMENTS overrides.
comments: off

# How to launch each CLI. {prompt} is replaced by the generated prompt (passed as
# one argument, never through a shell). interactive = you stay in the session;
# headless = runs to completion and exits (used by --headless and `csa pipeline`).
codex_interactive: codex -m gpt-5.6-sol -c model_reasoning_effort=medium {prompt}
codex_headless: codex exec -m gpt-5.6-sol -c model_reasoning_effort=medium --skip-git-repo-check --output-last-message {last} {prompt}
claude_interactive: claude {prompt}
claude_headless: claude -p {prompt}
# Evo: the dedicated Codex profile against the local model. Pick it per run with --cli evo.
evo_interactive: codex --profile evo-x3-qwen {prompt}
evo_headless: codex exec --profile evo-x3-qwen --ignore-rules --skip-git-repo-check --output-last-message {last} {prompt}
# Ollama: a local model (pick it per run with --cli ollama). --hidethinking keeps a thinking model's reasoning out of the reply.
ollama_interactive: ollama run qwen3.5:9b {prompt}
ollama_headless: ollama run --hidethinking qwen3.5:9b {prompt}
# Hermes has no "start interactive with a prompt" flag; both run the prompt as one query.
hermes_interactive: hermes chat -q {prompt}
hermes_headless: hermes chat -q {prompt}

# How sections are identified: off (numbers only), shadow (numbers decide, differences with the document spec are
# logged to csa-work/spec/shadow.log), on (keys and the numbers Word shows). A project's spec_mode: in PROJECTS.yaml wins.
spec_mode: shadow

# `csa author`: cards (card -> answer agent -> render -> writer -> apply, the default) | legacy (the change-authoring
# agent does everything). --legacy and --cards override it per call.
author_default: cards

# Per-verb CLI, used when --cli is not given: e.g. the answer sheet on the strong model, prose on the local one.
#   task_cli: answer: claude, write: codex
task_cli:

# `csa fleet`: run independent tasks side by side. One worker per slot; each task starts a
# fresh headless CLI in a free slot and the process exits when the task is done. For codex,
# each slot name is a Codex profile ({profile}); {last} is the file that gets the final message.
# Fleet workers remain children of the invoking command and never open separate Terminal windows.
# DOCX steps never overlap (see `locks:` in registry.yaml). Override: --slots, --cli, CSA_FLEET_SLOTS.
fleet_cli: codex
fleet_slots: evo-x3-qwen
# Slots that run a small local model. csa fleet warns before giving them a frontier-tier task (registry.yaml tier:).
local_slots: evo-x3-qwen
# Slots csa fleet refuses (local-qwen is always refused: it does not deliver).
disabled_slots: local-qwen
codex_fleet: codex exec --profile {profile} --skip-git-repo-check --output-last-message {last} {prompt}
claude_fleet: claude -p {prompt}
hermes_fleet: hermes chat -q {prompt}

# csa answer: fix rounds after the first answer. Each rewrites only the blocks that fail; the framework merges them.
answer_fix_rounds: 3
# Each answer/draft model pass reports a heartbeat and is stopped before a dead session can consume hours. A sheet
# written before a timeout is still validated and can continue through the repair loop.
answer_heartbeat_minutes: 10
answer_call_timeout_minutes: 45
# If a focused repair returns the same blocking signature, use this already-configured CLI for subsequent repairs.
answer_repair_cli: evo
