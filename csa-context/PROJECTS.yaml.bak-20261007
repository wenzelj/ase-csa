# Registry of every CSA project sharing this .agents framework. The orchestrator agent reads this
# file first, before doing anything else, to ask which project a run is for when PROJECT_CONTEXT /
# WORK_DIR were not given explicitly. Add a new block here whenever a new CSA project is placed
# under /Users/wenzel/Work/ASE/CurrentStateAssessments/ -- nothing else in the shared framework
# needs to change.
# Optional per-project key: legacy_docx: "<absolute path to an old-format CSA .docx>" -- the document
# `csa convert` moves into the CSA template one subsection at a time (read-only; never edited).

projects:
  - key: iamps
    label: "IAMPS"
    project_root: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/06 IAMPS"
    project_context: "/Users/wenzel/Work/ASE/CurrentStateAssessments/.agents/csa-context/IAMPS_PROJECT_CONTEXT.yaml"
    work_dir: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/06 IAMPS/csa-work"
    default_source_set: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/06 IAMPS/01 Current State AS Built/IAMPS Discovery Data"

  - key: utcdtc
    label: "UTC DTC with KVM"
    project_root: "/Users/wenzel/Work/ASE/CurrentStateAssessments/UTC DTC/07 UTC DTC with KVM"
    project_context: "/Users/wenzel/Work/ASE/CurrentStateAssessments/.agents/csa-context/UTC_DTC_PROJECT_CONTEXT.yaml"
    work_dir: "/Users/wenzel/Work/ASE/CurrentStateAssessments/UTC DTC/07 UTC DTC with KVM/csa-work"
    default_source_set: "/Users/wenzel/Work/ASE/CurrentStateAssessments/UTC DTC/07 UTC DTC with KVM/01 Current State AS Built/UTC Discovery Data"
    index_extra_sources: "/Users/wenzel/Work/ASE/CurrentStateAssessments/UTC DTC/07 UTC DTC with KVM/02 Current State Assessment"
    sites: "ROK=Rockhampton,MKY=Mackay"

  - key: iamps-v12
    label: "IAMPS (template v1.2 build pilot)"
    project_root: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/07 IAMPS v1.2 build"
    project_context: "/Users/wenzel/Work/ASE/CurrentStateAssessments/.agents/csa-context/IAMPS_V12_PROJECT_CONTEXT.yaml"
    work_dir: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/07 IAMPS v1.2 build/csa-work"
    default_source_set: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/06 IAMPS/01 Current State AS Built/IAMPS Discovery Data"
    # sections by key and the numbers Word shows (csa spec shadow: no differences, 2 Oct 2026)
    spec_mode: on

  - key: iamps-08
    label: "IAMPS (template v1.3)"
    project_root: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/08 IAMPS"
    project_context: "/Users/wenzel/Work/ASE/CurrentStateAssessments/.agents/csa-context/IAMPS_08_PROJECT_CONTEXT.yaml"
    work_dir: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/08 IAMPS/csa-work"
    default_source_set: "/Users/wenzel/Work/ASE/CurrentStateAssessments/IAMPS/06 IAMPS/01 Current State AS Built/IAMPS Discovery Data"

  - key: tetra-reveloc
    label: "REVELOC TETRA (template v1.5)"
    project_root: "/Users/wenzel/Work/ASE/CurrentStateAssessments/TETRA/06 REVELOC TETRA"
    project_context: "/Users/wenzel/Work/ASE/CurrentStateAssessments/.agents/csa-context/TETRA_REVELOC_PROJECT_CONTEXT.yaml"
    work_dir: "/Users/wenzel/Work/ASE/CurrentStateAssessments/TETRA/06 REVELOC TETRA/csa-work"
    default_source_set: "/Users/wenzel/Work/ASE/CurrentStateAssessments/TETRA/05 Revloc Tetra/01 Current State AS Built"
    index_extra_sources: "/Users/wenzel/Work/ASE/CurrentStateAssessments/TETRA/05 Revloc Tetra/02 Current State Assessment"
    legacy_docx: "/Users/wenzel/Work/ASE/CurrentStateAssessments/TETRA/05 Revloc Tetra/02 Current State Assessment/NetSeg_Current_State_Assessment_REVELOC_TETRA.docx"

    # sections by key and the numbers Word shows (csa spec shadow: no differences, 2 Oct 2026)
