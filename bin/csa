                step = f"{r['step']}." if r.get("step") else "  "
                print(f"  {step:<3}{r['verb']:<9} {r.get('summary','')}")
                print(f"       {C['d']}{r['file']}  inputs: {r.get('inputs','')}{C['0']}")


# ---------------------------------------------------------------- commands: status
def cmd_status(a):
    p = project(a.project)
    if a.section:
        st = section_state(p, a.section, getattr(a, "file", None))
        if a.json:
            return print(json.dumps(st, indent=2))
        banner(p)
        for k in ("section", "title", "stage", "change_file", "status_line", "apply_status"):
            print(f"{k:>13}: {st.get(k)}")
        print(f"{'other files':>13}: {', '.join(Path(x).name for x in st['other_change_files']) or '-'}")
        print(f"{'edits':>13}: {len(st['edits'])}  {', '.join(st['edits'])}")
        print(f"{'completed':>13}: {', '.join(st['completed']) or '-'}")
        print(f"{'blocked':>13}: {', '.join(st['blocked']) or '-'}")
        print(f"{'review':>13}: {st['review_result'] or '-'}   sign-off: {st['signoff'] or '-'}   cleaned: {st['cleaned']}")
        print(f"{'next':>13}: {C['g']}{st['next'] or 'nothing'}{C['0']}")
        return
    states = all_states(p)
    if a.json:
        return print(json.dumps(states, indent=2))
    banner(p)
    if not states:
        print("No change files yet. Start a section with `csa author <N>`.")
    print(f"{C['b']}{'Sec':>3}  {'Title':<34} {'Edits':>5}  {'Stage':<40} Next{C['0']}")
    for s in states:
        colour = C["g"] if s["stage"] in ("done", "authored, no edits (clean)") else C["r"] if "BLOCK" in s["stage"] or "FAIL" in s["stage"] else C["y"]
        print(f"{(s.get('subsection') or s['section']):>3}  {s['title'][:34]:<34} {len(s['edits']):>5}  {colour}{s['stage'][:40]:<40}{C['0']} {C['d']}{s['next'] or ''}{C['0']}")
        if s.get("other_change_files"):
            print(f"     {C['d']}+ {len(s['other_change_files'])} other change file(s): "
                  f"{', '.join(Path(x).name for x in s['other_change_files'])}{C['0']}")
    print(f"{C['d']}Only sections with a change file are listed; `csa author <N>` starts another.{C['0']}")
    if spec_mode(p) != "off" and working_docx(p):
        r = spec_call(p, "next")
        if r.returncode == 0 and r.stdout.strip():
            print(f"\n{C['b']}Still to answer, in document order (csa spec):{C['0']}")
            print(r.stdout.rstrip())


def cmd_report(a):
    p = project(a.project)
    mf = local_path(p["work_dir"]) / "metrics.jsonl"
    if not mf.is_file():
        return print("No metrics yet (csa-work/metrics.jsonl).")
    secs = {}
    for line in mf.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        e = json.loads(line); s = str(e.get("section"))
        d = secs.setdefault(s, {"section": s, "approvals": 0, "edits_approved": 0, "edits_rejected": 0,
                                "apply_batches": 0, "blocked_batches": 0, "last_review": "-"})
        if e["event"] == "approve":
            d["approvals"] += 1; d["edits_approved"] = len(e.get("approved") or []); d["edits_rejected"] = len(e.get("rejected") or [])
        elif e["event"] == "apply":
            d["apply_batches"] += 1; d["blocked_batches"] += e.get("status") == "BLOCKED"
        elif e["event"] == "review":
            d["last_review"] = e.get("result") or "-"
    rows = sorted(secs.values(), key=lambda d: (not d["section"].isdigit(), int(d["section"]) if d["section"].isdigit() else 0))
    def acc(d):
        t = d["edits_approved"] + d["edits_rejected"]
        return f"{round(100 * d['edits_approved'] / t)}%" if t else "-"
    total = {k: sum(d[k] for d in rows) for k in ("approvals", "edits_approved", "edits_rejected", "apply_batches", "blocked_batches")}
    if a.json:
        return print(json.dumps({"sections": [dict(d, acceptance=acc(d)) for d in rows], "total": dict(total, acceptance=acc(total))}, indent=2))
    banner(p)
    print("Sec  Approvals  Approved  Rejected  Acceptance  Batches  Blocked  Last review")
    for d in rows + [dict(total, section="all", last_review="")]:
        print(f"{d['section']:>3}  {d['approvals']:>9}  {d['edits_approved']:>8}  {d['edits_rejected']:>8}  {acc(d):>10}  {d['apply_batches']:>7}  {d['blocked_batches']:>7}  {d['last_review']}")


def cmd_next(a):
    p = project(a.project)
    states = all_states(p)
    order = lambda s: (0 if "BLOCK" in s["stage"] or "FAIL" in s["stage"] else 1 if s["stage"].startswith("applying") else
                       2 if s["stage"] == "authored, not applied" else 3 if s["next"] and "review" in s["next"] else
                       4 if s["next"] and "cleanup" in s["next"] else 5, int(s["section"]))
    todo = sorted([s for s in states if s["next"]], key=order)
    if a.json:
        return print(json.dumps([{"section": s["section"], "stage": s["stage"], "next": s["next"]} for s in todo], indent=2))
    banner(p)
    if not todo:
        if spec_mode(p) != "off" and working_docx(p):
            rows = json.loads(spec_call(p, "--json", "next").stdout or "[]")
            if rows:
                r0 = rows[0]
                print(f"{r0['number']} {r0['title']} - {r0['open']} open item(s), from the document\n  -> {C['g']}{r0['command']}{C['0']}")
                if len(rows) > 1:
                    print(f"{C['d']}then: " + "; ".join(f"{r['number'] or r['key']}: {r['command']}" for r in rows[1:6]) + C["0"])
                return
        return print("Nothing pending. Every known section is done or clean.")
    s = todo[0]
    print(f"Section {s['section']} {s['title']} - {s['stage']}\n  -> {C['g']}{s['next']}{C['0']}")
    if len(todo) > 1:
        print(f"{C['d']}then: " + "; ".join(f"S{t['section']}: {t['next']}" for t in todo[1:6]) + C["0"])


# ---------------------------------------------------------------- commands: framework
def _ws(p: dict) -> str:
    return str(local_path(p["project_root"]))   # mapped when the checkout is mounted elsewhere (VM)


def _emit(res: dict, a) -> int:
    if getattr(a, "json", False):
        print(json.dumps(res, indent=2))
    else:
        status = res.get("status", "?")
        colour = C["g"] if status in ("OK", "READY", "SECTION_COMPLETE", "PARTIAL_COMPLETE") else C["r"]
        print(f"{colour}{status}{C['0']}")
        for k, v in res.items():
            if k != "status":
                print(f"  {k}: {json.dumps(v, default=str) if isinstance(v, (dict, list)) else v}")
    return 0 if res.get("status") not in ("ERROR", "NOT_READY", "BLOCKED") else 2


def cmd_prepare(a):
    p = project(a.project); banner(p)
    kw = {"workspace": _ws(p), "force_regenerate": a.force}
    if a.section:
        kw["section"] = a.section
    res = fw_call("prepareDocument", **kw)
    proj = (res.get("project") or {}).get("key")
    if proj and proj != p["key"]:
        res = {"status": "ERROR", "message": f"prepareDocument resolved project '{proj}', expected '{p['key']}'. Stopping."}
    return _emit(res, a)


def cmd_lookup(a):
    p = project(a.project); banner(p)
    kw = {"workspace": _ws(p)}
    if a.kind:
        kw["kind"] = a.kind
    return _emit(fw_call("lookupStableId", a.query, **kw), a)


def cmd_validate(a):
    p = project(a.project); banner(p)
    return _emit(fw_call("validate_section", str(a.section), workspace=_ws(p)), a)


def cmd_refresh(a):
    p = project(a.project); banner(p)
    return _emit(fw_call("refresh_manifest", workspace=_ws(p)), a)


def author_dir(p: dict, section: str, label: str | None = None) -> Path:
    """WORK_DIR/author/<KEY>/ (spec_mode on) or author/<3-1>/: the author's brief, search notes, report and timing."""
    num = label_display(section, label)
    slug = re.sub(r"[^0-9A-Za-z]+", "-", num).strip("-")
    base = local_path(p["work_dir"]) / "author"
    if spec_mode(p) == "off" or not working_docx(p):
        return base / slug
    res = spec_resolve(p, num)
    if res.get("status") != "OK":
        return base / slug
    if spec_mode(p) == "on":
        return base / res["key"]
    if (base / res["key"]).is_dir() and not (base / slug).is_dir():
        shadow_log(p, "author_dir", slug, res["key"], target=num)
    return base / slug


def spec_call(p: dict, *args, capture: bool = True) -> subprocess.CompletedProcess:
    """csa_docx.spec_cli on the project's working document (or its template when there is none yet)."""
    docx = working_docx(p)
    argv = [framework_python(), "-m", "csa_docx.spec_cli", "--work-dir", str(local_path(p["work_dir"]))]
    if docx:
        argv += ["--docx", str(docx)]
    return subprocess.run(argv + [str(x) for x in args], cwd=str(FRAMEWORK), capture_output=capture, text=True,
                          env=_fw_env())


def resolve_target(p: dict, target: str) -> dict:
    """A section target (visible number, heading, requirement family or stamp key) -> {'number', 'key', 'title'},
    read from the live document. Never a guess: an unknown target comes back with the headings the document has."""
    r = spec_call(p, "resolve", target)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {"status": "ERROR", "message": (r.stderr or r.stdout or "no output")[-600:]}


def section_arg(p: dict, target: str) -> str:
    """The visible number for a target given by number, heading, family or key; dies with the document's headings."""
    if re.fullmatch(r"\d+(\.\d+)*", str(target)):
        return str(target)
    res = resolve_target(p, target)
    if res.get("status") != "OK":
        die(res.get("message", f"cannot resolve '{target}'"))
    print(f"{C['d']}{target} -> {res['number']} {res['title']} ({res['key']}){C['0']}", file=sys.stderr)
    return res["number"]


def _autofix_change(p: dict, cf: Path, section: str | None = None, label: str | None = None) -> None:
    """Fix the mechanical check-change errors (Markdown or IDs in Text, duplicate edit IDs, a missing `currently:`
    quote) before a check, and say what was fixed. Never on an approved or partly applied file: its hashes stand."""
    try:
        if section:
            st = section_state(p, section, label)
            if st["approved"] or st["completed"]:
                return
        res = _fw_json("csa_docx.autofix_change", cf, "--workspace", local_path(p["project_root"]), "--write", "--json")
    except OSError:
        return
    for f in res.get("fixes", []):
        print(f"{C['d']}autofix {f['code']} {f.get('edit_id') or ''}: {f['message']}{C['0']}")


def run_check_change(p: dict, cf: Path, a, strict: bool = False, section: str | None = None, label: str | None = None) -> int:
    argv = [framework_python(), "-m", "csa_docx.check_change", str(cf), "--workspace", str(local_path(p["project_root"]))]
    if strict:
        argv.append("--strict")
    if section and p.get("work_dir"):
        argv += ["--notes", str(author_dir(p, section, label) / "search-notes.md")]
        if label:                                  # the subsection as the document defines it (csa spec)
            r = spec_call(p, "--json", "show", label_display(section, label))
            if r.returncode == 0 and r.stdout.strip().startswith("{"):
                nf = local_path(p["work_dir"]) / "spec" / f"node-{label}.json"
                nf.parent.mkdir(parents=True, exist_ok=True)
                node = json.loads(r.stdout)
                node.setdefault("ratings", None)
                nf.write_text(json.dumps(node), encoding="utf-8")
                argv += ["--node", str(nf)]
    if p.get("work_dir"):
        argv += ["--evidence", str(local_path(p["work_dir"]) / "evidence-matrix.csv")]
    if p.get("sites"):
        argv += ["--sites", p["sites"]]
    for flag, name in (("--no-anchors", "no_anchors"), ("--no-lint", "no_lint"), ("--json", "json")):
        if getattr(a, name, False):
            argv.append(flag)
    return subprocess.call(argv, cwd=str(FRAMEWORK))


def _audit_dirs(p: dict) -> list[Path]:
    root = local_path(p["work_dir"]) / "audit"
    return sorted((d for d in root.glob("2*") if (d / "audit.json").is_file()), key=lambda d: d.name) if root.is_dir() else []


def cmd_audit(a):
    """csa audit            scripted checks on the working DOCX -> WORK_DIR/audit/<id>/
    csa audit --status   units and which have an agent audit
    csa audit --report   assemble the Word report for the latest (or --id) audit"""
    p = project(a.project); banner(p)
    env = dict(os.environ, PYTHONPATH=os.pathsep.join([str(FRAMEWORK), str(FRAMEWORK / "vendor"), os.environ.get("PYTHONPATH", "")]))
    if a.report or a.status:
        dirs = _audit_dirs(p)
        d = next((x for x in dirs if x.name == a.id), None) if a.id else (dirs[-1] if dirs else None)
        if not d:
            die("no audit found; run `csa audit` first")
        if a.status:
            j = json.loads((d / "audit.json").read_text(encoding="utf-8"))
            done = {f.stem for f in (d / "sections").glob("*.md")}
            print(f"Audit {d.name}: {len(j['units'])} units, {len(done)} audited in depth")
            for u in j["units"]:
                print(f"  [{'x' if u['slug'] in done else ' '}] {u['title']}")
            nxt = next((u for u in j["units"] if u["slug"] not in done), None)
            if nxt:
                print(f"Next: csa audit-section SECTION={nxt['slug']}")
            return 0
        return subprocess.call([framework_python(), "-m", "csa_docx.audit_report", str(d)], cwd=str(FRAMEWORK), env=env)
    docx = working_docx(p)
    if not docx:
        res = fw_call("prepareDocument", workspace=_ws(p))
        docx = Path(res["docx"]) if res.get("docx") else None
    if not docx:
        die("no working DOCX found")
    rc = subprocess.call([framework_python(), "-m", "csa_docx.audit", str(docx), "--work-dir", str(local_path(p["work_dir"])),
                          "--label", p.get("label", p["key"])], cwd=str(FRAMEWORK), env=env)
    if rc == 0:
        print("Next: csa audit --status, then `csa audit-section SECTION=next` per unit, then `csa audit --report`.")
    metric(p, "audit", None, exit=rc)
    return rc


def cmd_comments(a):
    p = project(a.project); banner(p)
    docx = working_docx(p)
    if not docx:
        fv = sorted(local_path(p["project_root"]).rglob("01 Final Version/*.docx"))
        docx = next((d for d in fv if not d.name.startswith("~$") and not _archived(d, local_path(p["project_root"]))), None)
    if not docx:
        die("no working DOCX found")
    argv = [framework_python(), "-m", "csa_docx.list_comments", str(docx)]
    if a.heading:
        argv += ["--heading", a.heading]
    if a.json:
        argv.append("--json")
    return subprocess.run(argv, cwd=str(FRAMEWORK)).returncode


def author_report(p: dict, cf: Path, section: str, label: str | None, summary_only: bool = False) -> int:
    """Set the change file's brief against its records (csa_docx.author_report); saved beside the brief."""
    out = author_dir(p, section, label) / "report.md"
    argv = [framework_python(), "-m", "csa_docx.author_report", str(cf), "--out", str(out)]
    if summary_only:
        argv.append("--summary")
    rc = subprocess.run(argv, cwd=str(FRAMEWORK), env=_fw_env()).returncode
    if rc == 0 and summary_only:
        print(f"{C['d']}full report: {out} (`csa author-report {label_display(section, label)}`){C['0']}")
    return rc


def cmd_author_report(a):
    p = project(a.project); banner(p)
    st = section_state(p, a.section, getattr(a, "file", None))
    if not st["change_file"]:
        die(f"section {label_display(a.section, getattr(a, 'file', None))} has no change file.")
    return author_report(p, Path(st["change_file"]), a.section, getattr(a, "file", None))


def cmd_check_change(a):
    p = project(a.project); banner(p)
    st = section_state(p, a.section, getattr(a, "file", None))
    if not st["change_file"]:
        die(f"section {label_display(a.section, getattr(a, 'file', None))} has no change file.")
    if not getattr(a, "no_autofix", False) and not getattr(a, "json", False):
        _autofix_change(p, Path(st["change_file"]), a.section, getattr(a, "file", None))
    rc = run_check_change(p, Path(st["change_file"]), a, section=a.section, label=getattr(a, "file", None))
    metric(p, "check_change", a.section, exit=rc)
    return rc

def run_check_section(p: dict, cf: Path, a) -> int:
    argv = [framework_python(), "-m", "csa_docx.check_section", str(cf), "--workspace", str(local_path(p["project_root"]))]
    for flag, name in (("--no-lint", "no_lint"), ("--json", "json")):
        if getattr(a, name, False):
            argv.append(flag)
    return subprocess.call(argv, cwd=str(FRAMEWORK))


def cmd_check_section(a):
    p = project(a.project); banner(p)
    cf = Path(a.file)
    if not cf.is_absolute():
        cf = local_path(p["work_dir"]) / "sections" / a.file
    if not cf.is_file():
        die(f"no section file {a.file!r} under <work_dir>/sections/ (or pass a full path).")
    rc = run_check_section(p, cf, a)
    metric(p, "check_section", cf.name, exit=rc)
    return rc


def section_front_matter(text: str) -> dict[str, str]:
    """Flat key: value lines between the first two '---' lines of a section file ({} if none)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    out: dict[str, str] = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return out
        if ":" in line:
            k, v = line.split(":", 1)
            out[k.strip().lower()] = v.strip()
    return {}


def section_review(p: dict, f: Path) -> tuple[str | None, str | None]:
    """(verdict, problem) for a section file's review in <work_dir>/reviews/section-<stem>-review.md.
    There is no human approval of section files: the human gate is the tracked-change review in Word."""
    rev = local_path(p["work_dir"]) / "reviews" / f"section-{f.stem}-review.md"
    if not rev.is_file():
        return None, "no review"
    first = next((l.strip() for l in rev.read_text(encoding="utf-8").splitlines() if l.strip()), "")
    up = first.upper()
    verdict = ("NOT READY" if "NOT READY" in up else "READY WITH DECLARED GAPS" if "DECLARED GAPS" in up
               else "READY" if "READY" in up else None)
    if verdict is None:
        return None, "review has no Verdict line"
    if rev.stat().st_mtime < f.stat().st_mtime:
        return verdict, "review older than file"
    if verdict == "NOT READY":
        return verdict, "not ready"
    return verdict, None


def section_rows(p: dict) -> list[dict]:
    sd = local_path(p["work_dir"]) / "sections"
    rows = []
    for f in sorted(sd.glob("*.md")) if sd.is_dir() else []:
        fm = section_front_matter(f.read_text(encoding="utf-8"))
        status = fm.get("status") or ("draft" if fm else None)
        verdict, review_note = section_review(p, f)
        # The review verdict is information, not a gate: `csa write` places a section file in the
        # document as soon as it is written, and Wenzel approves the tracked changes in Word.
        problem = "no front matter" if not fm else None
        rows.append({"file": f.name, "block": fm.get("block"), "heading": fm.get("heading"),
                     "status": status, "review": verdict, "review_note": review_note, "problem": problem})
    return rows


def cmd_sections(a):
    p = project(a.project); banner(p)
    rows = section_rows(p)
    if a.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print(f"no section files under {local_path(p['work_dir']) / 'sections'}")
        return 0
    for r in rows:
        where = r["problem"] or ("in the document" if r["status"] == "built" else "not placed yet (csa place " + r["file"] + ")")
        review = r["review"] or "-"
        if r["review_note"] and r["review_note"] not in ("no review", "not ready"):
            review += f" ({r['review_note']})"
        print(f"{r['file']:<42} {r['status'] or '-':<9} review={review:<26} {where}")
    placed = sum(1 for r in rows if r["status"] == "built")
    print(f"\n{placed} of {len(rows)} in the document. `csa write` places a section as soon as it is written; "
          "you approve the tracked changes in Word.")
    return 0


def cmd_approve(a):
    p = project(a.project); banner(p)
    st = section_state(p, a.section, getattr(a, "file", None))
    if not st["change_file"]:
        die(f"section {label_display(a.section, getattr(a, 'file', None))} has no change file yet. Run `csa author {label_display(a.section, getattr(a, 'file', None))}` first.")
    cf = Path(st["change_file"])
    text = cf.read_text(encoding="utf-8")
    rejected = [e.strip().upper() for e in (getattr(a, "reject", None) or [])]
    if rejected and not a.revoke:
        for eid in rejected:
            text, n = re.subn(rf"^(#{{2,4}}\s+)({re.escape(eid)}\s+-\s)", r"\1REJECTED \2", text, count=1, flags=re.M)
            if not n:
                die(f"{eid} is not an edit heading in {cf.name}")
        cf.write_text(text, encoding="utf-8")
        st = section_state(p, a.section)
    m = STATUS_LINE_RE.search(text)
    if not m:
        die(f"no '**Status:**' line in {cf}; add one before approving.")
    if a.revoke:
        new = "**Status:** Proposed changes for approval. This file is an approval record only."
    else:
        if not st["edits"]:
            die("the change file has no edits to approve (reviewed-and-clean).")
        if run_check_change(p, cf, argparse.Namespace()) != 0 and not a.force:
            die("csa check-change found errors (above). Fix them, or approve anyway with --force.")
        if st["approved"] and not a.yes:
            return print(f"Already approved: {st['status_line']}")
        who = a.by or settings().get("comment_author", os.environ.get("USER", "unknown"))
        edits = ", ".join(st["edits"])
        if not a.yes:
            print(f"Change file: {cf}\nEdits: {edits}")
            if not sys.stdin.isatty() or input("Approve these edits for implementation? [y/N] ").strip().lower() != "y":
                die("not approved.")
        new = (f"**Status:** Approved for implementation {datetime.now():%Y-%m-%d %H:%M} by {who}. Edits: {edits}."
               + (f" Rejected: {', '.join(rejected)}." if rejected else ""))
    cf.write_text(text[:m.start()] + new + text[m.end():], encoding="utf-8")
    af = approval_file(cf)
    if a.revoke:
        if af.exists():
            af.unlink()
    else:
        af.write_text(json.dumps({"approved_at": datetime.now().isoformat(timespec="seconds"), "by": who, "rejected": rejected,
                                  "hashes": edit_record_hashes(cf.read_text(encoding="utf-8"))}, indent=2) + "\n",
                      encoding="utf-8")
    print(new)
    metric(p, "revoke" if a.revoke else "approve", a.section,
           approved=[] if a.revoke else section_state(p, a.section)["edits"], rejected=rejected)


def close_in_word(docx: Path, wait: float = 20.0) -> bool:
    """Save and close ``docx`` in Microsoft Word (macOS only), then wait for Word's lock file to go.
    Returns True when the document is no longer open. Other open documents are left alone."""
    lock = docx.parent / ("~$" + docx.name[2:])
    if not lock.exists():
        return True
    if sys.platform != "darwin" or not shutil.which("osascript"):
        return False
    script = ('tell application "Microsoft Word"\n'
              '  repeat with d in (documents)\n'
              f'    if (full name of d) is "{docx}" or (name of d) is "{docx.name}" then close d saving yes\n'
              '  end repeat\n'
              'end tell')
    subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=60)
    end = time.time() + wait
    while time.time() < end:
        if not lock.exists():
            return True
        time.sleep(0.5)
    return not lock.exists()


def _apply_once(p, a, limit):
    kw = {"workspace": _ws(p), "comment_author": settings().get("comment_author", "Wenzel Joubert"),
          "comment_initials": settings().get("comment_initials", "WJ")}
    if a.edit:
        kw["start_edit_id"] = kw["end_edit_id"] = a.edit
    if getattr(a, "file", None):
        kw["change_file"] = section_state(p, a.section, a.file)["change_file"]
    return fw_call("apply_next_batch", str(a.section), limit, **kw)


def cmd_apply(a):
    p = project(a.project); banner(p)
    st = section_state(p, a.section, getattr(a, "file", None))
    if not st["change_file"]:
        die(f"section {label_display(a.section, getattr(a, 'file', None))} has no change file. Run `csa author {label_display(a.section, getattr(a, 'file', None))}` first.")
    cf = Path(st["change_file"])
    if st["edits"] and (not st["approved"] or approval_problems(cf)):
        # No human step between authoring and apply: check the file, record what is applied, apply it.
        # Wenzel approves the result in Word (accept / reject), then `csa review` and `csa cleanup`.
        if not a.allow_unapproved and run_check_change(p, cf, argparse.Namespace(), strict=True, section=a.section,
                                                      label=getattr(a, "file", None)) != 0:
            die(f"csa check-change found errors in {cf.name} (above). Fix the change file; it is applied as written."
                " (--allow-unapproved skips this check.)")
        record_approval(p, cf, a.section, f"csa apply ({settings().get('comment_author', os.environ.get('USER', 'unknown'))})",
                        "csa apply")
        st = section_state(p, a.section, getattr(a, "file", None))
    if a.agent:
        return launch(p, agent("apply"), [label_display(a.section, getattr(a, "file", None))] + (a.set or []), a)
    limit = a.limit or 2
    rounds, max_rounds = 0, (a.max_batches if a.until_done else 1)
    while True:
        rounds += 1
        res = _apply_once(p, a, limit)
        status = res.get("status")
        if status == "NOT_READY" and "locked_by_word" in (res.get("reasons") or []) and not a.keep_open:
            docx = Path(res.get("docx") or "")
            print(f"{docx.name} is open in Word; saving and closing it ...")
            if close_in_word(docx):
                print("closed; retrying")
                res = _apply_once(p, a, limit)
                status = res.get("status")
            else:
                print("could not close it automatically (only possible on the Mac, with Word's permission)")
        applied = (res.get("applied") or []) + (res.get("already_applied") or [])
        print(f"batch {rounds}: {status}  applied={applied}  next={res.get('next_edit_id')}")
        metric(p, "apply", a.section, batch=rounds, status=status, applied=applied, blocked=res.get("blocked") or [])
        if a.json:
            print(json.dumps(res, indent=2))
        if status == "BLOCKED" and a.agent_on_block:
            print("BLOCKED -> handing the section to the document agent")
            return launch(p, agent("apply"), [label_display(a.section, getattr(a, "file", None))] + (a.set or []), a)
        if status != "PARTIAL_COMPLETE" or rounds >= max_rounds or a.edit:
            break
        if not applied:
            print("no progress in this batch; stopping.")
            break
    if status == "BLOCKED":
        print(f"{C['r']}Blocked: {res.get('blocked')}{C['0']}\n  -> csa apply {label_display(a.section, getattr(a, 'file', None))} --agent   (LLM resolves or reports the ambiguity)")
    elif status == "SECTION_COMPLETE":
        print(f"{C['g']}Section {label_display(a.section, getattr(a, 'file', None))} applied.{C['0']} Next: csa review {label_display(a.section, getattr(a, 'file', None))}")
    elif status in ("NOT_READY", "ERROR"):
        _emit(res, argparse.Namespace(json=False))
    return 0 if status in ("SECTION_COMPLETE", "PARTIAL_COMPLETE") else 2


# ---------------------------------------------------------------- commands: place (section file -> document)
def _order_key(text: str):
    """(3, 4) for '3.04' or '3.4', (4,) for '4'; None when the text is not a section number."""
    parts = str(text).strip().split(".")
    return tuple(int(x) for x in parts) if parts and all(x.isdigit() for x in parts) else None


def section_file_for(p: dict, target: str) -> Path:
    """A section file by file name, stem, section number (3.4 = 3.04-*.md; 'Executive Summary' = 2.1)
    or heading text."""
    sd = local_path(p["work_dir"]) / "sections"
    t = str(target).strip()
    f = Path(t)
    if f.is_absolute() and f.is_file():
        return f
    for cand in (sd / t, sd / f"{t}.md"):
        if cand.is_file():
            return cand
    files = sorted(sd.glob("*.md")) if sd.is_dir() else []
    if t.lower() in ("executive summary", "summary", "2.1"):
        t = "2.1"
    key = _order_key(t)
    norm = lambda x: re.sub(r"[^a-z0-9]+", " ", x.lower()).strip()
    hits = [x for x in files if key is not None and _order_key(x.name.split("-", 1)[0]) == key]
    if not hits:
        hits = [x for x in files if x.name.split("-", 1)[0].lower() == t.lower()
                or norm(section_front_matter(x.read_text(encoding="utf-8")).get("heading", "")) == norm(t)]
    if len(hits) != 1:
        die(f"{'no' if not hits else 'more than one'} section file for {target!r} under {sd}"
            + (f": {', '.join(x.name for x in hits)}" if hits else ""))
    return hits[0]


def project_context_value(p: dict, key: str) -> str:
    """A flat `key: value` under `project:` in the project context YAML ('' when absent or blank)."""
    path = local_path(p["project_context"]) if p.get("project_context") else None
    if not path or not path.is_file():
        return ""
    m = re.search(rf"^\s+{re.escape(key)}:\s*(.*)$", path.read_text(encoding="utf-8"), re.M)
    return _unquote(m[1].split(" #")[0].strip()) if m else ""


def _document_in(fv: Path, system_name: str) -> Path | None:
    docs = sorted(d for d in fv.glob("*.docx") if not d.name.startswith("~$"))
    named = fv / f"Current State Assessment - {system_name}.docx"
    return named if named in docs else (docs[0] if len(docs) == 1 else None)


class _PlaceLock:
    """One placement or apply at a time per document folder (fleet workers and story runs place in parallel)."""
    def __init__(self, folder: Path):
        self.path = folder / ".csa-place.lock"

    def __enter__(self):
        import fcntl
        self.fh = open(self.path, "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        import fcntl
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def _mark_placed(f: Path) -> None:
    text = f.read_text(encoding="utf-8")
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    if re.search(r"^status:.*$", text, re.M):
        text = re.sub(r"^status:.*$", "status: built", text, count=1, flags=re.M)
    else:
        text = text.replace("---", "---\nstatus: built", 1)
    if re.search(r"^placed:.*$", text, re.M):
        text = re.sub(r"^placed:.*$", f"placed: {stamp}", text, count=1, flags=re.M)
    else:
        text = re.sub(r"^status: built$", f"status: built\nplaced: {stamp}", text, count=1, flags=re.M)
    f.write_text(text, encoding="utf-8")


def cmd_place(a):
    """Put section files straight into the working document as tracked changes (version 0.1 is created
    from the template on the first placement). No approval step: Wenzel approves in Word."""
    p = project(a.project); banner(p)
    plain = getattr(a, "plain", False)
    root = local_path(p["project_root"])
    fv = root / "01 Current State AS Built" / "01 Final Version"
    existing = sorted(d for d in fv.glob("*.docx") if not d.name.startswith("~$"))
    from_doc = (m[1] if len(existing) == 1 and (m := re.match(r"Current State Assessment - (.+)\.docx$", existing[0].name))
                else None)
    system_name = (a.system_name or from_doc or project_context_value(p, "application")
                   or p.get("label") or p["key"])
    prepared_for = a.prepared_for or project_context_value(p, "organisation") or None
    files = [section_file_for(p, t) for t in a.targets]
    for f in files:
        if run_check_section(p, f, argparse.Namespace(no_lint=False, json=False)) != 0:
            die(f"cannot place {f.name}: csa check-section reported errors (above). Fix the section file first.")
    fv.mkdir(parents=True, exist_ok=True)
    with _PlaceLock(fv):
        for f in files:
            docx = _document_in(fv, system_name)
            if docx and (docx.parent / ("~$" + docx.name[2:])).exists() and not a.keep_open:
                print(f"{docx.name} is open in Word; saving and closing it ...")
                if not close_in_word(docx):
                    die(f"{docx.name} is open in Word; close it and run `csa place {f.name}` again.")
            before = {x.name for x in fv.glob("*.docx")} | {x.name for x in fv.glob("reviews/*")} | {x.name for x in fv.glob("run-state/*")}
            if plain:
                blocked = _fw_module_call("build", "plain_blocker", str(root), str(f), system_name=system_name)
                if isinstance(blocked, dict) and blocked.get("status") == "ERROR":
                    die(f"could not check {f.name} for tracked changes: {blocked.get('message')}")
                if blocked:
                    die(f"cannot place {f.name} plain: {blocked}")
            res = _fw_module_call("build", "place_prepare", str(root), str(f), system_name=system_name, source=f.name,
                                  prepared_for=prepared_for, prepared_by=a.prepared_by,
                                  doc_version=a.doc_version, status=a.status)
            if res.get("status") == "ERROR":
                if docx is None:        # a failed first placement leaves no half-made document behind
                    for x in list(fv.glob("*.docx")) + list(fv.glob("reviews/ChangesCSA_*")) + list(fv.glob("run-state/*")):
                        if x.is_file() and x.name not in before:
                            x.unlink(missing_ok=True)
                die(f"could not place {f.name}: {res.get('message')}")
            if not plain:
                for sec, cf in res["change_files"].items():
                    record_approval(p, Path(cf), sec, f"csa place {f.name}", "csa place")
            applied = _fw_module_call("build", "place_apply", str(root), res["sections"],
                                      system_name=system_name, docx=res["docx"], change_files=res["change_files"],
                                      plain=plain, new_edits=res["new_edits"], new_files=res["new_files"])
            new = [e for ids in res["new_edits"].values() for e in ids]
            if applied.get("status") == "ERROR":
                metric(p, "place", f.name, status="BLOCKED", edits=new)
                die(f"placing {f.name} stopped: {applied.get('message')}\n  Edits already applied stay as tracked changes. "
                    f"Fix the section file and run `csa place {f.name}` again, or run `csa apply "
                    f"{res['sections'][0]} --agent` to let the document agent resolve it.")
            _mark_placed(f)
            metric(p, "place", f.name, status="PLACED", edits=new, created=res["created"], **({"plain": True} if plain else {}))
            if plain:
                print(f"{C['g']}PLACED (plain){C['0']} {f.name}")
                continue
            print(f"{C['g']}PLACED{C['0']} {f.name} -> {Path(res['docx']).name}"
                  + (" (created version 0.1)" if res["created"] else "")
                  + (f": {len(new)} tracked change(s), {new[0]}..{new[-1]}" if new else ""))
    if not plain:
        print(f"{C['d']}Accept or reject the tracked changes in Word, then csa review <N> and csa cleanup <N>.{C['0']}")
    return 0


def _after_agent(p: dict, verb: str, args: list[str], started: float, a) -> int:
    """Change the document straight after the agent that wrote the change: an author run's change file
    is applied, a writer's section file is placed. `--no-apply` stops after the agent."""
    r = agent(verb)
    values = task_values(r, args)
    spec = values.get("SECTION", "")
    if verb == "author" or (verb == "write" and values.get("MODE", "").lower() == "records"):
        sec, label = split_section(spec)
        if not sec or not str(sec).isdigit():
            return 0
        st = section_state(p, sec, label)
        cf = Path(st["change_file"]) if st["change_file"] else None
        if not cf or not st["edits"] or cf.stat().st_mtime < started - 1:
            return 0
        _autofix_change(p, cf, sec, label)
        author_report(p, cf, sec, label, summary_only=True)
        print(f"{C['b']}Applying {cf.name} now (tracked changes; you approve in Word).{C['0']}")
        ns = argparse.Namespace(project=a.project, section=sec, file=label, allow_unapproved=False, agent=False, set=None,
                                limit=None, until_done=True, max_batches=50, edit=None, json=False,
                                agent_on_block=False, cli=getattr(a, "cli", None), headless=getattr(a, "headless", False),
                                print=False, keep_open=False)
        return cmd_apply(ns)
    if verb == "write" and values.get("MODE", "").lower() == "move":
        return 0        # csa move places the section as plain text, then records it
    if verb in ("write", "summary") and values.get("OUTPUT", "section-file") == "section-file":
        sd = local_path(p["work_dir"]) / "sections"
        fresh = [x.name for x in sorted(sd.glob("*.md")) if x.stat().st_mtime >= started - 1] if sd.is_dir() else []
        if not fresh:
            return 0
        return cmd_place(argparse.Namespace(project=a.project, targets=fresh, system_name=None, prepared_for=None,
                                            prepared_by=None, doc_version=None, status=None, keep_open=False))
    return 0


