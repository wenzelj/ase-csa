#!/usr/bin/env python3
"""Launcher for the csa-mcp stdio server. Point Codex CLI's config.toml (or
any other MCP client) at this file's absolute path.

Mirrors framework/vendor/bin/docxengine-mcp. Note: some of this workspace's
other tooling notes pin /opt/homebrew/bin/python3.14 for dataclass `slots`
support -- that requirement is Python >= 3.10, so any python3.10+ on PATH
(the default `python3` resolved by the shebang above) works for this
server too; override the shebang directly if this machine's default python3
is older than 3.10.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from csa_docx.mcp import main

if __name__ == "__main__":
    sys.argv[0] = sys.argv[0].removesuffix(".exe")
    sys.exit(main())
