#!/usr/bin/env python3
"""csa -- one command for the Current State Assessment agents, skills and framework.

    csa use iamps                 set the active project (once)
    csa status [N]                where every section is in the pipeline
    csa next                      the next concrete action
    csa author 6                  launch an agent; its change file is applied as soon as it finishes
    csa write 3.4                 launch the writer; its section file is placed as soon as it finishes
    csa apply 6 --until-done      deterministic batches, agent only on BLOCKED
    (you approve in Word: accept or reject the tracked changes, then csa review / csa cleanup)
    csa fleet "author 6" "author 7"   run independent tasks side by side
    csa help                      everything else

Single source of truth for agents: .agents/registry.yaml. Settings: .agents/cli.yaml.
Runs on Python >= 3.10 with the standard library only. The csa_docx framework and
skill scripts run in a separate interpreter chosen from cli.yaml (needs >= 3.11).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

AGENTS_DIR = Path(__file__).resolve().parents[1]           # .../.agents
ROOT = AGENTS_DIR.parent                                    # .../CurrentStateAssessments
FRAMEWORK = AGENTS_DIR / "framework"
SKILLS = AGENTS_DIR / "skills"
STATE_DIR = AGENTS_DIR / ".state"
PROJECTS_FILE = (Path(os.environ["CSA_PROJECTS_FILE"]) if os.environ.get("CSA_PROJECTS_FILE")
                 else AGENTS_DIR / "csa-context" / "PROJECTS.yaml")
REGISTRY_FILE = AGENTS_DIR / "registry.yaml"
CLI_FILE = AGENTS_DIR / "cli.yaml"
REGISTERED_ROOT = "/Users/wenzel/Work/ASE/CurrentStateAssessments"
# Paths written into prompts and generated files must be the ones the user's CLIs see.
# When this checkout is a mount of the registered folder (same folder name, different
# prefix), write the registered path instead of the mount path.
CANON_ROOT = Path(REGISTERED_ROOT) if (str(ROOT) != REGISTERED_ROOT and ROOT.name == Path(REGISTERED_ROOT).name
                                       and not Path(REGISTERED_ROOT).exists()) else ROOT
CANON_AGENTS = CANON_ROOT / ".agents"

SCRIPTS = {
    "ev": SKILLS / "csa-evidence-matrix/scripts/evidence_matrix.py",
    "appendix": SKILLS / "csa-evidence-matrix/scripts/evidence_appendix.py",
    "cross-check": SKILLS / "csa-quality-review/scripts/cross_check.py",
    "findings": SKILLS / "csa-quality-review/scripts/findings_register.py",
    "graph": SKILLS / "csa-evidence-matrix/scripts/graph_store.py",
    "index": SKILLS / "csa-discovery-index/scripts/discovery_index.py",
    "lint": SKILLS / "csa-writing-style/scripts/prose_lint.py",
    "new": SKILLS / "csa-document-template/scripts/new_csa.py",
    "scaffold": SKILLS / "csa-document-template/scripts/scaffold_csa.py",
    "check": SKILLS / "csa-document-template/scripts/check_csa.py",
    "diagram": SKILLS / "csa-diagram-generator/scripts/build_diagram_model.py",
    "table": FRAMEWORK / "csa_docx/cli_create_table.py",
    "dry-run": FRAMEWORK / "csa_docx/tools/dry_run_all_sections.py",
}

EDIT_HEADING_RE = re.compile(r"^#{2,4}\s+(S\d+-[EA]\d+|E-\d+)\b", re.M)
STATUS_LINE_RE = re.compile(r"^\*\*Status:\*\*\s*(.*)$", re.M)
CHANGE_FILE_RE = re.compile(r"^ChangesCSA_.*?_Section(?P<section>\d+)(?:_(?P<label>[^.]+))?\.md$")
# A subsection is given as the number printed in the document, <section>.<n>[.<n>]
# (for example 3.3 PKI / Certificates).  It is deliberately *not* a stable-ID
# path: template heading ordinals include unnumbered headings and therefore the
# live structural ID for visible 3.3 may be @H4.4.  ``resolve_visible_section``
# below performs that translation from the live manifest.
# Its change file is the labelled file
# ChangesCSA_<App>_Section<section>_<label>.md with the dots written as dashes (6-4).
SUBSECTION_RE = re.compile(r"^(?:section\s*)?(?P<section>\d+)\.(?P<rest>\d+(?:\.\d+)*)$", re.I)
SUBSECTION_LABEL_RE = re.compile(r"^\d+(?:-\d+)+$")


def split_section(spec) -> tuple[str, str | None]:
    """'6.4' -> ('6', '6-4'); '6' -> ('6', None)."""
    m = SUBSECTION_RE.match(str(spec or "").strip())
    if not m:
        return str(spec), None
    return m["section"], f"{m['section']}-{m['rest'].replace('.', '-')}"


def label_display(section: str, label: str | None) -> str:
    """How a section or subsection is written in `csa` commands: 6 or 6.4."""
    return label.replace("-", ".") if label and SUBSECTION_LABEL_RE.match(label) else str(section)


TEMPLATE_BLOCKS = SKILLS / "csa-document-template" / "references" / "template-blocks.json"


def _template_visible_headings() -> dict[str, str]:
    """Visible template number -> heading text.

    Stable IDs are structural ordinals, not the numbers printed by Word.  The
    template block map is the authority for visible numbers; the live manifest
    is the authority for the corresponding structural path.
    """
    out = {
        "1": "Document Control",
        "2": "Executive Overview",
        "2.1": "Executive Summary",
        "3": "Requirement Domain Assessments",
        "4": "Governance Note and Next Steps",
        "5": "Migration Discovery",
        "6": "OT 3.5 Destination Boundary Reference Table",
        "7": "Glossary and Acronyms",
    }
    if not TEMPLATE_BLOCKS.is_file():
        return out
    data = json.loads(TEMPLATE_BLOCKS.read_text(encoding="utf-8"))
    for item in data.get("domains", []):
        if item.get("number") and item.get("heading"):
            out[str(item["number"])] = item["heading"]
    for key in ("governance", "coverage", "boundary_appendix", "glossary", "discovery_required"):
        item = data.get(key) or {}
        if item.get("number") and item.get("heading"):
            out[str(item["number"])] = item["heading"]
    for item in data.get("migration", []):
        if item.get("number") and item.get("heading"):
            out[str(item["number"])] = item["heading"]
    return out


def _live_manifest(p: dict) -> Path | None:
    root = local_path(p["project_root"])
    manifests = [x for x in root.rglob("run-state/stable-ids-*.json") if not _archived(x, root)]
    if not manifests:
        return None
    return max(manifests, key=lambda x: x.stat().st_mtime)


def _fw_env() -> dict:
    """Environment for framework subprocesses: the framework first on PYTHONPATH, anything already there kept."""
    return dict(os.environ, PYTHONPATH=os.pathsep.join(x for x in (str(FRAMEWORK), os.environ.get("PYTHONPATH", "")) if x))


def spec_mode(p: dict | None = None) -> str:
    """How sections are identified: off (numbers only), shadow (numbers decide, every difference with the document
    spec is logged to csa-work/spec/shadow.log), on (the document spec decides: keys and the numbers Word shows).
    Per project `spec_mode:` in PROJECTS.yaml wins over `spec_mode:` in cli.yaml; default shadow."""
    m = str((p or {}).get("spec_mode") or settings().get("spec_mode") or "shadow").split("#")[0].strip().lower()
    return m if m in ("off", "shadow", "on") else "shadow"


def shadow_log(p: dict, what: str, old, new, **ctx) -> None:
    try:
        log = local_path(p["work_dir"]) / "spec" / "shadow.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps({"time": time.strftime("%Y-%m-%d %H:%M:%S"), "what": what, "old": old, "new": new,
                                 **ctx}, default=str) + "\n")
    except (OSError, KeyError):
        pass


_RESOLVE_CACHE: dict[tuple, dict] = {}


def spec_resolve(p: dict, target: str) -> dict:
    """resolve_target, cached for the run."""
    k = (p["key"], str(target))
    if k not in _RESOLVE_CACHE:
        _RESOLVE_CACHE[k] = resolve_target(p, str(target))
    return _RESOLVE_CACHE[k]


def _resolve_visible_spec(p: dict, visible: str) -> dict | None:
    res = spec_resolve(p, visible)
    if res.get("status") != "OK":
        return None
    return {"visible": res["number"] or visible, "heading": res["title"], "stable_path": res["path"], "key": res["key"]}


def resolve_visible_section(p: dict, spec: str) -> dict:
    """A section the user named -> its heading and live stable path. The number path (template numbering) and the
    document-spec path (what Word shows, keys) both run in shadow mode; spec_mode decides which answer is used."""
    mode = spec_mode(p)
    if mode == "off":
        return _resolve_visible_by_number(p, spec)
    try:
        old = _resolve_visible_by_number(p, spec)
    except SystemExit:
        old = {"visible": str(spec), "heading": None, "stable_path": None, "error": "SECTION_MAPPING_ERROR"}
        if mode != "on":
            raise
    new = _resolve_visible_spec(p, spec) if working_docx(p) else None
    if mode == "on":
        if new is None:
            die(f"SECTION_MAPPING_ERROR: the document has no section {spec}; `csa spec` lists the sections")
        return new
    if new is not None and (old.get("stable_path") != new["stable_path"]):
        shadow_log(p, "resolve", {k: old.get(k) for k in ("heading", "stable_path")},
                   {k: new.get(k) for k in ("heading", "stable_path", "key")}, target=str(spec))
    return old


def _resolve_visible_by_number(p: dict, spec: str) -> dict:
    """Resolve a user-visible section number against the live manifest (template numbering).

    Returns both identities; callers must retain the visible number for change
    files/edit IDs and use ``stable_path`` only to scope document content.
    """
    visible = str(spec or "").strip()
    heading = _template_visible_headings().get(visible)
    if not heading:
        return {"visible": visible, "heading": None, "stable_path": None}
    manifest = _live_manifest(p)
    if manifest is None:
        return {"visible": visible, "heading": heading, "stable_path": None}
    data = json.loads(manifest.read_text(encoding="utf-8"))
    norm = lambda s: re.sub(r"\s+", " ", str(s or "").replace("“", '"').replace("”", '"')).strip().casefold()
    matches = [e for e in data.get("entries", [])
               if e.get("kind") == "heading" and norm(e.get("text")) == norm(heading)]
    if len(matches) != 1:
        die(f"SECTION_MAPPING_ERROR: visible {visible} ({heading}) resolved to {len(matches)} live headings; "
            f"run `csa lookup {shlex.quote(heading)}` and refresh the manifest")
    return {"visible": visible, "heading": heading,
            "stable_path": str(matches[0]["section_path"]), "manifest": str(manifest)}

RECORD_HEADING_RE = re.compile(r"^#{2,4}\s+(S\d+-[EA]\d+|E-\d+)\b.*$", re.M)
NEXT_HEADING_RE = re.compile(r"^#{1,3}\s", re.M)


def edit_record_hashes(text: str) -> dict[str, str]:
    """SHA-256 of each edit record: its heading line up to the next heading of level 1-3.
    The Status line and appended reports sit outside every record, so they never change a hash."""
    out: dict[str, str] = {}
    for m in RECORD_HEADING_RE.finditer(text):
        nxt = NEXT_HEADING_RE.search(text, m.end())
        body = text[m.start(): nxt.start() if nxt else len(text)]
        lines = [line.rstrip() for line in body.strip().splitlines()]
        while lines and lines[-1] in ("", "---"):
            lines.pop()
        out[m[1]] = hashlib.sha256("\n".join(lines).encode("utf-8")).hexdigest()
    return out


def approval_file(cf: Path) -> Path:
    """The per-change-file approval record holding its per-edit hashes."""
    return cf.parent / (cf.stem + ".approval.json")


def approval_problems(cf: Path) -> list[str]:
    """Why an approved change file no longer matches what was approved ([] = fine)."""
    af = approval_file(cf)
    if not af.is_file():
        return ["no approval record (.approval.json); it was approved before hashes were recorded"]
    approved = json.loads(af.read_text(encoding="utf-8")).get("hashes", {})
    current = edit_record_hashes(cf.read_text(encoding="utf-8"))
    changed = [k for k in approved if k in current and current[k] != approved[k]]
    added = [k for k in current if k not in approved]
    out = []
    if changed:
        out.append("edits changed since approval: " + ", ".join(changed))
    if added:
        out.append("edits added since approval: " + ", ".join(added))
    return out


def record_approval(p: dict, cf: Path, section, who: str, source: str) -> list[str]:
    """Record what is about to be applied: set the Status line and write the .approval.json with
    per-edit hashes. There is no human step between writing a change and applying it; Wenzel
    approves the applied changes in Word (accept / reject), then `csa review` and `csa cleanup`.
    Edits marked REJECTED (``csa approve N --reject``) stay out. Returns the recorded edit IDs."""
    text = cf.read_text(encoding="utf-8")
    m = STATUS_LINE_RE.search(text)
    if not m:
        die(f"no '**Status:**' line in {cf.name}; add one (the framework records the approval there).")
    edits = list(dict.fromkeys(EDIT_HEADING_RE.findall(text)))
    if not edits:
        die(f"{cf.name} has no edits to apply.")
    rejected = re.findall(r"^#{2,4}\s+REJECTED\s+(S\d+-[EA]\d+)\b", text, re.M)
    new = (f"**Status:** Approved for implementation {datetime.now():%Y-%m-%d %H:%M} by {who}. Edits: {', '.join(edits)}."
           + (f" Rejected: {', '.join(rejected)}." if rejected else ""))
    cf.write_text(text[:m.start()] + new + text[m.end():], encoding="utf-8")
    approval_file(cf).write_text(json.dumps({"approved_at": datetime.now().isoformat(timespec="seconds"), "by": who,
                                             "rejected": rejected,
                                             "hashes": edit_record_hashes(cf.read_text(encoding="utf-8"))},
                                            indent=2) + "\n", encoding="utf-8")
    metric(p, "approve", section, approved=edits, rejected=rejected, source=source)
    return edits


def metric(p: dict, event: str, section=None, **data) -> None:
    """Append one event to <work_dir>/metrics.jsonl. Never fails the command."""
    try:
        wd = local_path(p["work_dir"])
        wd.mkdir(parents=True, exist_ok=True)
        rec = {"ts": datetime.now().isoformat(timespec="seconds"), "project": p["key"], "event": event,
               "section": None if section is None else str(section), **data}
        with open(wd / "metrics.jsonl", "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec) + "\n")
    except OSError:
        pass

C = {"b": "\033[1m", "d": "\033[2m", "r": "\033[31m", "g": "\033[32m", "y": "\033[33m", "c": "\033[36m", "0": "\033[0m"}
if not (sys.stdout.isatty() and sys.stderr.isatty()) or os.environ.get("NO_COLOR"):
    C = {k: "" for k in C}


def die(msg: str, code: int = 1):
    print(f"{C['r']}csa: {msg}{C['0']}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- flat YAML
def _unquote(v: str) -> str:
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        return v[1:-1]
    return v


def parse_flat_list(path: Path, first_key: str) -> list[dict]:
    """Parse the fixed-shape list files (PROJECTS.yaml, registry.yaml) without PyYAML."""
    items, cur = [], None
    for raw in path.read_text(encoding="utf-8").splitlines():
        s = raw.strip()
        if not s or s.startswith("#") or raw[:1] not in (" ", "\t"):
            continue
        if s.startswith(f"- {first_key}:"):
            cur = {}
            items.append(cur)
            s = s[2:]
        if cur is None or ":" not in s:
            continue
        k, _, v = s.partition(":")
        cur[k.strip()] = _unquote(v)
    return items


def parse_flat_map(path: Path) -> dict:
    out = {}
    if path.is_file():
        for raw in path.read_text(encoding="utf-8").splitlines():
            s = raw.strip()
            if s and not s.startswith("#") and ":" in s:
                k, _, v = s.partition(":")
                out[k.strip()] = _unquote(v)
    return out


def local_path(p: str) -> Path:
    """Registry paths are absolute Mac paths. If this checkout lives elsewhere
    (e.g. another machine or a VM mount), map the registered root onto ROOT."""
    path = Path(p).expanduser()
    if not path.exists() and p.startswith(REGISTERED_ROOT) and str(ROOT) != REGISTERED_ROOT:
        return ROOT / p[len(REGISTERED_ROOT):].lstrip("/")
    return path


# ---------------------------------------------------------------- config
def settings() -> dict:
    return parse_flat_map(CLI_FILE)


def framework_python() -> str:
    if os.environ.get("CSA_PYTHON"):                       # explicit choice: trusted as-is
        exe = shutil.which(os.environ["CSA_PYTHON"]) or os.environ["CSA_PYTHON"]
        return exe
    cands = settings().get("python", "python3")
    venv = AGENTS_DIR / ".venv" / "bin" / "python"          # the framework's own environment (has pytest) comes first
    for c in [str(venv)] + [x.strip() for x in cands.split(",") if x.strip()]:
        exe = c if os.path.isabs(c) and os.path.exists(c) else shutil.which(c)
        if not exe:
            continue
        try:
            out = subprocess.run([exe, "-c", "import sys;print(sys.version_info>=(3,11))"],
                                 capture_output=True, text=True, timeout=20).stdout.strip()
        except Exception:
            continue
        if out == "True":
            return exe
    die("no Python >= 3.11 found for the framework. Set CSA_PYTHON or 'python:' in .agents/cli.yaml.")


def projects() -> list[dict]:
    if not PROJECTS_FILE.is_file():
        die(f"missing {PROJECTS_FILE}")
    return parse_flat_list(PROJECTS_FILE, "key")


def registry() -> list[dict]:
    if not REGISTRY_FILE.is_file():
        die(f"missing {REGISTRY_FILE}")
    return parse_flat_list(REGISTRY_FILE, "verb")


def active_key(explicit: str | None = None) -> str | None:
    if explicit:
        return explicit
    if os.environ.get("CSA_PROJECT"):
        return os.environ["CSA_PROJECT"]
    f = STATE_DIR / "active-project"
    try:
        return f.read_text(encoding="utf-8").strip() or None
    except OSError:
        return None


def project(explicit: str | None = None, required: bool = True) -> dict | None:
    key = active_key(explicit)
    if not key:
        if not required:
            return None
        keys = ", ".join(p["key"] for p in projects())
        die(f"no active project. Run `csa use <key>` ({keys}) or pass --project.")
    for p in projects():
        if key.lower() in (p["key"].lower(), p.get("label", "").lower()):
            os.environ["CSA_SPEC_MODE"] = spec_mode(p)          # the framework (build_plan) reads it
            os.environ["CSA_WORK_DIR"] = str(local_path(p["work_dir"]))
            return p
    die(f"unknown project '{key}'. Registered: {', '.join(p['key'] for p in projects())}")


def banner(p: dict):
    print(f"{C['c']}[{p.get('label', p['key'])}]{C['0']}", file=sys.stderr)


# ---------------------------------------------------------------- framework bridge
def fw_call(func: str, *args, **kwargs) -> dict:
    """Call csa_docx.tools.<func> in the framework interpreter and return its JSON."""
    code = (
        "import sys,json;sys.path.insert(0,sys.argv[1]);from csa_docx import tools;"
        "a=json.loads(sys.argv[3]);r=getattr(tools,sys.argv[2])(*a['args'],**a['kwargs']);"
        "print(json.dumps(r,default=str))"
    )
    proc = subprocess.run([framework_python(), "-c", code, str(FRAMEWORK), func,
                           json.dumps({"args": list(args), "kwargs": kwargs})],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return {"status": "ERROR", "message": (proc.stderr or proc.stdout).strip()[-2000:]}
    try:
        return json.loads(proc.stdout.strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        return {"status": "ERROR", "message": proc.stdout[-2000:]}


def run_script(name: str, argv: list[str], cwd: Path | None = None) -> int:
    script = SCRIPTS[name]
    if not script.is_file():
        die(f"script not found: {script}")
    return subprocess.call([framework_python(), str(script), *argv], cwd=str(cwd) if cwd else None)


# ---------------------------------------------------------------- section state (read-only, from files)
def _archived(path: Path, root: Path) -> bool:
    try:
        parts = path.relative_to(root).parts[:-1]
    except ValueError:
        parts = path.parts[:-1]
    return any("archive" in x.lower() or x.lower().lstrip().startswith("old") or x == "_to_delete"
               or x.lower().startswith("backup") for x in parts)


def all_change_files(p: dict) -> dict[str, list[Path]]:
    """Every change file per section, the unlabelled ChangesCSA_<App>_Section<N>.md first."""
    root = local_path(p["project_root"])
    found: dict[str, list[Path]] = {}
    for f in sorted(root.rglob("reviews/*.md")):
        m = CHANGE_FILE_RE.match(f.name)
        if m and not _archived(f, root):
            found.setdefault(str(int(m["section"])), []).append(f)
    for files in found.values():
        files.sort(key=lambda f: (CHANGE_FILE_RE.match(f.name)["label"] is not None, f.name))
    return found


def change_files(p: dict) -> dict[str, Path]:
    return {s: files[0] for s, files in all_change_files(p).items()}


def final_version_dirs(p: dict) -> list[Path]:
    return sorted({f.parent.parent for f in change_files(p).values()})


def working_docx(p: dict) -> Path | None:
    for d in final_version_dirs(p):
        docs = sorted(x for x in d.glob("*.docx") if not x.name.startswith("~$"))
        if docs:
            docs.sort(key=lambda x: (int(m[1]) if (m := re.search(r"v(\d+)", x.name, re.I)) else -1, x.name), reverse=True)
            return docs[0]
    return None


def legacy_docx(p: dict) -> Path | None:
    v = p.get("legacy_docx")
    return local_path(v) if v else None


def _kv_file(path: Path) -> dict:
    out = {}
    if path.is_file():
        for line in path.read_text(encoding="utf-8").splitlines():
            if line.startswith("- ") and ":" in line:
                k, _, v = line[2:].partition(":")
                out[k.strip()] = v.strip()
    return out


def _block(text: str, heading: str) -> str:
    m = re.search(rf"^#{{1,3}}\s+(?:CSA\s+)?{re.escape(heading)}\s*$", text, re.M | re.I)
    if not m:
        return ""
    nxt = re.search(r"^## ", text[m.end():], re.M)
    return text[m.end(): m.end() + nxt.start()] if nxt else text[m.end():]


SECTION_KEY_RE = re.compile(r"^\*\*Section key:\*\*\s*(\S+)", re.M)


def change_file_key(cf: Path) -> str | None:
    """The section key a change file records (`**Section key:** TIME`), or None for an unmigrated file."""
    try:
        m = SECTION_KEY_RE.search(Path(cf).read_text(encoding="utf-8", errors="ignore")[:4000])
    except OSError:
        return None
    return m.group(1) if m else None


def change_file_by_key(p: dict, key: str) -> Path | None:
    for files in all_change_files(p).values():
        for f in files:
            if change_file_key(f) == key:
                return f
    return None


def pick_change_file(p: dict, section: str, file: str | None) -> Path | None:
    """The section's main change file, or with ``file`` the labelled one whose name or label matches.
    With spec_mode on, a subsection is found by the key its change file records, so a renumbered section keeps
    its change file; shadow mode logs where the two answers differ."""
    if file and SUBSECTION_LABEL_RE.match(file) and spec_mode(p) != "off" and working_docx(p):
        res = spec_resolve(p, label_display(str(int(section)), file))
        by_key = change_file_by_key(p, res["key"]) if res.get("status") == "OK" else None
        by_name = _pick_change_file_by_name(p, section, file, quiet=True)
        if by_name is not None and change_file_key(by_name) not in (None, res.get("key")):
            by_name_key = change_file_key(by_name)
        else:
            by_name_key = None
        if spec_mode(p) == "on" and res.get("status") == "OK":
            return by_key if by_key else (None if by_name_key else by_name)
        if (by_key and by_name and by_key != by_name) or by_name_key:
            shadow_log(p, "change_file", str(by_name.name) if by_name else None, str(by_key.name) if by_key else None,
                       target=label_display(str(int(section)), file), key=res.get("key"))
    return _pick_change_file_by_name(p, section, file)


def _pick_change_file_by_name(p: dict, section: str, file: str | None, quiet: bool = False) -> Path | None:
    files = all_change_files(p).get(str(int(section)), [])
    if not file:
        return files[0] if files else None
    for f in files:
        m = CHANGE_FILE_RE.match(f.name)
        if file in (f.name, f.stem, m["label"] or ""):
            return f
    if SUBSECTION_LABEL_RE.match(file) or quiet:
        return None          # a subsection that has not been authored yet
    die(f"section {section} has no change file matching {file!r}: {', '.join(f.name for f in files) or 'none'}")


def section_state(p: dict, section: str, file: str | None = None) -> dict:
    section = str(int(section))
    cf = pick_change_file(p, section, file)
    st = {"section": section, "title": "", "change_file": str(cf) if cf else None,
          "authored": bool(cf), "edits": [], "approved": False, "status_line": None,
          "apply_status": "NOT_STARTED", "completed": [], "blocked": [], "next_edit": None,
          "review_result": None, "signoff": None, "cleaned": False}
    label = CHANGE_FILE_RE.match(cf.name)["label"] if cf else (file if file and SUBSECTION_LABEL_RE.match(file) else None)
    n = label_display(section, label)
    st["subsection"] = n if n != section else None
    st["other_change_files"] = [str(x) for x in all_change_files(p).get(section, []) if not cf or x != cf]
    if not cf:
        st["stage"], st["next"] = "not authored", f"csa author {n}"
        return st
    text = cf.read_text(encoding="utf-8")
    m = re.search(r"^\*\*Section:\*\*[ \t]*\d+[ \t]*(?:[-\u2013][ \t]*)?(.*)$", text, re.M)
    st["title"] = re.sub(r"\s*\(.*$", "", m[1]).strip() if m else ""
    sub = re.search(r"\(subsection\s+[\d.]+\s+([^,)]+)", m[1]) if m else None
    if label and sub:
        st["title"] = sub.group(1).strip()          # a subsection's change file: its own heading, not the section's
    if not st["title"] and spec_mode(p) != "off" and working_docx(p):
        res = spec_resolve(p, n)
        st["title"] = res.get("title", "") if res.get("status") == "OK" else ""
    st["edits"] = list(dict.fromkeys(EDIT_HEADING_RE.findall(text)))
    m = STATUS_LINE_RE.search(text)
    st["status_line"] = m[1].strip() if m else None
    st["approved"] = bool(m and m[1].strip().lower().startswith("approved"))
    key = f"{section}_{label}" if label else section
    rs = _kv_file(cf.parent.parent / "run-state" / f"current-state-assessment-document-section-{key}.md")
    if rs:
        st["apply_status"] = rs.get("Status", "UNKNOWN")
        split = lambda v: [x.strip() for x in (v or "").split(",") if x.strip() and x.strip() != "None"]
        st["completed"], st["blocked"] = split(rs.get("Completed edit IDs")), split(rs.get("Blocked edit IDs"))
        st["next_edit"] = None if rs.get("Next edit ID") in (None, "None") else rs.get("Next edit ID")
    rev = _block(text, "Change Review Report")
    if rev:
        m = re.search(r"Review result:\s*\**\s*([A-Z][A-Z ]+?)\s*(?:\*|$)", rev, re.M)
        st["review_result"] = m[1].strip() if m else "PRESENT"
        m = re.search(r"Sign-off for cleanup:\s*\**\s*(YES|NO|NOT APPLICABLE)", rev, re.I)
        st["signoff"] = m[1].upper() if m else None
    cl = _block(text, "Cleanup Report")
    m = re.search(r"Cleanup result:\s*\**\s*([A-Z][A-Z ]+?)\s*(?:\*|$)", cl, re.M)
    st["cleaned"] = bool(cl) and not (m and m[1].strip() in ("STOPPED", "FAILED", "BLOCKED"))

    if not st["edits"]:
        st["stage"], st["next"] = "authored, no edits (clean)", None
    elif not st["approved"] and st["apply_status"] == "NOT_STARTED":
        st["stage"], st["next"] = "authored, not applied", f"csa apply {n} --until-done"
    elif st["apply_status"] == "BLOCKED":
        st["stage"], st["next"] = f"apply BLOCKED ({', '.join(st['blocked']) or '?'})", f"csa apply {n} --agent"
    elif st["apply_status"] != "SECTION_COMPLETE":
        st["stage"], st["next"] = f"applying ({len(st['completed'])}/{len(st['edits'])})", f"csa apply {n} --until-done"
    elif not st["review_result"]:
        st["stage"], st["next"] = "applied, not reviewed", f"csa review {n}"
    elif st["review_result"] in ("FAIL", "BLOCKED"):
        st["stage"], st["next"] = f"review {st['review_result']}", f"read the Change Review Report, then csa apply {n} --agent"
    elif st["cleaned"]:
        st["stage"], st["next"] = "done", None
    elif st["signoff"] == "YES":
        st["stage"], st["next"] = f"reviewed {st['review_result']}, signed off", f"csa cleanup {n}"
    else:
        st["stage"], st["next"] = f"reviewed {st['review_result']}, no cleanup sign-off", f"csa review {n}"
    return st


def all_states(p: dict) -> list[dict]:
    # Only sections with a change file are listed. The stable-ID manifest's heading
    # numbering (@H<n>) counts empty Heading 1s and does not match SECTION numbers.
    out = []
    for s, files in sorted(all_change_files(p).items(), key=lambda kv: int(kv[0])):
        main = section_state(p, s)
        subs = [f for f in files if (m := CHANGE_FILE_RE.match(f.name))["label"] and SUBSECTION_LABEL_RE.match(m["label"])]
        main["other_change_files"] = [x for x in main["other_change_files"] if Path(x) not in subs]
        if main["change_file"] and Path(main["change_file"]) not in subs:
            out.append(main)
        out += [section_state(p, s, CHANGE_FILE_RE.match(f.name)["label"]) for f in subs]
    return out


