    (STATE_DIR / "active-project").write_text(p["key"] + "\n", encoding="utf-8")
    print(f"Active project: {p.get('label')} ({p['key']})\n  root: {p['project_root']}")


def cmd_agents(a):
    for g in ("pipeline", "analysis"):
        print(f"{C['b']}{g}{C['0']}")
        for r in registry():
            if r.get("group") == g:
                step = f"{r['step']}." if r.get("step") else "  "
                print(f"  {step:<3}{r['verb']:<9} {r.get('summary','')}")
                print(f"       {C['d']}{r['file']}  inputs: {r.get('inputs','')}{C['0']}")


# ---------------------------------------------------------------- commands: status
def cmd_status(a):
    p = project(a.project)
    if a.section:
        st = section_state(p, a.section, getattr(a, "file", None))
        if a.json:
            return print(json.dumps(st, indent=2))
        banner(p)
        for k in ("section", "title", "stage", "change_file", "status_line", "apply_status"):
            print(f"{k:>13}: {st.get(k)}")
        print(f"{'other files':>13}: {', '.join(Path(x).name for x in st['other_change_files']) or '-'}")
        print(f"{'edits':>13}: {len(st['edits'])}  {', '.join(st['edits'])}")
        print(f"{'completed':>13}: {', '.join(st['completed']) or '-'}")
        print(f"{'blocked':>13}: {', '.join(st['blocked']) or '-'}")
        print(f"{'review':>13}: {st['review_result'] or '-'}   sign-off: {st['signoff'] or '-'}   cleaned: {st['cleaned']}")
        print(f"{'next':>13}: {C['g']}{st['next'] or 'nothing'}{C['0']}")
        return
    states = all_states(p)
    if a.json:
        return print(json.dumps(states, indent=2))
    banner(p)
    if not states:
        print("No change files yet. Start a section with `csa author <N>`.")
    print(f"{C['b']}{'Sec':>3}  {'Title':<34} {'Edits':>5}  {'Stage':<40} Next{C['0']}")
    for s in states:
        colour = C["g"] if s["stage"] in ("done", "authored, no edits (clean)") else C["r"] if "BLOCK" in s["stage"] or "FAIL" in s["stage"] else C["y"]
        print(f"{(s.get('subsection') or s['section']):>3}  {s['title'][:34]:<34} {len(s['edits']):>5}  {colour}{s['stage'][:40]:<40}{C['0']} {C['d']}{s['next'] or ''}{C['0']}")
        if s.get("other_change_files"):
            print(f"     {C['d']}+ {len(s['other_change_files'])} other change file(s): "
                  f"{', '.join(Path(x).name for x in s['other_change_files'])}{C['0']}")
    print(f"{C['d']}Only sections with a change file are listed; `csa author <N>` starts another.{C['0']}")


def cmd_report(a):
    p = project(a.project)
    mf = local_path(p["work_dir"]) / "metrics.jsonl"
    if not mf.is_file():
        return print("No metrics yet (csa-work/metrics.jsonl).")
    secs = {}
    for line in mf.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        e = json.loads(line); s = str(e.get("section"))
        d = secs.setdefault(s, {"section": s, "approvals": 0, "edits_approved": 0, "edits_rejected": 0,
                                "apply_batches": 0, "blocked_batches": 0, "last_review": "-"})
        if e["event"] == "approve":
            d["approvals"] += 1; d["edits_approved"] = len(e.get("approved") or []); d["edits_rejected"] = len(e.get("rejected") or [])
        elif e["event"] == "apply":
            d["apply_batches"] += 1; d["blocked_batches"] += e.get("status") == "BLOCKED"
        elif e["event"] == "review":
            d["last_review"] = e.get("result") or "-"
    rows = sorted(secs.values(), key=lambda d: (not d["section"].isdigit(), int(d["section"]) if d["section"].isdigit() else 0))
    def acc(d):
        t = d["edits_approved"] + d["edits_rejected"]
        return f"{round(100 * d['edits_approved'] / t)}%" if t else "-"
    total = {k: sum(d[k] for d in rows) for k in ("approvals", "edits_approved", "edits_rejected", "apply_batches", "blocked_batches")}
    if a.json:
        return print(json.dumps({"sections": [dict(d, acceptance=acc(d)) for d in rows], "total": dict(total, acceptance=acc(total))}, indent=2))
    banner(p)
    print("Sec  Approvals  Approved  Rejected  Acceptance  Batches  Blocked  Last review")
    for d in rows + [dict(total, section="all", last_review="")]:
        print(f"{d['section']:>3}  {d['approvals']:>9}  {d['edits_approved']:>8}  {d['edits_rejected']:>8}  {acc(d):>10}  {d['apply_batches']:>7}  {d['blocked_batches']:>7}  {d['last_review']}")


def cmd_next(a):
    p = project(a.project)
    states = all_states(p)
    order = lambda s: (0 if "BLOCK" in s["stage"] or "FAIL" in s["stage"] else 1 if s["stage"].startswith("applying") else
                       2 if s["stage"] == "authored, not applied" else 3 if s["next"] and "review" in s["next"] else
                       4 if s["next"] and "cleanup" in s["next"] else 5, int(s["section"]))
    todo = sorted([s for s in states if s["next"]], key=order)
    if a.json:
        return print(json.dumps([{"section": s["section"], "stage": s["stage"], "next": s["next"]} for s in todo], indent=2))
    banner(p)
    if not todo:
        return print("Nothing pending. Every known section is done or clean.")
    s = todo[0]
    print(f"Section {s['section']} {s['title']} - {s['stage']}\n  -> {C['g']}{s['next']}{C['0']}")
    if len(todo) > 1:
        print(f"{C['d']}then: " + "; ".join(f"S{t['section']}: {t['next']}" for t in todo[1:6]) + C["0"])


# ---------------------------------------------------------------- commands: framework
def _ws(p: dict) -> str:
    return str(local_path(p["project_root"]))   # mapped when the checkout is mounted elsewhere (VM)


def _emit(res: dict, a) -> int:
    if getattr(a, "json", False):
        print(json.dumps(res, indent=2))
    else:
        status = res.get("status", "?")
        colour = C["g"] if status in ("OK", "READY", "SECTION_COMPLETE", "PARTIAL_COMPLETE") else C["r"]
        print(f"{colour}{status}{C['0']}")
        for k, v in res.items():
            if k != "status":
                print(f"  {k}: {json.dumps(v, default=str) if isinstance(v, (dict, list)) else v}")
    return 0 if res.get("status") not in ("ERROR", "NOT_READY", "BLOCKED") else 2


def cmd_prepare(a):
    p = project(a.project); banner(p)
    kw = {"workspace": _ws(p), "force_regenerate": a.force}
    if a.section:
        kw["section"] = a.section
    res = fw_call("prepareDocument", **kw)
    proj = (res.get("project") or {}).get("key")
    if proj and proj != p["key"]:
        res = {"status": "ERROR", "message": f"prepareDocument resolved project '{proj}', expected '{p['key']}'. Stopping."}
    return _emit(res, a)


def cmd_lookup(a):
    p = project(a.project); banner(p)
    kw = {"workspace": _ws(p)}
    if a.kind:
        kw["kind"] = a.kind
    return _emit(fw_call("lookupStableId", a.query, **kw), a)


def cmd_validate(a):
    p = project(a.project); banner(p)
    return _emit(fw_call("validate_section", str(a.section), workspace=_ws(p)), a)


def cmd_refresh(a):
    p = project(a.project); banner(p)
    return _emit(fw_call("refresh_manifest", workspace=_ws(p)), a)


def run_check_change(p: dict, cf: Path, a) -> int:
    argv = [framework_python(), "-m", "csa_docx.check_change", str(cf), "--workspace", str(local_path(p["project_root"]))]
    if p.get("work_dir"):
        argv += ["--evidence", str(local_path(p["work_dir"]) / "evidence-matrix.csv")]
    if p.get("sites"):
        argv += ["--sites", p["sites"]]
    for flag, name in (("--no-anchors", "no_anchors"), ("--no-lint", "no_lint"), ("--json", "json")):
        if getattr(a, name, False):
            argv.append(flag)
    return subprocess.call(argv, cwd=str(FRAMEWORK))


def _audit_dirs(p: dict) -> list[Path]:
    root = local_path(p["work_dir"]) / "audit"
    return sorted((d for d in root.glob("2*") if (d / "audit.json").is_file()), key=lambda d: d.name) if root.is_dir() else []


def cmd_audit(a):
    """csa audit            scripted checks on the working DOCX -> WORK_DIR/audit/<id>/
    csa audit --status   units and which have an agent audit
    csa audit --report   assemble the Word report for the latest (or --id) audit"""
    p = project(a.project); banner(p)
    env = dict(os.environ, PYTHONPATH=os.pathsep.join([str(FRAMEWORK), str(FRAMEWORK / "vendor"), os.environ.get("PYTHONPATH", "")]))
    if a.report or a.status:
        dirs = _audit_dirs(p)
        d = next((x for x in dirs if x.name == a.id), None) if a.id else (dirs[-1] if dirs else None)
        if not d:
            die("no audit found; run `csa audit` first")
        if a.status:
            j = json.loads((d / "audit.json").read_text(encoding="utf-8"))
            done = {f.stem for f in (d / "sections").glob("*.md")}
            print(f"Audit {d.name}: {len(j['units'])} units, {len(done)} audited in depth")
            for u in j["units"]:
                print(f"  [{'x' if u['slug'] in done else ' '}] {u['title']}")
            nxt = next((u for u in j["units"] if u["slug"] not in done), None)
            if nxt:
                print(f"Next: csa audit-section SECTION={nxt['slug']}")
            return 0
        return subprocess.call([framework_python(), "-m", "csa_docx.audit_report", str(d)], cwd=str(FRAMEWORK), env=env)
    docx = working_docx(p)
    if not docx:
        res = fw_call("prepareDocument", workspace=_ws(p))
        docx = Path(res["docx"]) if res.get("docx") else None
    if not docx:
        die("no working DOCX found")
    rc = subprocess.call([framework_python(), "-m", "csa_docx.audit", str(docx), "--work-dir", str(local_path(p["work_dir"])),
                          "--label", p.get("label", p["key"])], cwd=str(FRAMEWORK), env=env)
    if rc == 0:
        print("Next: csa audit --status, then `csa audit-section SECTION=next` per unit, then `csa audit --report`.")
    metric(p, "audit", None, exit=rc)
    return rc


