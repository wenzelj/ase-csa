def cmd_browse(a):
    """Run the loopback-only CSA Evidence Workspace."""
    p = project(a.project); banner(p)
    app_dir = AGENTS_DIR / "evidence-browser"
    dist = app_dir / "frontend" / "dist"
    if not (app_dir / "pyproject.toml").is_file():
        die(f"evidence workspace is not installed at {app_dir}")
    if not dist.is_dir():
        die(f"evidence workspace frontend is not built; run `npm install && npm run build` in {app_dir / 'frontend'}")
    aliases = {"iamps-08": "iamps", "iamps": "iamps", "utcdtc": "utcdtc",
               "tetra-reveloc": "tetra", "tetra": "tetra"}
    selected = aliases.get(p["key"])
    if not selected:
        die(f"project {p['key']!r} is not exposed in the evidence workspace")
    command = [sys.executable, "-m", "backend.server",
               "--project", selected, "--port", str(a.port), "--agents-dir", str(AGENTS_DIR)]
    if a.no_open:
        command.append("--no-open")
    try:
        return subprocess.call(command, cwd=app_dir)
    except KeyboardInterrupt:
        return 130


def cmd_graph(a):
    p = project(a.project); banner(p)
    return run_script("graph", ["--workspace", _ws(p), *a.rest])


def _docx_or_die(p) -> str:
    d = working_docx(p)
    if not d:
        die("no working DOCX found (no reviews/ChangesCSA_*.md yet). Pass a path explicitly.")
    return str(d)


def cmd_lint(a):
    p = project(a.project); banner(p)
    target = a.path or _docx_or_die(p)
    argv = [target]
    if a.section:
        argv += ["--section", str(a.section)]
    if a.heading:
        argv += ["--heading", a.heading]
    return run_script("lint", argv + a.rest)


def cmd_check(a):
    p = project(a.project); banner(p)
    return run_script("check", [a.docx or _docx_or_die(p), "--workspace", str(ROOT)] + (["--final"] if a.final else []) + a.rest)


def cmd_passthrough(name):
    def f(a):
        p = project(getattr(a, "project", None), required=False)
        if p:
            banner(p)
        argv = list(a.rest)
        if name in ("new",) and "--workspace" not in argv:
            argv += ["--workspace", str(ROOT)]
        return run_script(name, argv, cwd=local_path(p["project_root"]) if p else None)
    return f


def cmd_test(a):
    py = framework_python()
    if subprocess.run([py, "-c", "import pytest"], capture_output=True).returncode != 0:
        die(f"pytest is not installed for {py}. Set it up once:\n"
            f"  python3 -m venv \"{AGENTS_DIR / '.venv'}\" && \"{AGENTS_DIR / '.venv' / 'bin' / 'pip'}\" install pytest\n"
            "then run `csa test` again (csa uses .agents/.venv automatically).")
    return subprocess.call([py, "-m", "pytest", "-q", "-p", "no:cacheprovider", str(FRAMEWORK / "csa_docx/tests"), *a.rest],
                           cwd=str(FRAMEWORK))


def cmd_mcp(a):
    p = project(a.project, required=False)
    exe = CANON_AGENTS / "framework/csa_docx/bin/csa-mcp"
    ws = p["project_root"] if p else "<project_root>"
    py = framework_python()
    print(f"# Codex: ~/.codex/config.toml\n[mcp_servers.csa]\ncommand = \"{py}\"\nargs = [\"{exe}\"]\nenv = {{ CSA_MCP_WORKSPACE = \"{ws}\" }}\n")
    print("# Claude Code (project scope): run from the CurrentStateAssessments folder")
    print(f"claude mcp add csa --scope project -e CSA_MCP_WORKSPACE={shlex.quote(ws)} -- {shlex.quote(py)} {shlex.quote(str(exe))}")


# ---------------------------------------------------------------- doctor
SCOPE_MAP = AGENTS_DIR / "skills" / "csa-quality-review" / "references" / "section-scope.md"


def scope_entry(key: str) -> str | None:
    """One entry of the section scope map: a ### domain block, or the Migration Discovery row of part 3."""
    lines = SCOPE_MAP.read_text(encoding="utf-8").splitlines()
    k = key.strip().lower()
    heads = [i for i, l in enumerate(lines) if l.startswith("### ")]
    pick = [i for i in heads if lines[i][4:].split(" ", 1)[0].lower() == k]
    if not pick and not re.fullmatch(r"[\d.]+", k):
        pick = [i for i in heads if k in lines[i][4:].lower()]
    if pick:
        i = pick[0]
        j = next((n for n in range(i + 1, len(lines)) if lines[n].startswith(("### ", "## "))), len(lines))
        return "\n".join(lines[i:j]).rstrip() + "\n"
    try:
        part3 = next(i for i, l in enumerate(lines) if l.startswith("## 3."))
    except StopIteration:
        return None
    end = next((n for n in range(part3 + 1, len(lines)) if lines[n].startswith("## ")), len(lines))
    table = [l for l in lines[part3:end] if l.startswith("|")]
    rows = [l for l in table[2:] if "migration discovery" in l.split("|")[1].lower()]
    mig = re.fullmatch(r"[45](\.\d+)?", k) or "migration" in k or any(k in r.lower() for r in rows)
    if rows and mig and len(table) >= 2:
        return "\n".join(table[:2] + rows) + "\n"
    return None


def cmd_scope(a):
    """Print one domain's entry from the section scope map. No project needed."""
    text = scope_entry(a.key)
    if text is None:
        keys = [l[4:].split(" ", 1)[0] for l in SCOPE_MAP.read_text(encoding="utf-8").splitlines()
                if l.startswith("### ") and re.match(r"### \d", l)]
        print(f"no scope entry for '{a.key}'. Valid keys: {', '.join(keys)}, a domain name, "
              f"or a Migration Discovery number/topic (5.x, 4.x, 'patch and update', 'group policy').", file=sys.stderr)
        return 1
    if a.json:
        print(json.dumps({"status": "OK", "key": a.key, "entry": text}))
    else:
        print(text, end="")
    return 0


def cmd_brief(a):
    """The section brief skeleton for an author run: requirements and questions from the scope map, reviewer comments
    from the working document. Written to csa-work/author/<section>/brief.md and printed."""
    p = project(a.project); banner(p)
    docx = working_docx(p)
    num = section_arg(p, a.section)
    sec, label = split_section(num)
    out = author_dir(p, sec, label) / "brief.md"
    argv = [framework_python(), "-m", "csa_docx.author_brief", num, "--out", str(out)]
    if docx:
        argv += ["--docx", str(docx)]
    rc = subprocess.run(argv, cwd=str(FRAMEWORK), env=_fw_env()).returncode
    if rc == 0:
        print(f"{C['d']}written to {out}{C['0']}", file=sys.stderr)
    return rc


def cmd_spec(a):
    """csa spec status | show <target> | resolve <target> | lint | stamp [--confirm] [--dry-run] | propose"""
    p = project(a.project); banner(p)
    if not a.rest:
        a.rest = ["status"]
    if a.rest[0] == "propose":
        return _spec_propose(p, a)
    if a.rest[0] == "shadow":
        return _spec_shadow(p, a.rest[1:])
    if a.rest[0] == "migrate":
        return _spec_migrate(p, "--dry-run" in a.rest)
    if a.rest[0] == "blocks":
        tmpl = _project_template(p)
        argv = [framework_python(), "-m", "csa_docx.spec_blocks", str(tmpl)] + (["--write"] if "--write" in a.rest else [])
        return subprocess.call(argv, cwd=str(FRAMEWORK), env=_fw_env())
    return spec_call(p, *a.rest, capture=False).returncode


def _project_template(p: dict) -> Path:
    r = subprocess.run([framework_python(), "-c", "import sys;from csa_docx import spec_cli;print(spec_cli.find_template(None if sys.argv[1]=='-' else __import__('pathlib').Path(sys.argv[1])) or '')",
                        str(working_docx(p).parent) if working_docx(p) else "-"], cwd=str(FRAMEWORK), capture_output=True, text=True,
                       env=_fw_env())
    t = r.stdout.strip()
    if not t:
        die("no CSA template found")
    return Path(t)


def _fw_snippet(code: str, *args) -> dict | list:
    r = subprocess.run([framework_python(), "-c", code, *[str(x) for x in args]], cwd=str(FRAMEWORK), capture_output=True, text=True,
                       env=_fw_env())
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {"error": (r.stderr or r.stdout)[-600:]}


def _quiet_old(p: dict, num: str) -> dict | None:
    """The number path's answer, or None when it cannot resolve (its error message is not printed)."""
    import contextlib
    import io
    with contextlib.redirect_stderr(io.StringIO()):
        try:
            return _resolve_visible_by_number(p, num)
        except SystemExit:
            return None


def _spec_shadow(p: dict, rest: list[str]) -> int:
    """Compare the number path with the document-spec path for everything that names a section, without changing
    anything. Writes csa-work/spec/shadow-report.md and .json. Exit 0 when nothing would change meaning."""
    docx = working_docx(p)
    if not docx:
        die("no working document; nothing to compare")
    work = local_path(p["work_dir"])
    rows: list[dict] = []   # {area, item, old, new, verdict}

    def add(area, item, old, new, verdict=None):
        verdict = verdict or ("same" if old == new else "differs")
        rows.append({"area": area, "item": item, "old": old, "new": new, "verdict": verdict})

    spec = json.loads(spec_call(p, "--json", "status").stdout or "{}")
    nodes = spec.get("nodes", [])
    # 1. what a typed number means
    numbers = sorted(set(_template_visible_headings()) | {n["number"] for n in nodes if n["level"] <= 2 and n["number"]},
                     key=lambda s: [int(x) for x in s.split(".")])
    for num in numbers:
        old = _quiet_old(p, num)
        o = f"{old.get('heading')} @H{old.get('stable_path')}" if old and old.get("stable_path") else None
        n = next((x for x in nodes if x["number"] == num), None)
        nw = f"{n['title']} {n['hid']}" if n else None
        if o is None and nw:
            add("number", num, o, nw, "old fails")
        elif nw is None and o:
            add("number", num, o, nw, "new fails")
        elif o is not None:
            add("number", num, o, nw, "same" if o.split(" @H")[-1] == nw.split(" @H")[-1] else "differs")
    # 2. change files: the section each file was written for
    by_path = {n["path"]: n for n in nodes}
    for files in all_change_files(p).values():
        for f in files:
            m = CHANGE_FILE_RE.match(f.name)
            if not m["label"] or not SUBSECTION_LABEL_RE.match(m["label"]):
                continue
            num = label_display(m["section"], m["label"])
            old = _quiet_old(p, num)
            on = by_path.get(str(old.get("stable_path"))) if old else None
            key = change_file_key(f)
            kn = next((x for x in nodes if x["key"] == key), None) if key else None
            if key:
                add("change file", f.name, on["key"] if on else None, key, "same" if (on and on["key"] == key) else "differs")
            else:
                add("change file", f.name, on["key"] if on else None, None, "not migrated")
    # 3. author folders
    adir = work / "author"
    for d in sorted(adir.iterdir()) if adir.is_dir() else []:
        if d.is_dir() and re.fullmatch(r"\d+(-\d+)*", d.name):
            res = spec_resolve(p, d.name.replace("-", "."))
            add("author folder", d.name, d.name, res.get("key"), "not migrated" if res.get("status") == "OK" else "new fails")
    # 4. framework section numbers used by place/build
    fs = _fw_snippet("""import sys,json
from pathlib import Path
from csa_docx import build_plan as b
ws=Path(sys.argv[1])
try:
    _, e = b._manifest_entries(ws)
except Exception as x:
    print(json.dumps({"error": str(x)})); raise SystemExit
out=[]
for x in e:
    if x.get("kind")=="heading" and x.get("level")==1:
        out.append([x["section_path"], x.get("text"), b._framework_section_by_number(x["section_path"], e), b._spec_section(x["section_path"], ws)])
print(json.dumps(out))""", _ws(p))
    if isinstance(fs, dict):
        add("framework section", "manifest", fs.get("error"), None, "new fails")
    else:
        for path, text, old, new in fs:
            add("framework section", f"@H{path} {text}", old, new)
    # 5. template-level maps (shared by every project)
    tmpl = _project_template(p)
    tl = _fw_snippet("""import sys,json,csv
from pathlib import Path
from csa_docx import spec_blocks as sb, doc_spec, targets, legacy_map, requirement_assign
spec=doc_spec.read(sys.argv[1]); targets.template_spec.cache_clear()
cur=json.loads(sb.BLOCKS.read_text(encoding="utf-8")); out={"blocks": sb.diff(cur, sb.generate(spec, cur)), "req": [], "legacy": []}
nodes={n["key"]: n for n in spec["nodes"]}
for r in requirement_assign.load_requirements():
    k=targets.requirement_key(r); num=nodes[k]["number"] if k in nodes else None
    out["req"].append([r["req_id"], r["domain"], num])
with open(legacy_map.DEFAULT_MAP if hasattr(legacy_map,"DEFAULT_MAP") else Path(legacy_map.__file__).resolve().parents[2]/"skills"/"csa-document-template"/"references"/"legacy-map-default.csv", encoding="utf-8") as fh:
    for row in csv.DictReader(fh):
        t=row.get("target","")
        if t and t!="signal":
            out["legacy"].append([t, targets.canonical(t), bool(targets.target_key(t))])
print(json.dumps(out))""", tmpl)
    if "error" in tl:
        add("template", "maps", tl["error"], None, "new fails")
    else:
        add("template blocks", tmpl.name, "file", "generated", "same" if not tl["blocks"] else "differs")
        for d in tl["blocks"]:
            add("template blocks", d[:60], d, None, "differs")
        for rid, dom, num in tl["req"]:
            add("requirement map", rid, dom, num)
        for t_, canon, ok in tl["legacy"]:
            add("legacy map", t_, t_, canon if ok else None, "same" if ok and canon == t_ else ("new fails" if not ok else "differs"))
    counts: dict[str, int] = {}
    for r in rows:
        counts[r["verdict"]] = counts.get(r["verdict"], 0) + 1
    out = work / "spec"
    out.mkdir(parents=True, exist_ok=True)
    (out / "shadow-report.json").write_text(json.dumps({"counts": counts, "rows": rows}, indent=1), encoding="utf-8")
    lines = [f"# Shadow report: {p.get('label', p['key'])}", "", f"Document: {docx.name}. Mode: {spec_mode(p)}.", "",
             "Verdicts: same (both paths agree); differs (the number path and the document spec name different "
             "sections); old fails / new fails (one path cannot resolve it); not migrated (no section key recorded yet).", "",
             "| Area | Item | Number path | Document spec | Verdict |", "| --- | --- | --- | --- | --- |"]
    lines += [f"| {r['area']} | {r['item']} | {r['old']} | {r['new']} | {r['verdict']} |" for r in rows if r["verdict"] != "same"]
    lines += ["", "Counts: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items()))]
    (out / "shadow-report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    log = out / "shadow.log"
    logged = len(log.read_text(encoding="utf-8").splitlines()) if log.is_file() else 0
    print(f"{C['b']}Shadow report{C['0']} ({docx.name}, mode {spec_mode(p)}): " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items()))
          + f"; {logged} difference(s) logged during runs")
    for r in rows:
        if r["verdict"] in ("differs", "new fails"):
            print(f"  {r['verdict']:<10} {r['area']:<18} {r['item']}: {r['old']} | {r['new']}")
    print(f"{C['d']}{out / 'shadow-report.md'}{C['0']}")
    blocking = counts.get("differs", 0) + counts.get("new fails", 0)
    return 0 if not blocking else 1


def _spec_migrate(p: dict, dry_run: bool) -> int:
    """Record the section key in every labelled change file (from the section it was written for), move
    csa-work/author/<3-4>/ to author/<KEY>/, and write csa-work/spec/migrate-report.md. Backs up first.
    The evidence matrix is append-only: its rows are not rewritten (cards match them by section title)."""
    docx = working_docx(p)
    if not docx:
        die("no working document")
    work = local_path(p["work_dir"])
    spec = json.loads(spec_call(p, "--json", "status").stdout or "{}")
    by_path = {n["path"]: n for n in spec.get("nodes", [])}
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup = work / "backups" / f"migrate-{stamp}"
    report = [f"# Migrate to section keys: {p.get('label', p['key'])}", "", f"{'Dry run. ' if dry_run else ''}Backup: {backup}", "",
              "| Item | Section | Key | Action |", "| --- | --- | --- | --- |"]
    changed = 0
    for files in all_change_files(p).values():
        for f in files:
            m = CHANGE_FILE_RE.match(f.name)
            if not m["label"] or not SUBSECTION_LABEL_RE.match(m["label"]):
                continue
            if change_file_key(f):
                report.append(f"| {f.name} | {label_display(m['section'], m['label'])} | {change_file_key(f)} | already recorded |")
                continue
            num = label_display(m["section"], m["label"])
            old = _quiet_old(p, num)                         # the file was named under the number path
            if not old:
                report.append(f"| {f.name} | {num} | - | not resolvable; left as is |")
                continue
            node = by_path.get(str(old.get("stable_path")))
            if not node:
                report.append(f"| {f.name} | {num} | - | heading not in the document; left as is |")
                continue
            text = f.read_text(encoding="utf-8")
            line = f"**Section key:** {node['key']}"
            mm = re.search(r"^\*\*Section:\*\*.*$", text, re.M)
            new = (text[:mm.end()] + "\n" + line + text[mm.end():]) if mm else (line + "\n\n" + text)
            if not dry_run:
                backup.mkdir(parents=True, exist_ok=True)
                shutil.copy2(f, backup / f.name)
                f.write_text(new, encoding="utf-8")
            changed += 1
            report.append(f"| {f.name} | {num} | {node['key']} | {'would record' if dry_run else 'recorded'} |")
    adir = work / "author"
    for d in sorted(adir.iterdir()) if adir.is_dir() else []:
        if not (d.is_dir() and re.fullmatch(r"\d+(-\d+)*", d.name)):
            continue
        num = d.name.replace("-", ".")
        old = _quiet_old(p, num)
        node = by_path.get(str(old.get("stable_path"))) if old else None
        if not node:
            report.append(f"| author/{d.name} | {num} | - | not resolvable; left as is |")
            continue
        dest = adir / node["key"]
        if dest.exists():
            report.append(f"| author/{d.name} | {num} | {node['key']} | author/{node['key']} exists; left as is |")
            continue
        if not dry_run:
            d.rename(dest)
        changed += 1
        report.append(f"| author/{d.name} | {num} | {node['key']} | {'would move' if dry_run else 'moved'} to author/{node['key']} |")
    report += ["", "The evidence matrix is append-only and is not rewritten; section cards match its rows by section title.",
               "Next: `csa spec shadow` (expect no 'not migrated'), then set `spec_mode: on` for this project in PROJECTS.yaml."]
    out = work / "spec" / "migrate-report.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(report) + "\n", encoding="utf-8")
    print(f"{C['b']}{'Would change' if dry_run else 'Changed'} {changed} item(s).{C['0']} {out}")
    for line in report[6:]:
        if line.startswith("| "):
            print("  " + line)
    return 0


def _spec_propose(p: dict, a) -> int:
    """Sections the rules cannot classify or identify go to the answer agent (MODE=propose) as a proposal card.
    The proposals are written to csa-work/cards/proposals.answer.md for Wenzel to read; nothing is applied."""
    lint = json.loads(spec_call(p, "--json", "lint").stdout or "[]")
    stamp = json.loads(spec_call(p, "--json", "stamp", "--dry-run").stdout or "{}")
    status = json.loads(spec_call(p, "--json", "status").stdout or "{}")
    items = [f for f in lint if f["code"] in ("NO_FILLABLE_CONTENT", "NO_REQUIREMENT_TABLE", "MIXED_FAMILIES", "EMPTY_REQUIREMENT_TABLE")]
    asks = stamp.get("ask", [])
    if not items and not asks:
        print("Nothing to propose: every section is classified and identified.")
        return 0
    cards = local_path(p["work_dir"]) / "cards"
    cards.mkdir(parents=True, exist_ok=True)
    card = cards / "proposals.md"
    keys = sorted({n["key"] for n in status.get("nodes", [])} | {r["key"] for r in status.get("removed", [])})
    lines = ["# Proposal card", "", "Mode: propose. For each item give the kind it most likely is and the questions that",
             "kind implies, or the template key it most likely came from, with a one-line reason.", "", "## Items", ""]
    lines += [f"- {f['message']} ({f['code']})" for f in items]
    lines += [f"- {x['number']} {x['title']}: no stamp; derived key {x['key']} ({x['reason']})" for x in asks]
    lines += ["", "## Keys the template and document already use", "", ", ".join(keys)]
    card.write_text("\n".join(lines) + "\n", encoding="utf-8")
    out = cards / "proposals.answer.md"
    rc = launch(p, agent("answer"), ["MODE=propose", f"CARD={card}", f"SHEET={out}"], a)
    if out.is_file():
        print(f"{C['b']}Proposals in {out}. Nothing was changed; confirm a stamp with `csa spec stamp --confirm`.{C['0']}")
    return rc


def cmd_card(a):
    """csa card <target> [--no-evidence] [--search B3=terms]: the section card the answer agent works from."""
    p = project(a.project); banner(p)
    if not a.rest:
        die("usage: csa card <section|heading|family> [--no-evidence] [--search B3='terms']")
    res = resolve_target(p, a.rest[0])
    if res.get("status") != "OK":
        die(res.get("message", "cannot resolve the section"))
    work = local_path(p["work_dir"])
    out = work / "cards" / f"{res['key']}.md"
    argv = [framework_python(), "-m", "csa_docx.section_card", res["number"], "--workspace", str(local_path(p["project_root"])),
            "--work-dir", str(work), "--out", str(out)]
    docx = working_docx(p)
    if docx:
        argv += ["--docx", str(docx)]
    if legacy_docx(p):
        argv += ["--exclude", legacy_docx(p).name]
    rc = subprocess.run(argv + a.rest[1:], cwd=str(FRAMEWORK), env=_fw_env()).returncode
    if rc == 0:
        print(f"{C['d']}written to {out}{C['0']}", file=sys.stderr)
    return rc


def cmd_budget(a):
    """Tokens each agent loads before it starts (csa_docx.context_budget). No project needed."""
    argv = ([a.verb] if a.verb else []) + (["--max", str(a.max)] if a.max is not None else []) + (["--json"] if a.json else [])
    code = "import sys;sys.path.insert(0,sys.argv[1]);from csa_docx import context_budget as m;sys.exit(m.main(sys.argv[2:]))"
    return subprocess.call([framework_python(), "-c", code, str(FRAMEWORK), *argv])


def cmd_doctor(a):
    ok = True
    def line(good, msg, hint=""):
        nonlocal ok
        ok &= bool(good) or good is None
        mark = f"{C['g']}ok{C['0']}" if good else (f"{C['y']}--{C['0']}" if good is None else f"{C['r']}!!{C['0']}")
        print(f" {mark}  {msg}" + (f"  {C['d']}{hint}{C['0']}" if hint else ""))
    print(f"{C['b']}csa doctor{C['0']}  ({AGENTS_DIR})")
    line(sys.version_info >= (3, 10), f"csa runs on Python {sys.version.split()[0]}")
    try:
        py = framework_python()
        v = subprocess.run([py, "--version"], capture_output=True, text=True).stdout.strip()
        line(True, f"framework interpreter: {py} ({v})")
        r = subprocess.run([py, "-c", f"import sys;sys.path.insert(0,{str(FRAMEWORK)!r});import csa_docx.tools"], capture_output=True, text=True)
        line(r.returncode == 0, "csa_docx imports", r.stderr.strip().splitlines()[-1] if r.returncode else "")
        r = subprocess.run([py, "-c", f"import sys;sys.path.insert(0,{str(FRAMEWORK / 'vendor')!r});import rapidfuzz"], capture_output=True, text=True)
        line(True if r.returncode == 0 else None, "vendored rapidfuzz loads" if r.returncode == 0 else "vendored rapidfuzz does not load here (difflib fallback is used)")
    except SystemExit:
        line(False, "no framework interpreter >= 3.11", "set CSA_PYTHON or cli.yaml python:")
    for f in (PROJECTS_FILE, REGISTRY_FILE, CLI_FILE):
        line(f.is_file(), f"{f.relative_to(AGENTS_DIR) if f.is_relative_to(AGENTS_DIR) else f} present")
    for r in registry():
        line((AGENTS_DIR / r["file"]).is_file(), f"agent '{r['verb']}' -> {r['file']}")
        sk = r.get("skill")
        line(True if sk and (SKILLS / sk / "SKILL.md").is_file() else None,
             f"agent '{r['verb']}' wrapper skill {sk}" + ("" if (SKILLS / str(sk) / "SKILL.md").is_file() else " missing"),
             "" if (SKILLS / str(sk) / "SKILL.md").is_file() else "run `csa sync`")
    for d in sorted(SKILLS.iterdir()):
        if d.is_dir():
            s = d / "SKILL.md"
            head = s.read_text(encoding="utf-8")[:4] if s.is_file() else ""
            if head != "---\n":
                line(False, f"skill {d.name}: SKILL.md missing or has no frontmatter")
    stray = list((FRAMEWORK / "csa_docx").glob("*.bak"))
    line(not stray, "no stray .bak files in framework/csa_docx", ", ".join(x.name for x in stray))
    for p in projects():
        root = local_path(p["project_root"])
        line(root.is_dir(), f"project {p['key']}: root exists")
        d = working_docx(p)
        if d:
            locks = [x.name for x in d.parent.glob("~$*.docx")]
            line(None if locks else True, f"project {p['key']}: {d.name}" + (" is OPEN in Word (lock file)" if locks else ""),
                 "close Word before apply/review/cleanup" if locks else "")
        ld = legacy_docx(p)
        if ld:
            if ld.is_file():
                line(True, f"project {p['key']}: legacy document {ld.name}")
            else:
                line(False, f"project {p['key']}: legacy document missing", str(ld))
    for cli in ("codex", "claude", "hermes"):
        line(True if shutil.which(cli) else None, f"{cli} CLI " + ("found" if shutil.which(cli) else "not on PATH"))
    if getattr(a, "tests", True):
        try:
            r = subprocess.run([framework_python(), "-m", "pytest", "-q", "-p", "no:cacheprovider",
                                str(FRAMEWORK / "csa_docx/tests")], cwd=str(FRAMEWORK),
                               capture_output=True, text=True, timeout=900)
            last = (r.stdout.strip().splitlines() or ["no output"])[-1]
            line(r.returncode == 0, f"framework tests: {last}", "" if r.returncode == 0 else "run `csa test` for details")
        except SystemExit:
            pass
        except Exception as e:
            line(None, f"framework tests not run ({e.__class__.__name__})")
    act = active_key()
    line(True if act else None, f"active project: {act or 'none (csa use <key>)'}")
    return 0 if ok else 1


# ---------------------------------------------------------------- agent launcher
def agent(verb: str) -> dict:
    for r in registry():
        if r["verb"] == verb:
            return r
    die(f"unknown agent verb '{verb}'")


def parse_inputs(spec: str) -> list[tuple[str, str | None, bool]]:
    out = []
    for part in [x.strip() for x in spec.split(",") if x.strip()]:
        if "=" in part:
            k, _, v = part.partition("=")
            out.append((k.strip(), v.strip(), False))
        else:
            out.append((part.rstrip("*"), None, part.endswith("*")))
    return out


def local_launch(cmdline: str = "") -> bool:
    """A local-model launch: CSA_LOCAL=1, or a codex command line that picks a --profile."""
    if os.environ.get("CSA_LOCAL", "").strip().lower() in ("1", "true", "yes", "on"):
        return True
    return "--profile" in cmdline


def build_prompt(p: dict, r: dict, args: list[str], local: bool | None = None) -> str:
    inputs = parse_inputs(r.get("inputs", ""))
    values = {k: v for k, v, _ in inputs if v is not None}
    if local if local is not None else local_launch():
        for k, v, _ in parse_inputs(r.get("local_inputs", "")):   # smaller batches for local models
            if v is not None:
                values[k] = v
    positional = [x for x in args if "=" not in x]
    for x in args:
        if "=" in x:
            k, _, v = x.partition("=")
            values[k.strip().upper()] = v.strip()
    if positional:
        values[r.get("arg", "SECTION")] = " ".join(positional)
    requested_section = values.get("SECTION", "")
    sec, label = split_section(requested_section)
    resolved = resolve_visible_section(p, label_display(sec, label)) if str(requested_section).strip() else {}
    if label:
        values["SECTION"], values["SUBSECTION"] = sec, label_display(sec, label)
        if r.get("verb") != "answer":            # the answer agent writes a sheet, never a change file
            cf = pick_change_file(p, sec, label)
            values["CHANGE_FILE"] = str(cf) if cf else f"reviews/ChangesCSA_<App>_Section{sec}_{label}.md (create it)"
    if resolved.get("stable_path"):
        values["STABLE_SUBTREE"] = "@H" + resolved["stable_path"]
        values["DOCUMENT_HEADING"] = resolved["heading"]
    missing = [k for k, _, req in inputs if req and not values.get(k)]
    if missing:
        die(f"`csa {r['verb']}` needs {', '.join(missing)}, e.g. `csa {r['verb']} <{missing[0].lower()}>`")
    lines = [f"Load this agent definition:\n{CANON_AGENTS / r['file']}\n", f"Act as the {r['title']}.\n",
             f"PROJECT={p.get('label')} ({p['key']})  -- confirmed by the user via `csa use`; do not ask again.",
             f"PROJECT_CONTEXT={p['project_context']}", f"WORK_DIR={p['work_dir']}",
             f"WORKSPACE={p['project_root']}", f"SOURCE_SET={values.pop('SOURCE_SET', p.get('default_source_set', ''))}"]
    order = [k for k, _, _ in inputs] + [k for k in values if k not in {i[0] for i in inputs}]
    for k in order:
        if values.get(k):
            lines.append(f"{k}={values[k]}")
    if values.get("SUBSECTION") and r.get("verb") == "answer":
        lines.append(f"\nThe card is for visible document subsection {values['SUBSECTION']} ({values.get('DOCUMENT_HEADING')}). "
                     "Write only the answer sheet at SHEET.")
    elif values.get("SUBSECTION"):
        stable = values.get("STABLE_SUBTREE")
        if not stable:
            die(f"SECTION_MAPPING_ERROR: visible subsection {values['SUBSECTION']} has no live stable-ID mapping; "
                "run `csa prepare` and try again")
        lines.append(f"\nWork on visible document subsection {values['SUBSECTION']} "
                     f"({values.get('DOCUMENT_HEADING')}) only: its live stable-ID subtree is {stable}. "
                     "Do not derive a stable ID from the visible number. Use CHANGE_FILE. "
                     f"Edit IDs stay S{values['SECTION']}-E<n>, numbered on from every Section {values['SECTION']} change file. "
                     "See 'Subsections' in csa-core-rules.md.")
    elif resolved.get("stable_path"):
        lines.append(f"\nVisible document section {sec} ({resolved['heading']}) resolves to live stable-ID subtree "
                     f"@H{resolved['stable_path']}. Do not derive a stable ID from the visible number. "
                     f"Edit IDs stay S{sec}-E<n>.")
    lines.append("\n" + r.get("instruction", ""))
    stage = {"answer": "answer", "author": "author"}.get(r.get("verb", ""))
    if r.get("verb") == "write" and str(values.get("MODE", "")).lower() == "records":
        stage = "writer"
    if stage and not (r.get("verb") == "answer" and str(values.get("MODE", "answer")).lower() != "answer"):
        lines.append("\n## Rules (digest)\n\n" + _fw_digest(stage).rstrip())
        lines.append("\nDo not read the full skill or reference files unless a check names them.")
    return "\n".join(lines)


def _fw_digest(stage: str) -> str:
    sys.path.insert(0, str(FRAMEWORK))
    try:
        from csa_docx.rules_digest import digest
        return digest(stage)
    except (OSError, ValueError) as e:
        die(f"rules digest for {stage}: {e}")
    finally:
        sys.path.remove(str(FRAMEWORK))


def task_cli(verb: str) -> str | None:
    """`task_cli:` in cli.yaml, e.g. `answer: claude, write: codex`: the CLI for one agent verb."""
    pairs = [x.split(":", 1) for x in str(settings().get("task_cli", "") or "").split(",") if ":" in x]
    return {k.strip(): v.strip() for k, v in pairs}.get(verb)


def launch(p: dict, r: dict, args: list[str], a) -> int:
    cli = getattr(a, "cli", None) or os.environ.get("CSA_CLI") or task_cli(r.get("verb", "")) or settings().get("default_cli", "codex")
    mode = "headless" if getattr(a, "headless", False) else "interactive"
    if mode == "interactive" and not getattr(a, "print", False) and not (sys.stdin.isatty() and sys.stdout.isatty()):
        # An interactive CLI draws a full-screen UI (title, cursor and screen control codes). With no terminal
        # (output captured or redirected, run by another agent or a script) those codes land in the log as text.
        mode = "headless"
        print("csa: no terminal here, so the agent runs headless (no interactive UI)", file=sys.stderr)
    tmpl = settings().get(f"{cli}_{mode}")
    prompt = build_prompt(p, r, args, local=local_launch(tmpl or ""))
    if getattr(a, "print", False):
        print(prompt)
        return 0
    if not tmpl:
        die(f"no '{cli}_{mode}' command in .agents/cli.yaml")
    argv = [prompt if t == "{prompt}" else t for t in shlex.split(tmpl)]
    if not shutil.which(argv[0]):
        print(prompt)
        die(f"'{argv[0]}' is not on PATH. Prompt printed above; paste it into your CLI.")
    print(f"{C['d']}launching {cli} ({mode}) as {r['title']} in {ROOT}{C['0']}", file=sys.stderr)
    return subprocess.call(argv, cwd=str(ROOT))


def tracked_revision_count(docx: Path) -> int:
    """Tracked insertions, deletions and moves in the document body (0 = nothing left to accept)."""
    import zipfile
    with zipfile.ZipFile(docx) as z:
        xml = z.read("word/document.xml").decode("utf-8", errors="ignore")
    return len(re.findall(r"<w:(?:ins|del|moveFrom|moveTo)\s", xml))


def _cleanup_not_needed(p: dict, args: list[str]) -> bool:
    """`csa cleanup N` accepts signed-off tracked changes. When review signed off and the working DOCX has none
    left (accepted in Word already), record that and skip the agent session."""
    values = task_values(agent("cleanup"), args)
    sec, label = split_section(values.get("SECTION", ""))
    docx = working_docx(p)
    if not sec or not str(sec).isdigit() or not docx:
        return False
    st = section_state(p, sec, label)
    cf = Path(st["change_file"]) if st["change_file"] else None
    if not cf or st["signoff"] != "YES" or st["cleaned"]:
        return False
    if tracked_revision_count(docx):
        return False
    stamp = time.strftime("%Y-%m-%d %H:%M")
    cf.write_text(cf.read_text(encoding="utf-8").rstrip("\n") + f"""

## Cleanup Report

Cleanup result: NOT NEEDED

The working document had no tracked revisions at {stamp}; the signed-off changes were already accepted in Word. Nothing was changed and no backup was made (`csa cleanup`, no agent session).
""", encoding="utf-8")
    print(f"{C['b']}Nothing to accept: {docx.name} has no tracked revisions. Recorded in {cf.name}.{C['0']}")
    return True


def writer_pass_wanted(args: list[str], no_writer: bool = False) -> bool:
    """An author run is followed by the writer pass (`csa write N MODE=records`) unless it is switched off or the
    run is an editorial concision pass, whose edits are already final prose."""
    if no_writer:
        return False
    return task_values(agent("author"), args).get("EDIT_MODE", "evidence").lower() != "editorial"


def _writer_pass(p: dict, args: list[str], started: float, a) -> int:
    """Run the writer over the change file the author just wrote: it rewrites each prose Text from its Facts."""
    values = task_values(agent("author"), args)
    sec, label = split_section(values.get("SECTION", ""))
    if not sec or not str(sec).isdigit():
        return 0
    st = section_state(p, sec, label)
    cf = Path(st["change_file"]) if st["change_file"] else None
    if not cf or not st["edits"] or cf.stat().st_mtime < started - 1:
        return 0
    _autofix_change(p, cf, sec, label)
    if not getattr(a, "writer", False) and not getattr(a, "print", False):
        needed, why = _writer_needed(p, cf, sec, label)
        if not needed:
            print(f"{C['b']}Writer pass skipped: check-change is clean.{C['0']}")
            _record_author_run(p, args, write_s=0, writer="skipped")
            return 0
        _record_author_run(p, args, writer=f"run: {why}")
    print(f"{C['b']}Writer pass: rewriting the prose in {cf.name} from its Facts.{C['0']}")
    return launch(p, agent("write"), [values["SECTION"], "MODE=records"], a)


# lint lines that name a structural prose problem (prose_lint warnings); "(advisory)" lines never count
_STRUCTURAL = re.compile(r"fragment|lead-in|nested bullet|connector|stock phrase|repeated|stated in >|evidence ID|"
                         r"evidence file|evidence-as-subject|inference|bullets \(limit|hedges", re.I)


def writer_needed_from(findings: list[dict]) -> tuple[bool, str]:
    """Does the change file need the writer pass? Yes on any ERROR, or a PROSE_LINT / TERM_LINT line that names a
    structural problem. Advisory lines (length, sentence size, identifiers) never trigger it."""
    for f in findings:
        if f.get("level") == "ERROR":
            return True, f"{f.get('code')} {str(f.get('message', ''))[:80]}"
        if f.get("code") in ("PROSE_LINT", "TERM_LINT") and f.get("level") in ("WARN", "ERROR"):
            for line in str(f.get("message", "")).splitlines():
                if "(advisory)" not in line and _STRUCTURAL.search(line):
                    return True, f"{f['code']} {line.strip()[:80]}"
    return False, ""


def _writer_needed(p: dict, cf: Path, sec: str, label: str | None) -> tuple[bool, str]:
    argv = [framework_python(), "-m", "csa_docx.check_change", str(cf), "--workspace", str(local_path(p["project_root"])), "--json"]
    if p.get("work_dir"):
        argv += ["--notes", str(author_dir(p, sec, label) / "search-notes.md"),
                 "--evidence", str(local_path(p["work_dir"]) / "evidence-matrix.csv")]
    r = subprocess.run(argv, cwd=str(FRAMEWORK), capture_output=True, text=True, env=_fw_env())
    try:
        return writer_needed_from(json.loads(r.stdout).get("findings", []))
    except ValueError:
        return True, "check-change gave no result"


def _record_author_run(p: dict, args: list[str], **data) -> None:
    """Merge stage times and the answer counts into WORK_DIR/author/<N>/timing.json, so runs can be compared."""
    try:
        sec, label = split_section(task_values(agent("author"), args).get("SECTION", ""))
        if not sec:
            return
        path = author_dir(p, sec, label) / "timing.json"
        old = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
        old.update(data)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(old, indent=2) + "\n", encoding="utf-8")
    except (OSError, ValueError):
        pass


def _fleet_session_stats(p: dict, t: dict) -> None:
    """Read the finished task's log: commands, KB read and tokens go to the fleet summary (t['stats']) and,
    for author / answer / writer tasks, to the section's timing.json as <stage>_read_kb, _commands, _tokens."""
    try:
        sys.path.insert(0, str(FRAMEWORK))
        from csa_docx.session_stats import stats, timing_fields
        if t.get("cards"):
            return                  # the log is csa's own output; the stages inside are not Codex logs
        stage = {"author": "author", "answer": "answer", "write": "write"}.get(t["verb"], t["verb"])
        st = stats(t["log"])
        t["stats"] = {**timing_fields(stage, st), "top_files": st["top_files"][:5]}
        if t["verb"] in ("author", "answer", "write") and t["args"]:
            _record_author_run(p, t["args"], **timing_fields(stage, st))
    except (OSError, ValueError, ImportError):
        pass
    finally:
        if str(FRAMEWORK) in sys.path:
            sys.path.remove(str(FRAMEWORK))


def _record_author_counts(p: dict, args: list[str]) -> None:
    sec, label = split_section(task_values(agent("author"), args).get("SECTION", ""))
    if not sec or not str(sec).isdigit():
        return
    st = section_state(p, sec, label)
    if not st["change_file"]:
        return
    r = subprocess.run([framework_python(), "-m", "csa_docx.author_report", str(st["change_file"]), "--json"], cwd=str(FRAMEWORK),
                       env=_fw_env(), capture_output=True, text=True)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return
    c = d["counts"]
    _record_author_run(p, args, questions=d["questions"], answered=c["ANSWERED"], open=c["OPEN"], unanswered=c["UNANSWERED"],
                       untagged_facts=d["untagged"], records=d["records"])


def _app_name(p: dict, reviews: Path) -> str:
    for f in sorted(reviews.glob("ChangesCSA_*_Section*.md")):
        m = re.match(r"ChangesCSA_(.+?)_Section\d", f.name)
        if m:
            return m.group(1)
    return p.get("label") or p["key"]


def _fw_json(module: str, *args) -> dict:
    r = subprocess.run([framework_python(), "-m", module, *[str(x) for x in args]], cwd=str(FRAMEWORK), capture_output=True,
                       text=True, env=_fw_env())
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {"status": "ERROR", "message": (r.stderr or r.stdout or "no output")[-800:]}


def _matrix_ids(work: Path) -> set[str]:
    import csv
    f = work / "evidence-matrix.csv"
    if not f.is_file():
        return set()
    with f.open(newline="", encoding="utf-8-sig") as fh:
        return {r["evidence_id"] for r in csv.DictReader(fh)}


def _author_cards(p: dict, a) -> int:
    """csa author N --cards: the framework builds the section card (questions from the document, evidence
    gathered per question), the answer agent writes the answer sheet, the framework checks it (one search round
    and one fix round at most), renders the change file with anchors from the document spec, then the writer pass,
    check-change and apply run as for any author run."""
    target = next((x for x in a.args if "=" not in x), None)
    if not target:
        die("usage: csa author <section|heading|family> --cards")
    res = resolve_target(p, target)
    if res.get("status") != "OK":
        die(res.get("message", "cannot resolve the section"))
    number, key = res["number"], res["key"]
    sec, label = split_section(number)
    docx = working_docx(p)
    if not docx:
        die("no working DOCX; the card path revises an existing document (use csa write for a first draft)")
    work = local_path(p["work_dir"])
    cards = work / "cards"
    cards.mkdir(parents=True, exist_ok=True)
    card_md, sheet, errs = cards / f"{key}.md", cards / f"{key}.answer.md", cards / f"{key}.errors.md"
    card_json = card_md.with_suffix(".json")
    matrix = work / "evidence-matrix.csv"
    started = time.time()
    before = _matrix_ids(work)

    def build(searches: list[tuple[str, str]] = ()) -> None:
        argv = [number, "--docx", docx, "--workspace", local_path(p["project_root"]), "--work-dir", work, "--out", card_md, "--json"]
        if legacy_docx(p):
            argv += ["--exclude", legacy_docx(p).name]
        for qid, terms in searches:
            argv += ["--search", f"{qid}={terms}"]
        out = _fw_json("csa_docx.section_card", *argv)
        if out.get("status") != "OK":
            die(f"the section card could not be built: {out.get('message', out)}")
        print(f"{C['b']}Card {card_md.name}: {len(out['questions'])} question(s), about {out['tokens']} tokens.{C['0']}")

    def answer(extra: list[str]) -> int:
        if sheet.exists():
            sheet.replace(sheet.with_suffix(".prev.md"))
        t0 = time.time()
        rc = launch(p, agent("answer"), [number, f"CARD={card_md}", f"SHEET={sheet}", *extra], a)
        timing["answer_s"] = round(timing.get("answer_s", 0) + time.time() - t0, 1)
        return rc

    def check() -> dict:
        if not sheet.is_file():
            return {"status": "ERROR", "findings": [{"level": "ERROR", "code": "NO_SHEET", "question": None,
                                                     "message": f"the answer agent wrote no {sheet.name}"}], "searches": {}}
        return _fw_json("csa_docx.answer_sheet", "validate", sheet, "--card", card_json, "--matrix", matrix,
                        "--new-ids", ",".join(sorted(_matrix_ids(work) - before)))

    timing: dict = {}
    build()
    if getattr(a, "print", False):
        return launch(p, agent("answer"), [number, f"CARD={card_md}", f"SHEET={sheet}"], a)
    hosts_csv = work / "hosts" / "hosts.csv"
    cache = {"status": "NONE", "changed": []}
    if not getattr(a, "fresh", False):
        cache = _fw_json("csa_docx.answer_cache", "check", sheet, "--card", card_json, "--matrix", matrix,
                         *(["--hosts", hosts_csv] if hosts_csv.is_file() else []), "--json")
    if cache.get("status") == "REUSE":
        print(f"{C['b']}Reusing {sheet} (inputs unchanged){C['0']}")
        timing["reused"] = True
    elif cache.get("status") == "PARTIAL":
        ids = ",".join(cache["changed"])
        print(f"{C['b']}Inputs changed for {ids}; the answer agent rewrites only those blocks.{C['0']}")
        timing["reused"] = "partial"
        if answer([f"ONLY={ids}", f"ANSWER={sheet.with_suffix('.prev.md')}"]) != 0:
            return 2
    else:
        timing["reused"] = False
        if answer([]) != 0:
            return 2
    res2, searched, fixed = check(), False, False
    while res2.get("status") != "OK":
        if res2.get("status") == "NEEDS_SEARCH" and not searched:
            searched = True
            asks = [(q, t) for q, ts in res2.get("searches", {}).items() for t in ts]
            print(f"{C['b']}The answer asked for {len(asks)} search(es); adding the results to the card once.{C['0']}")
            build(asks)
            rc = answer([])
        elif not fixed:
            fixed = True
            lines = [f"- {f['level']} {f['code']} {f.get('question') or ''}: {f['message']}" for f in res2.get("findings", [])]
            if res2.get("status") == "NEEDS_SEARCH":
                lines.append("- ERROR SEARCH_USED: the one search round is used; answer with the evidence on the card, or Unknown:")
            errs.write_text("Fix these in the answer sheet and write it again:\n\n" + "\n".join(lines) + "\n", encoding="utf-8")
            print(f"{C['y']}The answer sheet has {res2.get('errors', len(lines))} problem(s); one fix round.{C['0']}")
            rc = answer([f"ERRORS={errs}"])
        else:
            for f in res2.get("findings", []):
                print(f"  {f['level']} {f['code']} {f.get('question') or ''}: {f['message']}", file=sys.stderr)
            _record_author_run(p, [number], cards=True, sheet_status=res2.get("status"), search_round=searched, fix_round=fixed, **timing)
            die(f"the answer sheet still fails after the fix round; nothing was applied. Sheet: {sheet}")
        if rc != 0:
            return 2
        res2 = check()
    _fw_json("csa_docx.answer_cache", "write", sheet, "--card", card_json, "--matrix", matrix,
             *(["--hosts", hosts_csv] if hosts_csv.is_file() else []), "--json")
    if getattr(a, "check_answers", False):
        # advisory: a second look at whether each block answers its question; never a gate
        chk = cards / f"{key}.check.md"
        launch(p, agent("answer"), [number, f"CARD={card_md}", f"SHEET={chk}", "MODE=check", f"ANSWER={sheet}"], a)
        if chk.is_file():
            verdicts = re.findall(r"^\s*[-*]?\s*([BC]\d+)\s*:\s*(answered|partly|not answered)", chk.read_text(encoding="utf-8"), re.M | re.I)
            counts = {v: sum(1 for _, x in verdicts if x.lower() == v) for v in ("answered", "partly", "not answered")}
            timing["answer_check"] = counts
            print(f"{C['d']}answer check (advisory): {counts['answered']} answered, {counts['partly']} partly, "
                  f"{counts['not answered']} not answered; {chk.name}{C['0']}")
    reviews = Path(docx).parent / "reviews"
    st = section_state(p, sec, label)
    cf = Path(st["change_file"]) if st["change_file"] else reviews / f"ChangesCSA_{_app_name(p, reviews)}_Section{sec}{'_' + label if label else ''}.md"
    for attempt in (1, 2):
        out = _fw_json("csa_docx.answer_sheet", "render", sheet, "--card", card_json, "--docx", docx, "--section", sec,
                       "--change-file", cf, "--app", _app_name(p, reviews))
        if out.get("status") == "ERROR":
            die(f"render failed: {out.get('message')}")
        if not out.get("scaffold") or attempt == 2:
            break
        scaffold = SKILLS / "csa-document-template" / "scripts" / "scaffold_csa.py"
        for s in out["scaffold"]:
            cmd = [framework_python(), str(scaffold), s["kind"], "--docx", str(docx), "--heading", s["heading"],
                   "--heading-occurrence", str(s.get("occurrence", 1)), "--set-count", str(s["set_count"])]
            if s["kind"] == "rows":
                cmd += ["--table", str(s.get("table", 1))]
            print(f"{C['d']}scaffold: {s['heading']} -> {s['set_count']} {s['kind']}{C['0']}")
            if subprocess.run(cmd, capture_output=True, text=True).returncode not in (0,):
                die(f"scaffold refused for {s['heading']}; nothing was applied")
        fw_call("prepareDocument", workspace=_ws(p), force_regenerate=True)
    if out.get("scaffold"):
        die("the document still lacks rows for the answer after scaffolding; nothing was applied")
    print(f"{C['b']}{cf.name}: {out['records']} record(s) {out['change_set']}, {out['open']} open question(s).{C['0']}")
    _autofix_change(p, cf, sec, label)
    _record_author_run(p, [number], cards=True, sheet_status="OK", search_round=searched, fix_round=fixed, **timing)
    if getattr(a, "no_apply", False):
        return 0
    if writer_pass_wanted([number], getattr(a, "no_writer", False)):
        wstart = time.time()
        if _writer_pass(p, [number], started, a) != 0:
            print(f"{C['r']}The writer pass failed; the change file was not applied.{C['0']}", file=sys.stderr)
            return 2
        _record_author_run(p, [number], write_s=round(time.time() - wstart, 1))
    _record_author_counts(p, [number])
    return _after_agent(p, "author", [number], started, a)


def author_path(p: dict, args: list[str], legacy: bool = False, cards: bool = False) -> str:
    """Which way `csa author` runs: "cards" (card -> answer agent -> render) or "legacy" (the change-authoring
    agent does everything). Cards is the default when a working DOCX exists and the target resolves.
    `--legacy` or `author_default: legacy` in cli.yaml selects the old path; `--cards` is kept for old scripts."""
    if legacy or (str(settings().get("author_default", "cards")).lower() == "legacy" and not cards):
        return "legacy"
    target = next((x for x in args if "=" not in x and not x.startswith("-")), None)
    if not target or not working_docx(p):
        return "legacy"
    if resolve_target(p, target).get("status") != "OK":
        return "legacy"
    return "cards"


SECTION_VERBS = ("author", "write", "review", "cleanup", "answer")


def cmd_agent(a):
    p = project(a.project); banner(p)
    if a.verb in SECTION_VERBS and a.args and "=" not in a.args[0] and not re.fullmatch(r"\d+(\.\d+)*", a.args[0]):
        a.args = [section_arg(p, a.args[0])] + a.args[1:]
    if a.verb == "author" and author_path(p, a.args, getattr(a, "legacy", False), getattr(a, "cards", False)) == "cards":
        return _author_cards(p, a)
    if a.verb == "cleanup" and not getattr(a, "print", False) and _cleanup_not_needed(p, a.args):
        return 0
    started = time.time()
    rc = launch(p, agent(a.verb), a.args, a)
    if a.verb == "author" and not getattr(a, "print", False):
        _record_author_run(p, a.args, author_s=round(time.time() - started, 1))
    if rc != 0 or getattr(a, "print", False) or getattr(a, "no_apply", False):
        return rc
    if a.verb == "author" and writer_pass_wanted(a.args, getattr(a, "no_writer", False)):
        wstart = time.time()
        rc = _writer_pass(p, a.args, started, a)
        _record_author_run(p, a.args, write_s=round(time.time() - wstart, 1))
        if rc != 0:
            print(f"{C['r']}The writer pass failed; the change file was not applied. Fix it, or run "
                  f"`csa author {a.args[0] if a.args else 'N'} --no-writer` to apply the author's own text.{C['0']}", file=sys.stderr)
            return rc
    if a.verb == "author":
        _record_author_counts(p, a.args)
    return _after_agent(p, a.verb, a.args, started, a)



# ---------------------------------------------------------------- sync (generated native integration)
GEN_MARK = "<!-- generated by `csa sync` from .agents/registry.yaml - edit the registry, not this file -->"


def _wrapper_skill(r: dict) -> str:
    inputs = ", ".join(f"`{x.strip()}`" for x in r.get("inputs", "").split(",") if x.strip())
    return f"""---
name: {r['skill']}
description: {r['summary']} Wrapper for the {r['title']} ({r['file']}). Use when asked to run `csa {r['verb']}` or act as the {r['title']} on a Current State Assessment project.
---

{GEN_MARK}

# {r['title']} (`csa {r['verb']}`)

The agent definition is authoritative. Read it in full and follow it; do not work from memory:

```text
{CANON_AGENTS / r['file']}
```

Inputs: {inputs} (`*` = required, `NAME=value` = default).

## Project

Never guess the project. If the prompt does not already give `PROJECT_CONTEXT`, `WORK_DIR` and `WORKSPACE`,
run `{CANON_AGENTS / 'bin/csa'} {r['verb']} <{r.get('arg', 'SECTION').lower()}> --print` and follow the prompt it
prints (it resolves the active project from `csa use`), or ask the user which project from
`{CANON_AGENTS / 'csa-context/PROJECTS.yaml'}`.

## Useful deterministic commands (no LLM needed)

- `csa status [N]` / `csa next` - where each section is in the pipeline
- `csa lookup "<text>"` - stable `@H...` ID for a Where: anchor
- `csa ev lookup "<question>"` - evidence matrix first
- `csa index rows <table> --where "Col~text"` / `csa index search "<terms>"` - Discovery Data index second (cross-host tables and full text, with file/line citations); raw files only for what `csa index status` lists as not indexed
- `csa lint N` - prose check on a section
"""


def _slash_command(r: dict) -> str:
    return f"""---
description: {r['summary']}
argument-hint: <{r.get('arg', 'SECTION').lower()}> [KEY=VALUE ...]
---

{GEN_MARK}

Run this and then act exactly on the prompt it prints (it loads the right agent definition and the active project):

!`"{CANON_AGENTS / 'bin/csa'}" {r['verb']} $ARGUMENTS --print`
"""


STATIC_COMMANDS = {
    "csa-status": ("Show where every CSA section is in the pipeline and the next action",
                   '!`"{csa}" status $ARGUMENTS`\n\n!`"{csa}" next`\n\nSummarise the table above in two or three lines and propose the next command.'),
    "csa-pipeline": ("Walk one CSA section through the pipeline from the terminal",
                     "Tell the user to run this in a terminal, because it launches agents and asks for approval:\n\n```\ncsa pipeline $ARGUMENTS\n```"),
}

AGENTS_MD = """# Current State Assessments

{mark}

Shared CSA framework for every project in this folder. Agents, skills and framework code live in `.agents/`
(see `.agents/README.md`). Projects are registered in `.agents/csa-context/PROJECTS.yaml`.

- Command reference: `CSA-COMMANDS.md` in this folder (setup, pipeline, analysis agents, helpers).
- Start with `.agents/bin/csa status` (or `csa status` if it is on PATH): it shows the active project and where each section is.
- Launch agents through `csa <verb>` (`csa agents` lists them) so the prompt, project and defaults are always the same.
- Never edit a working DOCX outside the pipeline. The document changes as soon as content is written: `csa write` places its section file, `csa author` applies its change file, both as tracked changes. Wenzel's one approval is accept/reject in Word, then review -> cleanup.
- DOCX steps (apply, review, cleanup) run one at a time. `csa fleet` runs other tasks side by side under
  the locks in `registry.yaml`; a fleet worker never starts another fleet. Back up before any DOCX change
  (the framework does this for you).
- Project facts live in `csa-context/<PROJECT>_PROJECT_CONTEXT.yaml` and the project's evidence, never in shared agent or skill files.
"""


def cmd_sync(a):
    written = []
    def write(path: Path, text: str, only_if_generated: bool = True):
        if path.exists() and only_if_generated and GEN_MARK not in path.read_text(encoding="utf-8", errors="ignore"):
            print(f"  keep   {path.relative_to(ROOT)} (hand-written)")
            return
        if path.exists() and path.read_text(encoding="utf-8", errors="ignore") == text:
            return
        if a.dry_run:
            print(f"  would write {path.relative_to(ROOT)}")
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text, encoding="utf-8")
        written.append(path)
        print(f"  write  {path.relative_to(ROOT)}")

    print("Codex / shared wrapper skills (.agents/skills):")
    for r in registry():
        if r.get("skill"):
            write(SKILLS / r["skill"] / "SKILL.md", _wrapper_skill(r))

    print("Claude Code (.claude):")
    cdir = ROOT / ".claude"
    link = cdir / "skills"
    if not link.exists() and not link.is_symlink():
        if a.dry_run:
            print("  would link .claude/skills -> ../.agents/skills")
        else:
            cdir.mkdir(exist_ok=True)
            os.symlink("../.agents/skills", link)
            print("  link   .claude/skills -> ../.agents/skills")
    for r in registry():
        write(cdir / "commands" / f"csa-{r['verb']}.md", _slash_command(r))
    for name, (desc, body) in STATIC_COMMANDS.items():
        write(cdir / "commands" / f"{name}.md",
              f"---\ndescription: {desc}\n---\n\n{GEN_MARK}\n\n" + body.format(csa=CANON_AGENTS / "bin/csa") + "\n")

    print("Orientation files (repo root):")
    write(ROOT / "AGENTS.md", AGENTS_MD.format(mark=GEN_MARK))
    write(ROOT / "CLAUDE.md", f"{GEN_MARK}\n\n@AGENTS.md\n")

    if a.codex_prompts:
        home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "prompts"
        print(f"Codex custom prompts ({home}):")
        for r in registry():
            write(home / f"csa-{r['verb']}.md",
                  f"---\ndescription: {r['summary']}\nargument-hint: <{r.get('arg','SECTION').lower()}> [KEY=VALUE ...]\n---\n\n{GEN_MARK}\n\n"
                  f"Run `\"{CANON_AGENTS / 'bin/csa'}\" {r['verb']} $ARGUMENTS --print` in the shell and act exactly on the prompt it prints.\n")
    print(f"{len(written)} file(s) written." + ("" if a.codex_prompts else "  (add --codex-prompts to also write ~/.codex/prompts/csa-*.md)"))
    return 0

# ---------------------------------------------------------------- hosts
def cmd_hosts(a):
    """Host-centred view of the evidence: register, facts per host, host-to-host links."""
    p = project(a.project)
    argv = [a.action] + ([a.host] if a.host else []) + ["--work-dir", str(local_path(p["work_dir"])),
                                                        "--workspace", str(local_path(p["project_root"]))]
    if getattr(a, "dry_run", False):
        argv.append("--dry-run")
    if getattr(a, "all", False):
        argv.append("--all")
    if getattr(a, "fix", False):
        argv.append("--fix")
    if getattr(a, "question", None):
        argv += ["--question", a.question]
    if a.action == "system":
        argv += ["--project-key", p["key"], "--name", getattr(a, "name", None) or "system"]
    for x in a.attr or []:
        argv += ["--attr", x]
    if a.system:
        argv += ["--system", a.system]
    if a.json:
        argv.append("--json")
    return subprocess.call([framework_python(), "-m", "csa_docx.hostmodel", *argv], cwd=str(FRAMEWORK))


# ---------------------------------------------------------------- pipeline
def cmd_pipeline(a):
    """Take one section as far as it can go, stopping at every human gate."""
    p = project(a.project); banner(p)
    n = str(a.section)
    f = getattr(a, "file", None)
    d = label_display(n, f)                    # 6, or 6.4 for a subsection
    for _ in range(12):
        st = section_state(p, n, f)
        print(f"\n{C['b']}Section {d}: {st['stage']}{C['0']}")
        nxt = st["next"] or ""
        if not nxt:
            print("Nothing left to do for this section.")
            return 0
        if nxt.startswith("csa author"):
            started = time.time()
            if launch(p, agent("author"), [d], a) != 0:
                return 2
            if writer_pass_wanted([d], getattr(a, "no_writer", False)) and _writer_pass(p, [d], started, a) != 0:
                print("The writer pass failed; stopping before apply.")
                return 2
            continue                             # the change file is applied next, without an approval step
        if "approve" in nxt:
            print(f"Human gate: read {st['change_file']}")
            if not sys.stdin.isatty():
                return 0
            cmd_approve(argparse.Namespace(project=a.project, section=n, file=f, reject=[], force=False, revoke=False, yes=False, by=None))
            continue
        if nxt.endswith("--until-done"):
            ns = argparse.Namespace(project=a.project, section=n, allow_unapproved=False, agent=False, set=None, limit=a.limit,
                                    until_done=True, max_batches=a.max_batches, edit=None, json=False, agent_on_block=False,
                                    cli=a.cli, headless=a.headless, print=False, file=f, keep_open=False)
            if cmd_apply(ns) != 0:
                st = section_state(p, n, f)
                if st["apply_status"] == "BLOCKED":
                    launch(p, agent("apply"), [d], a)
                print(f"Stopped at apply ({st['apply_status']}). Check `csa status {d}`.")
                return 2
            continue
        if nxt.endswith("--agent"):
            launch(p, agent("apply"), [d], a)
            return 2
        if nxt.startswith("csa review"):
            launch(p, agent("review"), [d], a)
            st = section_state(p, n, f)
            metric(p, "review", n, result=st["review_result"], signoff=st["signoff"])
            if st["signoff"] != "YES":
                print(f"Review not signed off ({st['review_result']}). Stopping for a human look.")
                return 2
            continue
        if nxt.startswith("csa cleanup"):
            print(f"Human gate: open the working DOCX in Word and read the tracked changes for section {d}.")
            print(f"When you are satisfied, run: csa cleanup {d}")
            return 0
        print(f"Next step needs a human: {nxt}")
        return 2
    return 0


# ---------------------------------------------------------------- fleet (parallel headless workers)
FLEET_DIR = STATE_DIR / "fleet"
# Verbs without a `locks:` line in registry.yaml are treated as DOCX writers (the safe default).
DEFAULT_LOCKS = "docx, section"
DEPENDENT_LOCK_PREFIXES = ("section:", "analysis:")    # a failed task skips later tasks holding the same one


def _norm_section(v: str) -> str:
    v = (v or "").strip()
    m = re.fullmatch(r"(?i)(?:section\s*)?(\d+)", v)
    return m[1] if m else v.lower()


def task_values(r: dict, args: list[str]) -> dict:
    """The input values build_prompt uses: registry defaults, then the positional value, then KEY=VALUE."""
    values = {k: v for k, v, _ in parse_inputs(r.get("inputs", "")) if v is not None}
    positional = [x for x in args if "=" not in x and not x.startswith("-")]
    for x in args:
        if "=" in x:
            k, _, v = x.partition("=")
            values[k.strip().upper()] = v.strip()
    if positional:
        values[r.get("arg", "SECTION")] = " ".join(positional)
    return values


def task_locks(r: dict, values: dict) -> set[str]:
    """Resources a task holds while it runs. Two tasks sharing a lock never run at the same time.
    docx = the working DOCX, state = assessment-state.yaml, section = section:<N>, analysis = analysis:<skill>."""
    locks = set()
    for tok in [x.strip() for x in (r.get("locks") or DEFAULT_LOCKS).split(",") if x.strip()]:
        if tok == "section":
            if values.get("SECTION"):
                locks.add(f"section:{_norm_section(values['SECTION'])}")
        elif tok == "analysis":
            locks.add(f"analysis:{values.get('ANALYSIS_SKILL', '').strip().lower()}")
        else:
            locks.add(tok)
    return locks


def _docx_open_in_word(p: dict) -> bool:
    d = working_docx(p)
    return bool(d and any(d.parent.glob("~$*.docx")))


def _dur(sec: float) -> str:
    sec = int(sec)
    return f"{sec // 3600}h{sec % 3600 // 60:02d}m" if sec >= 3600 else f"{sec // 60}m{sec % 60:02d}s"


def _fleet_tasks(p: dict, a) -> list[dict]:
    texts = list(a.tasks or [])
    if a.file:
        f = Path(a.file).expanduser()
        if not f.is_file():
            die(f"task file not found: {f}")
        for raw in f.read_text(encoding="utf-8").splitlines():
            s = raw.strip()
            if s and not s.startswith("#"):
                texts.append(s)
    if not texts:
        die('no tasks. Example: csa fleet "author 6" "evidence 7"   (or -f tasks.txt, one task per line)')
    verbs = {r["verb"]: r for r in registry()}
    tasks = []
    for i, text in enumerate(texts, 1):
        toks = shlex.split(text)
        verb, args = toks[0], toks[1:]
        if verb == "convert":
            tasks.extend(_fleet_convert_tasks(p, a, i, text, args, verbs, len(tasks) + 1))
            continue
        if verb == "move":
            tasks.extend(_fleet_move_tasks(p, a, i, text, args, verbs, len(tasks) + 1))
            continue
        no_apply = "--no-apply" in args and verb != "apply"
        args = [x for x in args if x != "--no-apply"] if no_apply else args
        no_writer = "--no-writer" in args
        args = [x for x in args if x != "--no-writer"]
        force_writer = "--writer" in args
        args = [x for x in args if x != "--writer"]
        if verb == "place":
            if not args:
                die(f"task {i} '{text}': place needs a section file or number, e.g. \"place 3.4\"")
            tasks.append(_fleet_task(len(tasks) + 1, text, verb, args, {"docx", f"section:{_norm_section(args[0])}"}, None))
            continue
        if verb not in verbs:
            die(f"task {i} '{text}': unknown verb '{verb}'. `csa agents` lists them.")
        r = verbs[verb]
        if verb == "apply":
            # Framework-first apply (no LLM). The approval gate in cmd_apply still applies.
            if any(x in ("--agent", "--agent-on-block", "--allow-unapproved") for x in args):
                die(f"task {i} '{text}': --agent/--agent-on-block/--allow-unapproved are not allowed in a fleet. "
                    f"Run `csa apply {args[0] if args else 'N'} --agent` on its own.")
            sec = args[0] if args and not args[0].startswith("-") else None
            if not sec:
                die(f"task {i} '{text}': apply needs the section first, e.g. \"apply 6 --limit 2\"")
            values, prompt = {"SECTION": sec}, None
        elif verb == "author" and author_path(p, args, "--legacy" in args, "--cards" in args) == "cards":
            # the card path runs as one framework command (card, answer agent, render, writer, apply)
            values, prompt = task_values(r, [x for x in args if not x.startswith("-")]), None
            args = [x for x in args if x not in ("--legacy", "--cards")]
        else:
            args = [x for x in args if x != "--legacy"]
            values = task_values(r, args)
            fcli = settings().get("fleet_cli", "codex")
            prompt = build_prompt(p, r, args, local=local_launch(settings().get(f"{fcli}_fleet", "")))  # dies on a missing required input
        locks = task_locks(r, values)
        cards_task = verb == "author" and prompt is None
        if cards_task:
            locks |= {"docx"}
        tasks.append(_fleet_task(len(tasks) + 1, text, verb, args, locks, prompt))
        tasks[-1]["cards"] = cards_task
        tasks[-1]["no_apply"] = no_apply
        tasks[-1]["no_writer"] = no_writer
        tasks[-1]["force_writer"] = force_writer
    return tasks


def _fleet_convert_tasks(p: dict, a, i: int, text: str, args: list[str], verbs: dict, n0: int) -> list[dict]:
    """`convert N` in a fleet: brief and pre-pass run now (framework, no slot); the two agents become
    ordinary tasks on the section lock, then the usual `place N` follows the writer, and the ledger runs
    in-process after that place. Targets 7 and 5.1 are framework only: a `place` task."""
    if not args or args[0].startswith("-"):
        die(f"task {i} '{text}': convert needs a subsection, e.g. \"convert 3.4\"")
    target = args[0]
    ld = _convert_legacy(p)
    dry = bool(a.dry_run or a.print)
    if target in ("7", "5.1"):
        spec = target
        if not dry:
            res = _convert_call(p, ld, target)
            if res.get("status") != "PLACE":
                die(f"task {i} '{text}': {res.get('message') or res.get('status')}")
            spec = Path(res["file"]).name
        t = _fleet_task(n0, f"place {spec}", "place", [spec], {"docx", f"section:{_norm_section(spec)}"}, None)
        return [t]
    work = local_path(p["work_dir"])
    if dry:
        files = [str(work / "convert" / target / "brief.md")]
    else:
        res = _convert_call(p, ld, target, "brief")
        if res.get("status") == "EMPTY":
            print(f"{C['y']}convert {target}: nothing in the previous assessment maps here; no tasks added{C['0']}")
            return []
        pre = _convert_call(p, ld, target, "prepass")
        if pre.get("status") == "ERROR":
            die(f"task {i} '{text}': {pre.get('message')}")
        files = res["stages"]["brief"]["files"]
    out = []
    plan = [("evidence", [target, "MODE=convert", f"BRIEF={f}"]) for f in files] + \
           [("write", [target, "BRIEF=" + ";".join(files)])]
    for verb, vargs in plan:
        r = verbs[verb]
        fcli = settings().get("fleet_cli", "codex")
        prompt = build_prompt(p, r, vargs, local=local_launch(settings().get(f"{fcli}_fleet", "")))
        t = _fleet_task(n0 + len(out), f"{verb} {' '.join(vargs)}", verb, vargs, task_locks(r, task_values(r, vargs)), prompt)
        t["no_apply"] = False
        t["convert"] = target
        out.append(t)
    return out


def _fleet_move_tasks(p: dict, a, i: int, text: str, args: list[str], verbs: dict, n0: int) -> list[dict]:
    """`move N` in a fleet: the brief runs now (framework, no slot); the writer (MODE=move) becomes an
    ordinary task on the section lock, then `place N --plain` follows it and the records are written
    in-process after that. Targets 7, 5.1 and 8 are framework only: a plain `place` task."""
    if not args or args[0].startswith("-"):
        die(f"task {i} '{text}': move needs a subsection, e.g. \"move 3.4\"")
    target = args[0]
    ld = _convert_legacy(p)
    dry = bool(a.dry_run or a.print)
    if target in ("7", "5.1", "8"):
        spec = target
        if not dry:
            res = _move_generate(p, ld, target)
            if res.get("status") not in ("OK", "PLACE") or not res.get("file"):
                print(f"{C['y']}move {target}: {res.get('message') or 'nothing to place'}; no tasks added{C['0']}")
                return []
            spec = Path(res["file"]).name
        t = _fleet_task(n0, f"place {spec} --plain", "place", [spec, "--plain"],
                        {"docx", f"section:{_norm_section(spec)}"}, None)
        t["move"] = target
        return [t]
    work = local_path(p["work_dir"])
    if dry:
        files = [str(work / "move" / target / "brief.md")]
    else:
        res = _move_call(p, ld, target, "brief")
        if res.get("status") == "EMPTY":
            print(f"{C['y']}nothing mapped to {target}; no tasks added{C['0']}")
            return []
        if res.get("status") == "ERROR":
            die(f"task {i} '{text}': {res.get('message')}")
        files = res["stages"]["brief"]["files"]
    vargs = [target, "MODE=move", "BRIEF=" + ";".join(files)]
    r = verbs["write"]
    fcli = settings().get("fleet_cli", "codex")
    prompt = build_prompt(p, r, vargs, local=local_launch(settings().get(f"{fcli}_fleet", "")))
    t = _fleet_task(n0, f"write {' '.join(vargs)}", "write", vargs, task_locks(r, task_values(r, vargs)), prompt)
    t["no_apply"] = False
    t["move"] = target
    return [t]


def _fleet_task(n: int, text: str, verb: str, args: list[str], locks: set[str], prompt: str | None) -> dict:
    return {"n": n, "text": text, "verb": verb, "args": args, "locks": locks,
            "prompt": prompt, "status": "queued", "slot": None, "rc": None, "note": "",
            "start": None, "end": None, "log": None, "last": None}


def _fleet_follow_up(t: dict, n: int, p: dict | None = None) -> dict | None:
    """The framework step that changes the document after an agent task: an author task's change file
    is applied, a writer's section file is placed. None when the task changes nothing in the document."""
    if t["verb"] in ("apply", "place"):
        return None
    if t.get("cards"):
        return None                 # the card path already ran the writer pass and apply
    values = task_values(agent(t["verb"]), t["args"])
    spec = values.get("SECTION", "")
    if not spec or t.get("no_apply"):
        return None
    if t["verb"] == "author" and writer_pass_wanted(t["args"], t.get("no_writer", False)):
        # the writer rewrites the prose from the author's Facts; its own follow-up is the apply
        wargs = [spec, "MODE=records"]
        r = agent("write")
        prompt = None
        if p is not None:
            fcli = settings().get("fleet_cli", "codex")
            prompt = build_prompt(p, r, wargs, local=local_launch(settings().get(f"{fcli}_fleet", "")))
        return _fleet_task(n, f"write {spec} MODE=records", "write", wargs, task_locks(r, task_values(r, wargs)), prompt)
    if t["verb"] == "author" or (t["verb"] == "write" and values.get("MODE", "").lower() == "records"):
        return _fleet_task(n, f"apply {spec} --until-done", "apply", [spec, "--until-done"],
                           task_locks(agent("apply"), {"SECTION": spec}), None)
    if t["verb"] == "write" and values.get("MODE", "").lower() == "move":
        fu = _fleet_task(n, f"place {spec} --plain", "place", [spec, "--plain"],
                         {"docx", f"section:{_norm_section(spec)}"}, None)
        fu["move"] = t.get("move") or spec
        return fu
    if t["verb"] in ("write", "summary") and values.get("OUTPUT", "section-file") == "section-file":
        fu = _fleet_task(n, f"place {spec}", "place", [spec], {"docx", f"section:{_norm_section(spec)}"}, None)
        if t.get("convert"):
            fu["convert"] = t["convert"]
        return fu
    return None


def _fleet_argv(p: dict, t: dict, slot: str, cli: str) -> list[str]:
    if t.get("cards"):
        extra = [flag for flag, key in (("--no-apply", "no_apply"), ("--no-writer", "no_writer"), ("--writer", "force_writer"))
                 if t.get(key)]
        return [sys.executable, str(Path(__file__).resolve()), "--project", p["key"], "author", *t["args"], "--cards",
                "--headless", *extra]
    if t["verb"] == "place":
        return [sys.executable, str(Path(__file__).resolve()), "--project", p["key"], "place", *t["args"]]
    if t["verb"] == "apply":
        extra = [] if any(x in ("--until-done", "--edit") for x in t["args"]) else ["--until-done"]
        return [sys.executable, str(Path(__file__).resolve()), "--project", p["key"], "apply", *t["args"], *extra]
    cfg = settings()
    tmpl = cfg.get(f"{cli}_fleet") or cfg.get(f"{cli}_headless")
    if not tmpl:
        die(f"no '{cli}_fleet' or '{cli}_headless' command in .agents/cli.yaml")
    subs = {"{prompt}": t["prompt"], "{profile}": slot, "{last}": str(t["last"])}
    return [subs.get(x, x) for x in shlex.split(tmpl)]


def cmd_fleet(a):
    """Run independent tasks side by side: one headless CLI per slot, each exits when its task is done."""
    if os.environ.get("CSA_FLEET_SLOT"):
        die("already inside a fleet worker; a worker may not start another fleet.")
    p = project(a.project); banner(p)
    cfg = settings()
    cli = a.cli or os.environ.get("CSA_FLEET_CLI") or cfg.get("fleet_cli") or cfg.get("default_cli", "codex")
    slots = [s.strip() for s in (a.slots or os.environ.get("CSA_FLEET_SLOTS") or cfg.get("fleet_slots", "")).split(",") if s.strip()]
    if not slots:
        die("no fleet slots. Set 'fleet_slots:' in .agents/cli.yaml or pass --slots a,b")
    if len(set(slots)) != len(slots):
        die(f"duplicate slot names: {', '.join(slots)}")
    tasks = _fleet_tasks(p, a)
    local = {s.strip() for s in cfg.get("local_slots", "").split(",") if s.strip()}
    heavy = [t for t in tasks if t["verb"] != "place" and agent(t["verb"]).get("tier") == "frontier"] if local & set(slots) else []
    if heavy:
        print(f"{C['y']}warning: frontier-tier task(s) {', '.join(t['text'] for t in heavy)} will run on local slot(s) "
              f"{', '.join(s for s in slots if s in local)}. Expect weaker results; check them closely.{C['0']}")

    print(f"{C['b']}{len(tasks)} task(s) on {len(slots)} slot(s): {', '.join(slots)}  (cli: {cli}){C['0']}")
    for t in tasks:
        print(f"  {t['n']:>2}. {t['text']:<44} {C['d']}locks: {', '.join(sorted(t['locks'])) or '-'}{C['0']}")
    if a.print:
        for t in tasks:
            print(f"\n{C['b']}--- task {t['n']}: {t['text']}{C['0']}\n"
                  + (t["prompt"] or f"(framework, no LLM) {shlex.join(_fleet_argv(p, t, slots[0], cli)[2:])}"))
    if any(_fleet_follow_up(t, 0) for t in tasks if t["verb"] not in ("apply", "place")):
        print(f"{C['d']}After each write/summary task the fleet places its section file in the document (place N); "
              f"after each author task the writer rewrites its prose (write N MODE=records, skip with --no-writer), then the change file is applied (apply N). "
              f"No approval step: you approve in Word.{C['0']}")
    if a.dry_run or a.print:
        return 0

    if any(t["verb"] not in ("apply", "place") for t in tasks):
        exe = _fleet_argv(p, next(t for t in tasks if t["verb"] not in ("apply", "place")), slots[0], cli)[0]
        if not shutil.which(exe):
            die(f"'{exe}' is not on PATH (cli: {cli}).")

    run_dir = Path(a.log_dir).expanduser() if a.log_dir else FLEET_DIR / datetime.now().strftime("%Y%m%d-%H%M%S")
    run_dir.mkdir(parents=True, exist_ok=True)
    for t in tasks:
        stem = f"{t['n']:02d}-" + re.sub(r"[^A-Za-z0-9._-]+", "-", t["text"]).strip("-")[:60]
        t["log"], t["last"] = run_dir / f"{stem}.log", run_dir / f"{stem}.last.md"
        if t["prompt"]:
            (run_dir / f"{stem}.prompt.txt").write_text(t["prompt"] + "\n", encoding="utf-8")
    print(f"{C['d']}logs: {run_dir}{C['0']}\n")

    running: dict[str, tuple] = {}              # slot -> (task, Popen, file handle)
    timeout = a.timeout * 60 if a.timeout else None
    t0 = datetime.now()

    def say(msg: str):
        print(f"{C['d']}{datetime.now():%H:%M:%S}{C['0']} {msg}", flush=True)

    def skip_dependents(failed: dict):
        keys = {k for k in failed["locks"] if k.startswith(DEPENDENT_LOCK_PREFIXES)}
        for t in tasks:
            if t["status"] == "queued" and t["locks"] & keys:
                t["status"], t["note"] = "skipped", f"task {failed['n']} ({failed['text']}) did not succeed"
                say(f"{C['y']}skip{C['0']}  #{t['n']} {t['text']} - {t['note']}")
                skip_dependents(t)

    def pick():
        held = set().union(*(x[0]["locks"] for x in running.values())) if running else set()
        ahead: set[str] = set()                 # locks of earlier queued tasks: keeps per-section order
        for t in tasks:
            if t["status"] != "queued":
                continue
            if not (t["locks"] & held) and not (t["locks"] & ahead):
                return t
            ahead |= t["locks"]
        return None

    def start(t: dict, slot: str):
        if "docx" in t["locks"] and _docx_open_in_word(p):
            t["status"], t["note"] = "skipped", "working DOCX is open in Word (close it and re-run)"
            say(f"{C['y']}skip{C['0']}  #{t['n']} {t['text']} - {t['note']}")
            skip_dependents(t)
            return
        argv = _fleet_argv(p, t, slot, cli)
        shown = shlex.join(["<prompt>" if x == t["prompt"] else x for x in argv])
        fh = open(t["log"], "w", encoding="utf-8")
        fh.write(f"# csa fleet task {t['n']}: {t['text']}\n# slot: {slot}\n# started: {datetime.now():%Y-%m-%d %H:%M:%S}\n"
                 f"# command: {shown}\n\n")
        fh.flush()
        env = dict(os.environ, CSA_PROJECT=p["key"], CSA_FLEET_SLOT=slot, NO_COLOR="1")
        proc = subprocess.Popen(argv, cwd=str(ROOT), stdin=subprocess.DEVNULL, stdout=fh, stderr=subprocess.STDOUT, env=env)
        t.update(status="running", slot=slot, start=datetime.now())
        running[slot] = (t, proc, fh)
        say(f"{C['c']}start{C['0']} #{t['n']} {t['text']}  [{slot}]")

    def finish(slot: str, rc: int, note: str = ""):
        t, _, fh = running.pop(slot)
        fh.write(f"\n# finished: {datetime.now():%Y-%m-%d %H:%M:%S}  exit {rc}{('  ' + note) if note else ''}\n")
        fh.close()
        t.update(rc=rc, end=datetime.now(), status="done" if rc == 0 and not note else "failed", note=note or t["note"])
        _fleet_session_stats(p, t)
        colour = C["g"] if t["status"] == "done" else C["r"]
        say(f"{colour}{t['status']:<5}{C['0']} #{t['n']} {t['text']}  [{slot}] {_dur((t['end'] - t['start']).total_seconds())}"
            + (f" exit {rc}" if rc else "") + (f" - {note}" if note else ""))
        if t["status"] != "done":
            skip_dependents(t)
        elif t["verb"] == "evidence" and t.get("convert") and any(
                x is not t and x.get("convert") == t["convert"] and x["verb"] == "evidence"
                and x["status"] in ("queued", "running") for x in tasks):
            pass                                        # a split brief: check the plan after its last evidence task
        elif t["verb"] == "evidence" and t.get("convert"):
            pc = _convert_call(p, _convert_legacy(p), t["convert"], "plan-check")
            if pc.get("status") in ("FAILED", "ERROR"):
                errs = pc.get("findings", [])
                t["status"], t["note"] = "failed", f"plan-check: {pc.get('message') or str(len(errs)) + ' error(s) in answer-plan.csv'}"
                say(f"{C['r']}plan-check{C['0']} {t['convert']}: {t['note']}")
                skip_dependents(t)
            else:
                say(f"{C['c']}plan-check{C['0']} {t['convert']}: OK")
        elif t["verb"] == "place" and t.get("move"):
            if t["move"] in ("7", "5.1", "8"):
                say(f"{C['c']}moved{C['0']} {t['move']}")
            else:
                rec = _move_call(p, _convert_legacy(p), t["move"], "record").get("stages", {}).get("record", {})
                say(f"{C['c']}record{C['0']} {t['move']}: {rec.get('status')} {rec.get('blocks', 0)} block(s), "
                    f"{rec.get('open_items', 0)} open item(s)")
        elif t["verb"] == "place" and t.get("convert"):
            led = _convert_call(p, _convert_legacy(p), t["convert"], "ledger").get("stages", {}).get("ledger", {})
            say(f"{C['c']}ledger{C['0']} {t['convert']}: {led.get('status')} {json.dumps(led.get('counts', {}))}"
                + (f" missing {', '.join(led.get('missing', [])[:10])}" if led.get("missing") else ""))
        elif t["verb"] not in ("apply", "place"):
            fu = _fleet_follow_up(t, max(x["n"] for x in tasks) + 1, p)
            if fu:
                stem = f"{fu['n']:02d}-" + re.sub(r"[^A-Za-z0-9._-]+", "-", fu["text"]).strip("-")[:60]
                fu["log"], fu["last"] = run_dir / f"{stem}.log", run_dir / f"{stem}.last.md"
                tasks.insert(tasks.index(t) + 1, fu)      # before the section's later tasks (qa waits for it)
                say(f"{C['c']}queue{C['0']} #{fu['n']} {fu['text']}  (after #{t['n']})")

    try:
        while running or any(t["status"] == "queued" for t in tasks):
            for slot in slots:
                if slot not in running:
                    t = pick()
                    while t and t["status"] == "queued":
                        start(t, slot)
                        if t["status"] == "queued" or slot in running:
                            break
                        t = pick()
            if not running:
                if any(t["status"] == "queued" for t in tasks):
                    die("scheduler stalled: queued tasks but nothing running (report this)")
                break
            for slot, (t, proc, _) in list(running.items()):
                rc = proc.poll()
                if rc is not None:
                    finish(slot, rc)
                elif timeout and (datetime.now() - t["start"]).total_seconds() > timeout:
                    proc.terminate()
                    try:
                        proc.wait(15)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                    finish(slot, proc.wait(), f"timed out after {a.timeout:g} min")
            if running:
                time.sleep(1)
    except KeyboardInterrupt:
        print()
        say(f"{C['r']}interrupted{C['0']} - stopping {len(running)} running task(s)")
        for slot, (t, proc, _) in list(running.items()):
            proc.terminate()
            try:
                proc.wait(15)
            except subprocess.TimeoutExpired:
                proc.kill()
            finish(slot, proc.wait(), "interrupted")
        for t in tasks:
            if t["status"] == "queued":
                t["status"], t["note"] = "skipped", "fleet interrupted"

    print(f"\n{C['b']}Fleet finished in {_dur((datetime.now() - t0).total_seconds())}{C['0']}")
    for t in tasks:
        colour = {"done": C["g"], "failed": C["r"]}.get(t["status"], C["y"])
        dur = _dur((t["end"] - t["start"]).total_seconds()) if t["start"] and t["end"] else "-"
        print(f"  {t['n']:>2}. {colour}{t['status']:<7}{C['0']} {t['text']:<40} {t['slot'] or '-':<14} {dur:>7}"
              + (f"  {t['note']}" if t["note"] else ""))
        if t["last"] and t["last"].is_file():
            print(f"      {C['d']}result: {t['last']}{C['0']}")
    summary = [{k: (str(v) if isinstance(v, (Path, datetime)) else sorted(v) if isinstance(v, set) else v)
                for k, v in t.items() if k != "prompt"} for t in tasks]
    (run_dir / "summary.json").write_text(json.dumps({"project": p["key"], "cli": cli, "slots": slots, "tasks": summary},
                                                     indent=2), encoding="utf-8")
    print(f"{C['d']}logs and summary.json: {run_dir}{C['0']}")
    print("Next: check the results, then `csa status`. Human gates (csa approve) are never run by the fleet.")
    return 0 if all(t["status"] == "done" for t in tasks) else 1


# ---------------------------------------------------------------- build lane
def _fw_module_call(module: str, func: str, *args, **kwargs) -> dict:
    """Call csa_docx.<module>.<func> in the framework interpreter; JSON back."""
    code = (
        "import sys,json;sys.path.insert(0,sys.argv[1]);"
        f"from csa_docx import {module} as m;"
        "a=json.loads(sys.argv[3]);r=getattr(m,sys.argv[2])(*a['args'],**a['kwargs']);"
        "print(json.dumps(r,default=str))"
    )
    proc = subprocess.run([framework_python(), "-c", code, str(FRAMEWORK), func,
                           json.dumps({"args": list(args), "kwargs": kwargs})],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return {"status": "ERROR", "message": (proc.stderr or proc.stdout).strip()[-2000:]}
    try:
        return json.loads(proc.stdout.strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        return {"status": "ERROR", "message": proc.stdout[-2000:]}


def _select_section_files(p: dict, spec: str | None) -> list[dict]:
    """Resolve ``--sections`` (file names / order prefixes / 'all') to rows."""
    rows = section_rows(p)
    if not rows:
        die(f"no section files under {local_path(p['work_dir']) / 'sections'}; nothing to build.")
    if not spec or spec.strip().lower() in ("all", "*"):
        return rows
    names = [x.strip() for x in spec.split(",") if x.strip()]
    wanted: dict[str, str] = {}
    for n in names:
        for r in rows:
            if r["file"] == n or r["file"].split("-")[0] == n:
                wanted[r["file"]] = n
    if not wanted:
        die("no section file matches --sections " + spec + ".")
    missing = [n for n in names if n not in set(wanted.values())]
    matched = [r for r in rows if r["file"] in wanted]
    if missing:
        die("these --sections items match no section file: " + ", ".join(missing))
    return matched


def _approve_build_record(p: dict, cf: Path, build_id: str, section: str) -> None:
    """Approve one build change file exactly as
    ``csa approve N -y --by "csa build <id>"`` would: set the Status line and
    write the .approval.json with per-edit hashes."""
    text = cf.read_text(encoding="utf-8")
    m = STATUS_LINE_RE.search(text)
    if not m:
        die(f"no '**Status:**' line in {cf.name}; cannot approve the build record.")
    st_edits = list(dict.fromkeys(EDIT_HEADING_RE.findall(text)))
    if not st_edits:
        die(f"{cf.name} has no edits to approve.")
    who = f"csa build {build_id}"
    edits = ", ".join(st_edits)
    new = (f"**Status:** Approved for implementation {datetime.now():%Y-%m-%d %H:%M} "
           f"by {who}. Edits: {edits}.")
    cf.write_text(text[:m.start()] + new + text[m.end():], encoding="utf-8")
    af = approval_file(cf)
    af.write_text(json.dumps({"approved_at": datetime.now().isoformat(timespec="seconds"),
                              "by": who, "rejected": [],
                              "hashes": edit_record_hashes(cf.read_text(encoding="utf-8"))},
                             indent=2) + "\n", encoding="utf-8")
    metric(p, "approve", section, approved=st_edits, rejected=[], source="csa build")


def _run_checks(p: dict, docx: Path) -> list[dict]:
    """check_csa (errors fail the build), then prose/term/cross lints (warnings)."""
    results = []
    base = [framework_python()]
    root = local_path(p["project_root"])
    check = base + [str(SKILLS / "csa-document-template" / "scripts" / "check_csa.py"),
                    str(docx), "--workspace", str(root)]
    proc = subprocess.run(check, capture_output=True, text=True, cwd=str(FRAMEWORK))
    data = {}
    try:
        data = json.loads(proc.stdout)  # check_csa prints one indented JSON object
    except json.JSONDecodeError:
        pass
    counts = (data.get("counts") or {}) if isinstance(data, dict) else {}
    if not counts:
        # Unreadable output must never pass the gate silently.
        counts = {"errors": 1 if proc.returncode not in (0,) else 0, "warnings": 0}
    results.append({"check": "check_csa", "exit": proc.returncode,
                    "status": data.get("status") if isinstance(data, dict) else "UNREADABLE",
                    "errors": counts.get("errors", 0), "warnings": counts.get("warnings", 0),
                    "placeholders": counts.get("placeholders"),
                    "findings": [f"{f.get('level')} {f.get('code')}: {f.get('message')}"
                                 for f in (data.get("findings") or []) if f.get("level") in ("ERROR", "WARN")][:12]
                                if isinstance(data, dict) else []})
    for name, script in (
        ("prose_lint", SKILLS / "csa-writing-style" / "scripts" / "prose_lint.py"),
        ("term_lint", SKILLS / "australian-it-ot-terminology" / "scripts" / "term_lint.py"),
        ("cross_check", SKILLS / "csa-quality-review" / "scripts" / "cross_check.py"),
    ):
        if not script.is_file():
            results.append({"check": name, "exit": None, "warnings": 0})
            continue
        proc = subprocess.run([framework_python(), str(script), str(docx)],
                              capture_output=True, text=True, cwd=str(FRAMEWORK))
        warns = len([l for l in (proc.stdout + proc.stderr).splitlines()
                     if "WARN" in l.upper()])
        results.append({"check": name, "exit": proc.returncode, "warnings": warns})
    return results


def _write_build_report(p: dict, build_id: str, *, preview: bool, system_name: str,
                        rows: list[dict], result: dict, checks: list[dict]) -> Path:
    wd = local_path(p["work_dir"]) / "build"
    wd.mkdir(parents=True, exist_ok=True)
    out = wd / f"{build_id}.md"
    lines = [f"# Build report - {build_id}", "",
             f"- Mode: {'PREVIEW' if preview else 'real build'}",
             f"- System: {system_name}",
             f"- Built sections: " + (", ".join(str(x) for x in result["sections"]) or "none"),
             f"- Records: " + ", ".join(f"S{k}: {v}" for k, v in sorted(result["records"].items())),
             f"- Output: {result.get('preview_docx' if preview else 'docx')}", ""]
    lines += ["## Sections built", ""]
    for r in rows:
        lines.append(f"- {r['file']}  (block={r['block']}, heading={r['heading']})")
    lines += ["", "## Scaffold steps", ""]
    if result["scaffold"]:
        for e in result["scaffold"]:
            e = e.get("entry", e)  # run_scaffold returns {"entry": plan entry, "output": ...}
            lines.append(f"- {e.get('kind')} x{e.get('count')} under {e.get('heading')!r} "
                         f"(occurrence {e.get('occurrence')})")
    else:
        lines.append("- none (every count fit the template)")
    lines += ["", "## Checks", ""]
    for c in checks:
        if c["check"] == "check_csa":
            lines.append(f"- check_csa: {c.get('status')} "
                         f"({c.get('errors')} errors, {c.get('warnings')} warnings"
                         + (f", {c.get('placeholders')} placeholders left" if c.get('placeholders') is not None else "") + ")")
            lines += [f"  - {f}" for f in c.get("findings") or []]
        else:
            lines.append(f"- {c['check']}: exit={c.get('exit')} "
                         f"({c.get('warnings')} warnings)")
    lines += ["", "## Next steps", ""]
    if preview:
        lines += [
            "- Open the PREVIEW copy in Word and read it top to bottom.",
            "- To build for real: re-run `csa build --system-name "
            + system_name + "` once every selected section has a current READY review.",
            "",
        ]
    else:
        lines += [
            "- Open the working document in Word, press Ctrl+A then F9 to refresh fields and the TOC.",
            "- Accept, reject or edit each tracked change. Every one carries a Word "
            "comment listing its evidence IDs.",
        ]
        for s in result["sections"]:
            lines.append(f"- `csa review {s}` and `csa cleanup {s}` when you are done with section {s}.")
        lines += [
            "- Add the figures where the template left placeholders.",
            "- Issue v1.",
            "",
        ]
    out.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
    return out


def cmd_build(a):
    p = project(a.project); banner(p)
    build_id = datetime.now().strftime("%Y%m%d-%H%M%S")
    system_name = a.system_name or p.get("label") or p["key"]
    rows = _select_section_files(p, a.sections)
    root = local_path(p["project_root"])

    # --- Preconditions -------------------------------------------------------
    if not a.preview:
        existing = working_docx(p)
        if existing:
            die(f"this project already has a working DOCX ({existing.name}); "
                f"the build lane only creates the first draft (0.1); later rounds use the revise lane. Use the revise lane.")
        existing_cfs = change_files(p)
        if existing_cfs:
            die("this project already has reviews/ChangesCSA_* files; "
                f"the build lane only creates the first draft (0.1); later rounds use the revise lane. ({', '.join(sorted(str(c) for c in existing_cfs))})")
        for r in rows:
            if r["problem"]:
                die(f"cannot build {r['file']}: {r['problem']}. (Run `csa check-section {r['file']}`.)")
            rc = run_check_section(p, local_path(p["work_dir"]) / "sections" / r["file"],
                                   argparse.Namespace(no_lint=False, json=False))
            if rc != 0:
                die(f"cannot build {r['file']}: csa check-section reported errors (exit {rc}).")

    # --- Document work: prepare -> approve (real build) -> apply --------------
    fv = root / "01 Current State AS Built" / "01 Final Version"

    def rollback():
        """A failed real build leaves no working DOCX and no change files behind."""
        if a.preview:
            return
        for pattern in ("*.docx", "reviews/ChangesCSA_*", "run-state/*"):
            for f in fv.glob(pattern):
                if f.is_file():
                    f.unlink(missing_ok=True)

    section_paths = [str(local_path(p["work_dir"]) / "sections" / r["file"]) for r in rows]
    result = _fw_module_call("build", "prepare", str(root), section_paths,
                             system_name=system_name, build_id=build_id, preview=a.preview,
                             prepared_for=a.prepared_for, prepared_by=a.prepared_by,
                             doc_version=a.doc_version, status=a.status)
    if result.get("status") == "ERROR":
        rollback()
        die(f"build failed while preparing the document: {result.get('message')}")
    if not a.preview:
        try:
            for cf, s in zip(result["change_files"], result["sections"]):
                _approve_build_record(p, Path(cf), build_id, str(s))
        except SystemExit:
            rollback()
            raise
    applied = _fw_module_call("build", "apply", result["workspace"], result["sections"],
                              system_name=system_name, build_id=build_id, preview=a.preview,
                              root=str(root))
    if applied.get("status") == "ERROR":
        rollback()
        die(f"build failed while applying the records: {applied.get('message')}")
    result.update(applied)

    # --- Checks (real build) / light check (preview) ------------------------
    docx_path = Path(result.get("preview_docx" if a.preview else "docx") or result["docx"])
    checks = _run_checks(p, docx_path)  # a preview reports them; only a real build fails on check_csa errors
    if not a.preview:
        csa_err = next((c for c in checks if c["check"] == "check_csa"), {})
        if (csa_err.get("errors") or 0) > 0:
            # fail: remove partial DOCX and change files
            rollback()
            die(f"check_csa found {csa_err.get('errors')} errors; the build was rolled back.")

    report = _write_build_report(p, build_id, preview=a.preview, system_name=system_name,
                                 rows=rows, result=result, checks=checks)

    # --- Post real build: mark sections built + metric ----------------------
    if not a.preview:
        sd = local_path(p["work_dir"]) / "sections"
        for r in rows:
            f = sd / r["file"]
            text = f.read_text(encoding="utf-8")
            fm = section_front_matter(text)
            if "status" in fm and fm["status"] == "draft":
                text = text.replace("status: draft", "status: built", 1)
                text = text.replace("---", f"---\nbuild_id: {build_id}", 1)
            else:
                text = text.replace("---", f"---\nstatus: built\nbuild_id: {build_id}", 1)
            f.write_text(text, encoding="utf-8")
        metric(p, "build", section=None, build_id=build_id,
               sections=result["sections"], records=sum(result["records"].values()),
               preview=False)

    print(f"{C['g']}{'PREVIEW BUILT' if a.preview else 'BUILT'}{C['0']} "
          f"sections={result['sections']} records={sum(result['records'].values())}")
    print(f"  output: {docx_path}")
    print(f"  report: {report}")
    return 0


# ---------------------------------------------------------------- main
PASSTHROUGH = {
    "ev": cmd_ev, "appendix": cmd_appendix, "graph": cmd_graph, "index": cmd_index, "test": cmd_test,
    "spec": cmd_spec, "card": cmd_card,
    **{n: cmd_passthrough(n) for n in ("new", "scaffold", "table", "diagram", "dry-run", "cross-check", "findings")},
}

HELP = """
Project     csa projects | csa use <key> | csa agents | csa doctor
State       csa status [N] [--json] | csa next
Pipeline    csa author N  (applies its change file straight away) | csa review N | read in Word | csa cleanup N
            csa apply N [--until-done] | csa check-change N | csa approve N --reject E..  (optional: keep edits out)
            csa pipeline N            (walks one section, stops at every human gate)
Build lane  csa write <sec>  (places its section file in the document straight away) | csa place <file|sec>
            csa sections | csa check-section <file> | csa build [--preview] [--sections ..]   (spec: docs/build-lane-spec.md)
            --no-apply on author/write stops after the agent. The one approval is yours, in Word.
Move       csa move --prepare | N [--stage S] [--print] | --all | --status   (old-format CSA -> template as plain text)
Convert    csa convert --prepare | --map [N] | N [--stage S] [--print] | --status | --parked   (old-format CSA -> template)
Audit      csa audit | csa audit --status | csa audit-section SECTION=next | csa audit --report   (what the document is missing; read-only)
Parallel    csa fleet "author 6" "evidence 7" [-f tasks.txt] [--dry-run] [--print] [--timeout MIN]
            (one headless worker per slot in cli.yaml; DOCX steps never overlap)
Analysis    csa ask <section> | evidence | gaps | analyse <skill> [SECTION=..] | write | summary | qa
Framework   csa prepare | csa lookup "<text>" | csa validate N | csa refresh | csa brief N | csa author-report N | csa test | csa mcp
Integrate   csa sync [--codex-prompts]   (wrapper skills, /csa-* slash commands, AGENTS.md from registry.yaml)
Scripts     csa ev lookup "<q>" | csa index rows|search|hosts|tables|build ... | csa graph ... | csa lint [N] | csa check [--final] | csa new ... | csa scaffold ...
            csa table ... | csa diagram ... | csa dry-run ... | csa appendix [--out f.md]
            csa cross-check <docx|md> [--hosts-file f] | csa findings <docx|md>   (arguments pass straight through;
            put -p <key> before the command: csa -p utcdtc ev stats)
Agent opts  KEY=VALUE overrides (EDIT_MODE=editorial, ITERATION_EDIT_LIMIT=4), --cli codex|claude|hermes,
            --headless, --print (just show the prompt), --project <key>
"""


# ---------------------------------------------------------------- convert (old-format CSA -> template)
CONVERT_STAGES = ("brief", "prepass", "evidence", "plan-check", "write", "ledger")


def _convert_legacy(p: dict) -> Path:
    ld = legacy_docx(p)
    if not ld:
        die(f"project '{p['key']}' has no legacy_docx. Add `legacy_docx: \"<path to the old CSA .docx>\"` "
            "to its entry in .agents/csa-context/PROJECTS.yaml")
    if not ld.is_file():
        die(f"legacy document not found: {ld}")
    return ld


def _convert_fw(func: str, *args, **kwargs):
    return _fw_module_call("convert", func, *args, **kwargs)


def _convert_call(p: dict, ld: Path, target: str, stage: str | None = None) -> dict:
    return _convert_fw("convertOldTemplateToNew", target, workspace=_ws(p), legacy_docx=str(ld), stage=stage)


def _convert_briefs(p: dict, target: str) -> list[str]:
    d = local_path(p["work_dir"]) / "convert" / target
    files = sorted(d.glob("brief*.md"), key=lambda f: (0, 0) if f.name == "brief.md"
                   else (1, int(re.sub(r"\D", "", f.stem) or 0)))
    return [str(f) for f in files]


def _convert_csv(path: Path) -> list[dict]:
    if not path.is_file():
        return []
    import csv as _csv
    with path.open(newline="", encoding="utf-8-sig") as fh:
        return list(_csv.DictReader(fh))


def _convert_print(p: dict, target: str) -> int:
    work = local_path(p["work_dir"])
    brief = work / "convert" / target / "brief.md"
    print(f"{C['b']}csa convert {target}{C['0']}  (plan only; nothing is run or written)")
    print(f"  1. brief      framework   python -m csa_docx.convert --section {target} --stage brief   -> {brief}")
    print(f"  2. prepass    framework   one evidence row per legacy fact of {target}")
    print(f"  3. prepare    framework   only when the stable-ID manifest is older than the working document")
    print(f"  4. evidence   agent       csa evidence {target} MODE=convert BRIEF={brief}   (writes convert/{target}/answer-plan.csv)")
    print(f"  5. plan-check framework   python -m csa_docx.answer_plan convert/{target}/answer-plan.csv --target {target}")
    print(f"  6. write      agent       csa write {target} BRIEF={brief}   (places the section file as tracked changes)")
    print(f"  7. ledger     framework   every requirement answered and every candidate fact accounted for; then Appendix E rows from the plan's gaps")
    print(f"{C['d']}Targets 7 and 5.1 need no agents. A split brief adds one evidence command per file and lists all files in BRIEF=.{C['0']}")
    return 0


def _convert_agent(p: dict, a, verb: str, args: list[str]) -> int:
    cmd = [sys.executable, str(Path(__file__).resolve()), "--project", p["key"], verb, *args, "--headless"]
    if getattr(a, "cli", None):
        cmd += ["--cli", a.cli]
    print(f"{C['d']}$ csa {verb} {' '.join(args)}{C['0']}")
    return subprocess.call(cmd, cwd=str(ROOT))


def _convert_prepare_if_stale(p: dict) -> None:
    d = working_docx(p)
    if not d:
        return
    m = _live_manifest(p)
    if m is None or m.stat().st_mtime < d.stat().st_mtime:
        print(f"{C['d']}stable-ID manifest is stale: running prepare{C['0']}")
        fw_call("prepareDocument", workspace=_ws(p))


def _convert_report_ledger(p: dict, ld: Path, target: str, res: dict) -> int:
    counts = res.get("counts", {})
    if res.get("mode") == "requirement":
        if res.get("status") == "COMPLETE":
            print(f"{C['g']}{target} converted:{C['0']} {counts.get('ANSWERED', 0)} requirements answered, "
                  f"{counts.get('ACCOUNTED', 0)} candidate fact groups accounted for.")
        else:
            inc, miss = res.get("incomplete_requirements", []), res.get("missing", [])
            print(f"{C['y']}{target} INCOMPLETE:{C['0']} " + (f"requirements not answered: {', '.join(inc)}. " if inc else "")
                  + (f"{len(miss)} fact group(s) not in the answer plan: {', '.join(miss[:15])}" if miss else "")
                  + ("" if res.get("status") != "NO_SECTION_FILE" else " (no section file yet)"))
            print(f"  fix convert/{target}/answer-plan.csv or the section file, then `csa convert {target} --stage ledger`; "
                  f"see {local_path(p['work_dir']) / 'convert' / target / 'ledger.csv'}")
    elif res.get("status") == "COMPLETE" or res.get("status") == "OK":
        left = counts.get("DUPLICATE", 0) + counts.get("NOT_USED", 0)
        print(f"{C['g']}{target} converted:{C['0']} {counts.get('USED', 0)} facts used, {counts.get('SUPERSEDED', 0)} superseded, "
              f"{counts.get('MOVED', 0)} moved (re-mapped), {left} left out.")
    else:
        missing = res.get("missing", [])
        print(f"{C['y']}{target} INCOMPLETE:{C['0']} {len(missing)} legacy block(s) have no outcome: {', '.join(missing[:20])}"
              + (" ..." if len(missing) > 20 else ""))
        print(f"  rerun `csa convert {target} --stage write`, or add lines (id,outcome,target,reason) to "
              f"{local_path(p['work_dir']) / 'convert' / target / 'outcomes.csv'}, then `csa convert {target} --stage ledger`")
    if res.get("moved"):
        print(f"{C['d']}{len(res['moved'])} block(s) moved to another subsection: re-mapping{C['0']}")
        _convert_fw("prepare", _ws(p), str(ld))
    return 0 if res.get("status") in ("COMPLETE", "OK") else 1


def _convert_run(p: dict, a, ld: Path, target: str) -> int:
    stage = a.stage
    wanted = CONVERT_STAGES if stage is None else (stage,)

    if target in ("7", "5.1"):                      # glossary and coverage: framework only
        res = _convert_call(p, ld, target, stage)
        print(f"{C['b']}[convert {target}]{C['0']} {res.get('status')}")
        for name, r in res.get("stages", {}).items():
            print(f"  {name}: {r.get('status')}" + (f" {r['file']}" if r.get("file") else ""))
        if res.get("status") == "PLACE" and not getattr(a, "no_apply", False):
            rc = cmd_place(argparse.Namespace(project=a.project, targets=[Path(res["file"]).name], system_name=None,
                                              prepared_for=None, prepared_by=None, doc_version=None, status=None,
                                              keep_open=False))
            if rc:
                return rc
        if res.get("status") in ("ERROR", "FAILED"):
            print(res.get("message", ""), file=sys.stderr)
            return 2
        led = res.get("stages", {}).get("ledger")
        return _convert_report_ledger(p, ld, target, led) if led else 0

    briefs: list[str] = []
    for name in wanted:
        if name == "brief":
            res = _convert_call(p, ld, target, "brief")
            b = res.get("stages", {}).get("brief", {})
            print(f"{C['b']}[brief]{C['0']} {res.get('status')}  {', '.join(b.get('files', []))}")
            if res.get("status") == "EMPTY":
                print(f"nothing in the previous assessment maps to {target}. See `csa convert --map`.")
                return 0
            briefs = b.get("files", [])
        elif name == "prepass":
            res = _convert_call(p, ld, target, "prepass")
            pp = res.get("stages", {}).get("prepass", {})
            if res.get("status") == "ERROR":
                die(f"prepass: {res.get('message') or pp.get('message')}")
            print(f"{C['b']}[prepass]{C['0']} {len(pp.get('appended', []))} evidence rows added, "
                  f"{len(pp.get('skipped', []))} already there, {len(pp.get('rejected', []))} rejected")
            for rj in pp.get("rejected", []):
                print(f"  rejected {rj['id']}: {rj['reason']}")
        elif name == "evidence":
            briefs = briefs or _convert_briefs(p, target) or \
                _convert_call(p, ld, target, "brief").get("stages", {}).get("brief", {}).get("files", [])
            if not briefs:
                die(f"no brief for {target}; run `csa convert {target} --stage brief`")
            _convert_prepare_if_stale(p)
            for f in briefs:
                rc = _convert_agent(p, a, "evidence", [target, "MODE=convert", f"BRIEF={f}"])
                if rc:
                    print(f"{C['r']}[evidence] failed (exit {rc}); stopping{C['0']}")
                    return rc
            print(f"{C['b']}[evidence]{C['0']} done")
        elif name == "plan-check":
            res = _convert_call(p, ld, target, "plan-check")
            pc = res.get("stages", {}).get("plan-check", {})
            print(f"{C['b']}[plan-check]{C['0']} {pc.get('status') or res.get('status')}"
                  + (f"  {pc.get('warnings', 0)} warning(s)" if pc.get("status") == "OK" else ""))
            if res.get("status") in ("FAILED", "ERROR"):
                print(res.get("message", ""), file=sys.stderr)
                for f in res.get("findings", []):
                    print(f"  {f['code']:<24} row {f['row']:<3} {f['message']}", file=sys.stderr)
                print(f"  fix convert/{target}/answer-plan.csv (or rerun `csa convert {target} --stage evidence`)", file=sys.stderr)
                return 2
        elif name == "write":
            briefs = briefs or _convert_briefs(p, target) or \
                _convert_call(p, ld, target, "brief").get("stages", {}).get("brief", {}).get("files", [])
            if not briefs:
                die(f"no brief for {target}; run `csa convert {target} --stage brief`")
            extra = ["--no-apply"] if getattr(a, "no_apply", False) else []
            rc = _convert_agent(p, a, "write", [target, "BRIEF=" + ";".join(briefs), *extra])
            if rc:
                print(f"{C['r']}[write] failed (exit {rc}); stopping{C['0']}")
                return rc
            print(f"{C['b']}[write]{C['0']} done")
        elif name == "ledger":
            res = _convert_call(p, ld, target, "ledger")
            led = res.get("stages", {}).get("ledger", {})
            print(f"{C['b']}[ledger]{C['0']} {led.get('status')}  {json.dumps(led.get('counts', {}))}")
            dr = res.get("stages", {}).get("discovery-required")
            if dr:
                print(f"{C['b']}[discovery-required]{C['0']} {dr.get('status')}  {dr.get('items', 0)} item(s)  {dr.get('file', '')}")
                if dr.get("status") == "OK" and not getattr(a, "no_apply", False):
                    cmd_place(argparse.Namespace(project=a.project, targets=[Path(dr["file"]).name], system_name=None,
                                                 prepared_for=None, prepared_by=None, doc_version=None, status=None,
                                                 keep_open=False))
            return _convert_report_ledger(p, ld, target, led)
    return 0


def _convert_next(row: dict) -> str:
    t = row["target"]
    if row["ledger"] == "COMPLETE":
        return "review in Word"
    if row["ledger"] == "INCOMPLETE":
        return f"csa convert {t} --stage write (or add outcomes.csv lines)"
    if row["section_file"]:
        return f"csa convert {t} --stage ledger"
    return f"csa convert {t}"


def template_target(t: str) -> str:
    """A convert/move target given as a heading, requirement family or key -> the template number (folders keep it)."""
    if not t or re.fullmatch(r"\d+(\.\d+)*", str(t)):
        return t
    r = subprocess.run([framework_python(), "-c", "import sys;from csa_docx import targets as T;print(T.canonical(sys.argv[1]))", t],
                       cwd=str(FRAMEWORK), capture_output=True, text=True, env=_fw_env())
    out = r.stdout.strip()
    if r.returncode or not re.fullmatch(r"\d+(\.\d+)*", out):
        die(f"no template section matches '{t}'")
    print(f"{C['d']}{t} -> {out}{C['0']}", file=sys.stderr)
    return out


def cmd_convert(a):
    p = project(a.project); banner(p)
    if getattr(a, "target", None):
        a.target = template_target(a.target)
    if a.print and a.target:
        return _convert_print(p, a.target)
    chosen = [bool(a.prepare), a.map is not None, bool(a.status), bool(a.parked), bool(a.audit), bool(a.target)]
    if sum(chosen) != 1:
        die("usage: csa convert --prepare | --map [N] | --audit | N [--stage S] [--print] [--no-apply] | --status | --parked")
    ld = _convert_legacy(p)
    work = local_path(p["work_dir"])
    if a.prepare:
        res = _convert_fw("prepare", _ws(p), str(ld))
        if res.get("status") != "OK":
            print(res.get("message", res), file=sys.stderr)
            return 2
        m = res["map"]
        print(f"{C['g']}prepared{C['0']} {ld.name}: {m['blocks']} blocks, {m['mapped']} mapped, {m['unmapped']} unmapped, "
              f"{m['low_confidence']} low confidence; {res['parked']} parked, {res['figures']} figures")
        print(f"  map report: {work / 'legacy' / 'map-report.md'}")
        print(f"  overrides:  {work / 'legacy' / 'legacy-map.csv'}  (checked before the defaults)")
        return 0
    if a.map is not None:
        report = work / "legacy" / "map-report.md"
        rows = _convert_csv(work / "legacy" / "map.csv")
        if not rows:
            die("no map yet; run `csa convert --prepare`")
        if not a.map:
            print(report.read_text(encoding="utf-8"), end="")
            return 0
        blocks = {}
        for line in (work / "legacy" / "blocks.jsonl").read_text(encoding="utf-8").splitlines():
            if line.strip():
                b = json.loads(line)
                blocks[b["id"]] = b
        hits = [r for r in rows if r["target"] == a.map]
        for r in hits:
            print(f"{r['id']}  {r['job']:<13} {r['rule']:<15} {r['confidence']:<7} {r['path']}  |  "
                  f"{blocks.get(r['id'], {}).get('text', '')[:80]}")
        if not hits:
            print(f"no block maps to {a.map}")
        return 0
    if a.status:
        rows = _convert_fw("status", _ws(p))
        if not rows:
            print("nothing mapped yet; run `csa convert --prepare`")
            return 0
        print(f"{'target':<8}{'blocks':>7}{'evidence':>9}  {'reqs':<7}{'DR':>3}  {'brief':<6}{'section file':<14}{'ledger':<12}next")
        for r in rows:
            print(f"{r['target']:<8}{r['blocks']:>7}{r['evidence_rows']:>9}  {r.get('requirements') or '-':<7}"
                  f"{r.get('dr_items', 0):>3}  {'yes' if r['brief'] else '-':<6}"
                  f"{r['section_file'] or '-':<14}{r['ledger'] or '-':<12}{_convert_next(r)}")
        return 0
    if a.audit:
        md = work / "convert" / "requirement-audit.md"
        if not (md.is_file() and "<!-- keep -->" in md.read_text(encoding="utf-8")):
            res = _fw_module_call("requirement_audit", "audit", str(work))
            if res.get("status") != "OK":
                die(f"audit failed: {res.get('message', res)}")
        if not md.is_file():
            die("no audit; run `csa convert --prepare`")
        print(md.read_text(encoding="utf-8"), end="")
        return 0
    if a.parked:
        pk = _fw_module_call("convert_ledger", "write_parked", str(work))
        fg = _fw_module_call("convert_ledger", "write_figures", str(work))
        print(f"{pk.get('parked', 0)} parked block(s): {work / 'convert' / 'parked.md'}")
        print(f"{fg.get('figures', 0)} figure(s): {work / 'convert' / 'figures.md'}")
        return 0
    return _convert_run(p, a, ld, a.target)


# ---------------------------------------------------------------- move (old-format CSA -> template, plain text)
MOVE_STAGES = ("brief", "write", "insert", "record")
MOVE_GENERATED = ("7", "5.1", "8")          # no writer agent: generated from the map or the open items


def _move_call(p: dict, ld: Path, target: str, stage: str | None = None) -> dict:
    return _fw_module_call("move", "move", target, workspace=_ws(p), legacy_docx=str(ld), stage=stage)


def _move_generate(p: dict, ld: Path, target: str) -> dict:
    """The section file of target 7 (glossary), 5.1 (coverage) or 8 (Discovery Required, from the open items)."""
    if target == "8":
        return _fw_module_call("move_record", "section8", _ws(p))
    res = _move_call(p, ld, target, "write")
    w = res.get("stages", {}).get("write", {})
    return {"status": res.get("status") if res.get("status") != "OK" else w.get("status", "OK"),
            "file": w.get("file"), "message": res.get("message", "")}


def _move_place(p: dict, a, name: str) -> int:
    """Insert one section file as plain text (same checks as `csa place`)."""
    return cmd_place(argparse.Namespace(project=a.project, targets=[name], system_name=None, prepared_for=None,
                                        prepared_by=None, doc_version=None, status=None,
                                        keep_open=getattr(a, "keep_open", False), plain=True))


def _move_print(p: dict, target: str) -> int:
    work = local_path(p["work_dir"])
    brief = work / "move" / target / "brief.md"
    print(f"{C['b']}csa move {target}{C['0']}  (plan only; nothing is run or written)")
    if target in MOVE_GENERATED:
        what = {"7": "the glossary from the mapped old terms", "5.1": "Discovery Coverage from the discovery index",
                "8": "Discovery Required from csa-work/move/open-items.csv"}[target]
        print(f"  1. write      framework   {what}; no agent")
        print(f"  2. insert     framework   csa place <section file> --plain")
        if target != "8":
            print(f"  3. record     framework   moved.csv, open-items.csv, convert/parked.md")
        return 0
    print(f"  1. brief      framework   python -m csa_docx.move --section {target} --stage brief   -> {brief}")
    print(f"  2. write      agent       csa write {target} MODE=move BRIEF={brief} --headless --no-apply   (writes the section file)")
    print(f"  3. insert     framework   csa place <section file> --plain   (structure check, plain text, Rating left empty)")
    print(f"  4. record     framework   {work / 'move' / 'moved.csv'}, {work / 'move' / 'open-items.csv'}, {work / 'convert' / 'parked.md'}")
    print(f"{C['d']}A split brief lists all its files in BRIEF=. Section 8 is built from the open items by `csa move 8`.{C['0']}")
    return 0


def _move_run(p: dict, a, ld: Path, target: str, stage: str | None) -> int:
    if stage is not None and stage not in MOVE_STAGES:
        die(f"unknown stage {stage!r}; use one of {', '.join(MOVE_STAGES)}")
    wanted = MOVE_STAGES if stage is None else (stage,)
    work = local_path(p["work_dir"])

    if target in MOVE_GENERATED:
        res = _move_generate(p, ld, target) if "write" in wanted else {"status": "OK"}
        if "write" in wanted:
            if res.get("status") == "EMPTY":
                print(f"nothing mapped to {target}")
                return 0
            print(f"{C['b']}[write]{C['0']} {res.get('status')}  {res.get('file') or ''}")
            if res.get("status") not in ("OK", "PLACE") or not res.get("file"):
                print(res.get("message", ""), file=sys.stderr)
                return 2
        if "insert" in wanted:
            name = Path(res["file"]).name if res.get("file") else None
            if not name:
                found = _fw_module_call("move_record", "section_path", _ws(p), target)
                name = Path(found).name if found else None
            if not name:
                die(f"no section file for {target}; run `csa move {target} --stage write`")
            rc = _move_place(p, a, name)
            if rc:
                return rc
        if "record" in wanted and target != "8":
            rec = _move_call(p, ld, target, "record").get("stages", {}).get("record", {})
            print(f"{C['b']}[record]{C['0']} {rec.get('blocks', 0)} block(s), {rec.get('open_items', 0)} open item(s)")
        return 0

    briefs: list[str] = []
    for name in wanted:
        if name == "brief":
            res = _move_call(p, ld, target, "brief")
            if res.get("status") == "ERROR":
                die(res.get("message", "brief failed"))
            b = res.get("stages", {}).get("brief", {})
            if res.get("status") == "EMPTY":
                print(f"nothing mapped to {target}")
                return 0
            briefs = b.get("files", [])
            print(f"{C['b']}[brief]{C['0']} {b.get('blocks', 0)} block(s)  {', '.join(briefs)}")
        elif name == "write":
            if not briefs:
                briefs = sorted(str(f) for f in (work / "move" / target).glob("brief*.md")) or \
                    _move_call(p, ld, target, "brief").get("stages", {}).get("brief", {}).get("files", [])
            if not briefs:
                print(f"nothing mapped to {target}")
                return 0
            rc = _convert_agent(p, a, "write", [target, "MODE=move", "BRIEF=" + ";".join(briefs), "--no-apply"])
            if rc:
                print(f"{C['r']}[write] failed (exit {rc}); stopping{C['0']}")
                return rc
            print(f"{C['b']}[write]{C['0']} done")
        elif name == "insert":
            found = _fw_module_call("move_record", "section_path", _ws(p), target)
            if not found:
                die(f"no section file for {target}; run `csa move {target} --stage write`")
            rc = _move_place(p, a, Path(found).name)
            if rc:
                return rc
        elif name == "record":
            res = _move_call(p, ld, target, "record")
            rec = res.get("stages", {}).get("record", {})
            if res.get("status") != "OK":
                print(f"{C['r']}[record] {res.get('message') or res.get('status')}{C['0']}", file=sys.stderr)
                return 2
            print(f"{C['b']}[record]{C['0']} {rec.get('blocks', 0)} block(s) moved, {rec.get('open_items', 0)} open item(s)")
    return 0


def _move_all(p: dict, a, ld: Path) -> int:
    work = local_path(p["work_dir"])
    targets = _fw_module_call("move", "order", _ws(p))
    if not isinstance(targets, list) or not targets:
        print("nothing mapped yet; run `csa move --prepare`")
        return 0
    queue = [t for t in targets if t not in ("8", "2.1")] + ["8"] + (["2.1"] if "2.1" in targets else [])
    done = 0
    for t in queue:
        print(f"\n{C['b']}=== csa move {t} ==={C['0']}")
        if t == "8" and not _convert_csv(work / "move" / "open-items.csv"):
            print("no open items: Section 8 not needed")
            continue
        try:
            rc = _move_run(p, a, ld, t, None)
        except SystemExit as e:
            rc = e.code if isinstance(e.code, int) else 1
        if rc:
            print(f"{C['r']}csa move {t} failed (exit {rc}); stopping. Fix it, then `csa move {t}` and `csa move --all` again.{C['0']}")
            return rc
        done += 1
    items = _convert_csv(work / "move" / "open-items.csv")
    print(f"\n{C['g']}moved {done} subsection(s){C['0']}; {len(items)} open item(s) in {work / 'move' / 'open-items.csv'}")
    return 0


def cmd_move(a):
    p = project(a.project); banner(p)
    if getattr(a, "target", None):
        a.target = template_target(a.target)
    if a.print and a.target:
        return _move_print(p, a.target)
    chosen = [bool(a.prepare), bool(a.all), bool(a.status), bool(a.target)]
    if sum(chosen) != 1:
        die("usage: csa move --prepare | N [--stage S] [--print] | --all | --status")
    ld = _convert_legacy(p)
    work = local_path(p["work_dir"])
    if a.prepare:
        res = _fw_module_call("move", "move_prepare", _ws(p), str(ld))
        if res.get("status") != "OK":
            print(res.get("message", res), file=sys.stderr)
            return 2
        m = res["map"]
        print(f"{C['g']}prepared{C['0']} {ld.name}: {m['blocks']} blocks, {m['mapped']} mapped, {m['unmapped']} unmapped, "
              f"{m['low_confidence']} low confidence; {res['parked']} parked, {res['figures']} figures")
        print(f"  map report: {work / 'legacy' / 'map-report.md'}")
        print(f"  overrides:  {work / 'legacy' / 'legacy-map.csv'}  (checked before the defaults)")
        return 0
    if not (work / "legacy" / "map.csv").is_file():
        die("no map yet; run `csa move --prepare`")
    if a.status:
        rows = _fw_module_call("move", "status", _ws(p))
        if not isinstance(rows, list) or not rows:
            print("nothing mapped yet; run `csa move --prepare`")
            return 0
        print(f"{'target':<8}{'blocks':>7}  {'section file':<14}{'placed':<18}{'open items':>10}")
        for r in rows:
            print(f"{r['target']:<8}{r['blocks']:>7}  {r['section_file'] or '-':<14}{r['placed'] or '-':<18}{r['open_items']:>10}")
        return 0
    if a.all:
        return _move_all(p, a, ld)
    return _move_run(p, a, ld, a.target, a.stage)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="csa", description="CSA agents, skills and framework.", epilog=HELP,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--project", "-p", help="project key (default: `csa use` / $CSA_PROJECT)")
    sub = ap.add_subparsers(dest="cmd")

    def sp(name, fn, **kw):
        s = sub.add_parser(name, **kw)
        s.add_argument("--project", "-p", default=argparse.SUPPRESS)
        s.set_defaults(fn=fn)
        return s

    def agent_opts(s):
        s.add_argument("--cli", choices=["codex", "claude", "hermes"])
        s.add_argument("--headless", action="store_true")
        s.add_argument("--print", action="store_true", help="print the prompt instead of launching")

    sp("help", lambda a: print(HELP))
    sp("projects", cmd_projects)
    s = sp("use", cmd_use); s.add_argument("key")
    sp("agents", cmd_agents)
    s = sp("scope", cmd_scope, help="one domain's entry from the section scope map"); s.add_argument("key")
    s.add_argument("--json", action="store_true")
    s = sp("brief", cmd_brief, help="the section brief skeleton for an author run (scope map + reviewer comments)"); s.add_argument("section")
    s = sp("budget", cmd_budget, help="tokens each agent loads before it starts"); s.add_argument("verb", nargs="?")
    s.add_argument("--max", type=int, default=None); s.add_argument("--json", action="store_true")
    s = sp("doctor", cmd_doctor); s.add_argument("--no-tests", dest="tests", action="store_false", help="skip the framework test run")
    s = sp("status", cmd_status); s.add_argument("section", nargs="?"); s.add_argument("--json", action="store_true")
    s = sp("next", cmd_next); s.add_argument("--json", action="store_true")
    s = sp("report", cmd_report); s.add_argument("--json", action="store_true")
    s = sp("prepare", cmd_prepare); s.add_argument("--force", action="store_true"); s.add_argument("--section"); s.add_argument("--json", action="store_true")
    s = sp("lookup", cmd_lookup); s.add_argument("query"); s.add_argument("--kind", choices=["paragraph", "table_row", "heading"]); s.add_argument("--json", action="store_true")
    s = sp("validate", cmd_validate); s.add_argument("section"); s.add_argument("--json", action="store_true")
    s = sp("refresh", cmd_refresh); s.add_argument("--json", action="store_true")
    s = sp("approve", cmd_approve, help="optional: mark edits REJECTED before apply (apply records the approval itself)")
    s.add_argument("section"); s.add_argument("--by")
    s.add_argument("--yes", "-y", action="store_true"); s.add_argument("--revoke", action="store_true")
    s.add_argument("--force", action="store_true", help="approve even if csa check-change reports errors")
    s.add_argument("--reject", nargs="+", default=[], metavar="EDIT_ID", help="mark these edits REJECTED; they are never applied")
    s.add_argument("--file", help="a labelled change file for this section, e.g. story for ChangesCSA_<App>_Section<N>_story.md")
    s = sp("audit", cmd_audit, help="audit the working DOCX for what it is missing (scripted stage, --status, --report)")
    s.add_argument("--report", action="store_true"); s.add_argument("--status", action="store_true"); s.add_argument("--id")
    s = sp("comments", cmd_comments, help="list the reviewer comments in the working DOCX, optionally under one heading")
    s.add_argument("--heading"); s.add_argument("--json", action="store_true")
    s = sp("check-change", cmd_check_change, help="check a section's change file before approval")
    s.add_argument("section"); s.add_argument("--no-anchors", action="store_true"); s.add_argument("--file", help="a labelled change file for this section, e.g. story for ChangesCSA_<App>_Section<N>_story.md")
    s.add_argument("--no-lint", action="store_true"); s.add_argument("--json", action="store_true")
    s.add_argument("--no-autofix", action="store_true", help="do not fix mechanical errors (Markdown or IDs in Text, duplicate edit IDs) first")
    s = sp("author-report", cmd_author_report, help="each brief question, what answers it and the sentence that says it (no model)")
    s.add_argument("section"); s.add_argument("--file", help="a labelled change file for this section")
    s = sp("check-section", cmd_check_section, help="check a build-lane section file before approval")
    s.add_argument("file"); s.add_argument("--no-lint", action="store_true"); s.add_argument("--json", action="store_true")
    s = sp("sections", cmd_sections, help="list build-lane section files, their review verdict, and whether they are ready to build")
    s.add_argument("--json", action="store_true")
    s = sp("build", cmd_build, help="build the first draft (version 0.1) of a template CSA from reviewed section files (tracked changes)")
    s.add_argument("--sections", help="comma-separated section file names or order prefixes (default: all)")
    s.add_argument("--preview", action="store_true", help="build in a throwaway workspace; accepts drafts")
    s.add_argument("--system-name", help="name on the title page (default: project label)")
    s.add_argument("--prepared-for"); s.add_argument("--prepared-by")
    s.add_argument("--doc-version", help="default 0.1"); s.add_argument("--status")
    s = sp("place", cmd_place, help="put section files straight into the working document as tracked changes (creates 0.1 when there is none)")
    s.add_argument("targets", nargs="+", help="section file name, stem or number (3.4, 5.2, 'Executive Summary')")
    s.add_argument("--system-name", help="default: project context application, else the project label")
    s.add_argument("--prepared-for", help="default: project context organisation"); s.add_argument("--prepared-by")
    s.add_argument("--doc-version", help="default 0.1"); s.add_argument("--status")
    s.add_argument("--keep-open", action="store_true", help="do not save and close the document in Word when it is open")
    s.add_argument("--plain", action="store_true", help="place as normal text: no tracked changes, no evidence comments, no approval record")
    s = sp("apply", cmd_apply, help="framework-first apply; --agent for the LLM document agent")
    s.add_argument("section"); s.add_argument("--limit", type=int); s.add_argument("--edit", help="apply only this edit ID")
    s.add_argument("--until-done", action="store_true", help="keep running batches until complete, blocked or no progress")
    s.add_argument("--max-batches", type=int, default=50)
    s.add_argument("--agent", action="store_true", help="run the document agent (LLM) instead of the framework")
    s.add_argument("--agent-on-block", action="store_true", help="hand over to the document agent if a batch is BLOCKED")
    s.add_argument("--allow-unapproved", action="store_true", help="apply even if csa check-change reports errors")
    s.add_argument("--json", action="store_true")
    s.add_argument("--keep-open", action="store_true", help="do not save and close the document in Word when it is open")
    s.add_argument("--file", help="a labelled change file for this section, e.g. story for ChangesCSA_<App>_Section<N>_story.md")
    s.add_argument("--set", nargs="*", help="KEY=VALUE overrides for --agent"); agent_opts(s)
    s = sp("pipeline", cmd_pipeline); s.add_argument("section"); s.add_argument("--limit", type=int)
    s.add_argument("--max-batches", type=int, default=50); agent_opts(s)
    s = sp("hosts", cmd_hosts, help="host register, facts per host and host-to-host links (build | list | show HOST | links [HOST] | group --attr ... | roles [--fix])")
    s.add_argument("action", nargs="?", default="list", choices=["build", "list", "show", "links", "group", "graph", "unresolved", "system", "evidence", "roles"])
    s.add_argument("host", nargs="?"); s.add_argument("--attr", action="append"); s.add_argument("--system")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--json", action="store_true")
    s.add_argument("--all", action="store_true", help="include hosts the inventory marks In Scope: No")
    s.add_argument("--name", help="system layer name for `csa hosts system` (e.g. tcs)")
    s.add_argument("--fix", action="store_true", help="graph: reject stale/out-of-scope/mis-cited items csa hosts created, then re-add")
    s.add_argument("--question", help="evidence: the question the host-group rows answer")
    s = sp("browse", cmd_browse, help="open the local CSA Evidence Workspace in a browser")
    s.add_argument("--port", type=int, default=8765)
    s.add_argument("--no-open", action="store_true", help="start the server without opening the browser")
    s = sp("fleet", cmd_fleet, help="run independent tasks in parallel, one headless worker per slot")
    s.add_argument("tasks", nargs="*", help='quoted tasks, e.g. "author 6" "analyse infrastructure-analysis SECTION=5"')
    s.add_argument("--file", "-f", help="task file, one task per line (# comments allowed)")
    s.add_argument("--slots", help="comma list overriding fleet_slots in cli.yaml (one worker per slot)")
    s.add_argument("--cli", choices=["codex", "claude", "hermes"])
    s.add_argument("--timeout", type=float, help="minutes before a task is stopped")
    s.add_argument("--log-dir", help="where logs go (default .agents/.state/fleet/<time>)")
    s.add_argument("--dry-run", action="store_true", help="show tasks and locks, start nothing")
    s.add_argument("--print", action="store_true", help="also print every prompt, start nothing")
    s = sp("convert", cmd_convert, help="move an old-format CSA into the template, one subsection at a time")
    s.add_argument("target", nargs="?", help="subsection to convert, e.g. 3.4, 5.3, 7 (Glossary), 8, 5.1")
    s.add_argument("--prepare", action="store_true", help="extract and map the legacy document")
    s.add_argument("--map", nargs="?", const="", default=None, metavar="N", help="print the map report, or one target's blocks")
    s.add_argument("--status", action="store_true"); s.add_argument("--parked", action="store_true")
    s.add_argument("--audit", action="store_true", help="per-requirement audit: what the old document and the captures offer")
    s.add_argument("--stage", choices=CONVERT_STAGES); s.add_argument("--no-apply", action="store_true")
    s.add_argument("--cli", choices=["codex", "claude", "hermes"])
    s.add_argument("--print", action="store_true", help="show the stages and agent commands; run and write nothing")
    s = sp("move", cmd_move, help="move an old-format CSA into the template as plain text, one subsection at a time")
    s.add_argument("target", nargs="?", help="subsection to move, e.g. 3.4, 5.3, 7 (Glossary), 8 (Discovery Required), 5.1, 2.1")
    s.add_argument("--prepare", action="store_true", help="extract and map the old document (no facts, no audit)")
    s.add_argument("--all", action="store_true", help="every mapped subsection in order, then Section 8, then 2.1; stops on the first failure")
    s.add_argument("--status", action="store_true")
    s.add_argument("--stage", choices=MOVE_STAGES)
    s.add_argument("--cli", choices=["codex", "claude", "hermes"])
    s.add_argument("--keep-open", action="store_true", help="do not save and close the document in Word when it is open")
    s.add_argument("--print", action="store_true", help="show the stages and the agent command; run and write nothing")
    s = sp("lint", cmd_lint); s.add_argument("section", nargs="?", type=int); s.add_argument("--path"); s.add_argument("--heading")
    s.add_argument("rest", nargs=argparse.REMAINDER)
    s = sp("check", cmd_check); s.add_argument("--final", action="store_true"); s.add_argument("--docx"); s.add_argument("rest", nargs=argparse.REMAINDER)
    sp("mcp", cmd_mcp)
    s = sp("sync", cmd_sync, help="generate wrapper skills, slash commands and AGENTS.md from registry.yaml")
    s.add_argument("--dry-run", action="store_true"); s.add_argument("--codex-prompts", action="store_true")
    try:
        verbs = [r["verb"] for r in registry()]
    except SystemExit:
        verbs = []
    for v in verbs:
        if v == "apply":
            continue
        s = sp(v, cmd_agent, help=f"launch the {v} agent"); s.set_defaults(verb=v)
        s.add_argument("args", nargs="*", help="positional value and KEY=VALUE overrides"); agent_opts(s)
        s.add_argument("--no-apply", action="store_true",
                       help="author/write/summary: stop after the agent instead of changing the document")
        s.add_argument("--no-writer", action="store_true",
                       help="author: skip the writer pass (the author's own Text is applied as drafted)")
        s.add_argument("--writer", action="store_true",
                       help="author: always run the writer pass (by default it runs only when check-change reports an "
                            "error or a structural prose problem)")
        s.add_argument("--cards", action="store_true",
                       help="author: the card path (the default when a working DOCX exists; kept for old scripts)")
        s.add_argument("--legacy", action="store_true",
                       help="author: the old change-authoring agent path instead of card -> answer agent -> render")
        s.add_argument("--fresh", action="store_true",
                       help="author --cards: ignore a saved answer sheet and always run the answer agent")
        s.add_argument("--check-answers", action="store_true",
                       help="author --cards: an advisory answer check after the sheet passes (shown in the author report)")

    argv = list(sys.argv[1:] if argv is None else argv)
    glob_project = None
    while argv[:1] and argv[0] in ("-p", "--project") and len(argv) > 1:
        glob_project, argv = argv[1], argv[2:]
    if argv[:1] and argv[0] in PASSTHROUGH:
        a = argparse.Namespace(project=glob_project, rest=argv[1:])
        return PASSTHROUGH[argv[0]](a) or 0
    if glob_project:
        argv = ["--project", glob_project] + argv
    a, extra = ap.parse_known_args(argv)
    if extra:                                    # KEY=VALUE overrides placed after an option (csa author 6 --print K=V)
        if isinstance(getattr(a, "args", None), list) and all("=" in x and not x.startswith("-") for x in extra):
            a.args += extra
        else:
            ap.error(f"unrecognized arguments: {' '.join(extra)}")
    if not getattr(a, "cmd", None):
        ap.print_help()
        return 0
    if not hasattr(a, "project"):
        a.project = None
    if isinstance(getattr(a, "section", None), str):
        sec, label = split_section(a.section)
        if label:
            if a.cmd == "brief":
                pass                             # takes the visible number as given (3.1, 3.1.2)
            elif a.cmd in ("validate", "prepare"):
                a.section = sec                  # document-level checks: the whole section
            elif hasattr(a, "file") or a.cmd in ("status", "pipeline"):
                a.section = sec
                a.file = getattr(a, "file", None) or label
            else:
                die(f"`csa {a.cmd}` does not take a subsection yet; use section {sec}.")
    return a.fn(a) or 0


if __name__ == "__main__":
    sys.exit(main())
